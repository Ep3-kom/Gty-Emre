# GTY environment variables

# Resend API key voor het verzenden van formulieren naar info@gty.nl
# Optioneel in dev: zonder key wordt de submit gelogd in plaats van gemaild.
RESEND_API_KEY=

# Domein voor Plausible analytics (privacy-vriendelijk, zonder cookies).
# Laat leeg om analytics uit te schakelen.
PUBLIC_PLAUSIBLE_DOMAIN=gty.nl

# Doel-adres voor formulier-submissies. Default: info@gty.nl.
CONTACT_TO_EMAIL=info@gty.nl
