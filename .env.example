# GTY environment variables

# Web3Forms access key voor de contact- en nulmeting-formulieren.
# Gratis aan te maken op https://web3forms.com — koppel je ontvang-e-mail (bijv. info@gty.nl).
# Deze key is PUBLIEK en mag in de build/git: hij stuurt alleen naar het door jou
# ingestelde adres. Zonder key tonen de formulieren een foutmelding bij verzenden.
PUBLIC_WEB3FORMS_KEY=

# Domein voor Plausible analytics (privacy-vriendelijk, zonder cookies).
# Laat leeg om analytics uit te schakelen.
PUBLIC_PLAUSIBLE_DOMAIN=gty.nl
