---
import Base from '~/layouts/Base.astro';
import NormPaginaHero from '~/components/sections/NormPaginaHero.astro';
import VraagBanner from '~/components/sections/VraagBanner.astro';
import Klanten from '~/components/sections/Klanten.astro';
import Plan from '~/components/sections/Plan.astro';
import GerelateerdeNormen from '~/components/sections/GerelateerdeNormen.astro';
import CallToAction from '~/components/sections/CallToAction.astro';
import FAQAccordion from '~/components/ui/FAQAccordion.astro';
import Eyebrow from '~/components/ui/Eyebrow.astro';
import { siteData } from '~/data/site-data';
import { faqJsonLd, serviceJsonLd, breadcrumbJsonLd, canonical } from '~/lib/seo';
import type { Norm } from '~/data/normen';

type Section = { eyebrow: string; titel: string; body: string[] };

type Props = {
  norm: Norm;
  oneliner: string;
  intro: string;
  beeld?: { src: string; alt: string };
  heroBeeldRechts?: boolean;
  voorWieBeeld?: { src: string; alt: string };
  voorWieBeeldRechts?: boolean;
  voorWieBeeldRechtsCenter?: boolean;
  voorWieBeeldAlt?: boolean;
  voorWieAlleenTekst?: boolean;
  voorWieVerbergen?: boolean;
  hoeWerktBeeld?: { src: string; alt: string };
  hoeWerktBeeldLinks?: boolean;
  hoeWerktBeeldRechts?: boolean;
  hoeWerktVerbergen?: boolean;
  vraagBanner?: boolean;
  vraagBannerBovenVoorWie?: boolean;
  partnersLoop?: boolean;
  faqBovenHoeWerkt?: boolean;
  faqNaHoeWerkt?: boolean;
  ctaNaFaq?: boolean;
  daarnaBovenVoorWie?: boolean;
  daarnaNaHoeWerkt?: boolean;
  daarnaNaPartners?: boolean;
  samenBepalenCta?: boolean;
  valkuilenVerbergen?: boolean;
  valkuilenBovenVoorWie?: boolean;
  aanpakIpvValkuilen?: boolean;
  watIs: Section;
  voorWie: Section;
  hoeWerkt: Section;
  valkuilen: { titel: string; body: string }[];
  daarna: Section;
  faq: { vraag: string; antwoord: string }[];
};

const { norm, oneliner, intro, beeld, heroBeeldRechts, voorWieBeeld, voorWieBeeldRechts, voorWieBeeldRechtsCenter, voorWieBeeldAlt, voorWieAlleenTekst, voorWieVerbergen, hoeWerktBeeld, hoeWerktBeeldLinks, hoeWerktBeeldRechts, hoeWerktVerbergen, vraagBanner, vraagBannerBovenVoorWie, partnersLoop, faqBovenHoeWerkt, faqNaHoeWerkt, ctaNaFaq, daarnaBovenVoorWie, daarnaNaHoeWerkt, daarnaNaPartners, samenBepalenCta, valkuilenVerbergen, valkuilenBovenVoorWie, aanpakIpvValkuilen, watIs, voorWie, hoeWerkt, valkuilen, daarna, faq } = Astro.props;
const url = canonical(Astro.url.pathname);
const jsonLd = [
  serviceJsonLd({ name: norm.title, description: oneliner, url }),
  faqJsonLd(faq),
  breadcrumbJsonLd([
    { name: 'Home', url: siteData.url },
    { name: 'Certificering', url: `${siteData.url}/certificering/` },
    { name: norm.code, url },
  ]),
];
---

<Base title={`${norm.code} certificering`} description={`${oneliner} ${intro}`} jsonLd={jsonLd}>
  <NormPaginaHero norm={norm} oneliner={oneliner} intro={intro} beeld={beeld} beeldRechts={heroBeeldRechts} />

  <section class="container-x py-14 md:py-16">
    <div class="grid grid-cols-12 gap-x-6 gap-y-10">
      <div class="col-span-12 md:col-span-4">
        <Eyebrow>{watIs.eyebrow}</Eyebrow>
        <h2 class="mt-5 font-display text-h2 text-teal-900 text-balance">{watIs.titel}</h2>
      </div>
      <div class="col-span-12 md:col-span-7 md:col-start-6 max-w-prose space-y-5 text-base text-ink">
        {watIs.body.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  {daarnaBovenVoorWie && (
  <section class="container-x py-14 md:py-16">
    <div class="grid grid-cols-12 gap-x-6 gap-y-10">
      <div class="col-span-12 md:col-span-4">
        <Eyebrow>{daarna.eyebrow}</Eyebrow>
        <h2 class="mt-5 font-display text-h2 text-teal-900 text-balance">{daarna.titel}</h2>
      </div>
      <div class="col-span-12 md:col-span-7 md:col-start-6 max-w-prose space-y-5 text-base text-ink">
        {daarna.body.map((p) => <p>{p}</p>)}
        <p>
          <a href="/partnerprogramma/" class="link-underline text-teal-700">Lees meer over het Partnerprogramma →</a>
        </p>
      </div>
    </div>
  </section>
  )}

  {valkuilenBovenVoorWie && (
  <section class="border-y border-line-cool bg-paper">
    <div class="container-x py-14 md:py-16">
      <div class="max-w-narrow">
        <Eyebrow>Veelgemaakte fouten</Eyebrow>
        <h2 class="mt-6 font-display text-h2 text-teal-900 text-balance">
          Waar trajecten <span class="display-italic">stuklopen</span>, en hoe GTY dat voorkomt.
        </h2>
      </div>
      <ol class="mt-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-line-cool">
        {valkuilen.map((v, i) => (
          <li class="bg-paper p-7">
            <p class="mono-eyebrow text-teal-700">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mt-3 font-display text-h4 text-teal-900">{v.titel}</h3>
            <p class="mt-3 text-base text-ink">{v.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
  )}

  {vraagBannerBovenVoorWie && <VraagBanner />}

  {!voorWieVerbergen && (
  <section class="bg-cream">
    <div class="container-x py-14 md:py-16">
      {voorWieAlleenTekst ? (
        <div class="max-w-3xl space-y-5 text-base text-ink">
          {voorWie.body.map((p) => <p>{p}</p>)}
        </div>
      ) : voorWieBeeldRechtsCenter ? (
        <div class="grid grid-cols-12 gap-x-6 lg:gap-x-12 gap-y-10 items-center">
          {voorWieBeeld && (
            <div class="col-span-12 lg:col-span-6">
              <figure class="relative overflow-hidden" style="aspect-ratio: 4 / 3;">
                <img src={voorWieBeeld.src} alt={voorWieBeeld.alt} loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover" style="object-position: center; filter: saturate(0.9) contrast(1.02);" />
              </figure>
            </div>
          )}
          <div class="col-span-12 lg:col-span-5 lg:col-start-8">
            <Eyebrow>{voorWie.eyebrow}</Eyebrow>
            {voorWie.titel && <h2 class="mt-5 font-display text-h2 text-teal-900 text-balance">{voorWie.titel}</h2>}
            <div class="mt-7 max-w-prose space-y-5 text-base text-ink">
              {voorWie.body.map((p) => <p>{p}</p>)}
            </div>
          </div>
        </div>
      ) : voorWieBeeldRechts ? (
        <div class="grid grid-cols-12 gap-x-6 lg:gap-x-12 gap-y-10 items-stretch">
          <div class="col-span-12 lg:col-span-6">
            <Eyebrow>{voorWie.eyebrow}</Eyebrow>
            {voorWie.titel && <h2 class="mt-5 font-display text-h2 text-teal-900 text-balance">{voorWie.titel}</h2>}
            <div class="mt-7 max-w-prose space-y-5 text-base text-ink">
              {voorWie.body.map((p) => <p>{p}</p>)}
            </div>
          </div>
          {voorWieBeeld && (
            <div class="col-span-12 lg:col-span-5 lg:col-start-8">
              <figure class:list={['relative h-full min-h-[360px] overflow-hidden', voorWieBeeldAlt ? 'voorwie-beeld-alt' : 'voorwie-beeld']}>
                <img src={voorWieBeeld.src} alt={voorWieBeeld.alt} loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover" style="object-position: center; filter: saturate(0.9) contrast(1.02);" />
                <div class:list={['pointer-events-none absolute inset-0', voorWieBeeldAlt ? 'voorwie-patroon-alt' : 'voorwie-patroon']} aria-hidden="true"></div>
              </figure>
            </div>
          )}
        </div>
      ) : (
        <div class="grid grid-cols-12 gap-x-6 gap-y-10">
          <div class="col-span-12 md:col-span-5">
            <Eyebrow>{voorWie.eyebrow}</Eyebrow>
            {voorWie.titel && <h2 class="mt-5 font-display text-h2 text-teal-900 text-balance">{voorWie.titel}</h2>}
            {voorWieBeeld && (
              <figure class="mt-8 relative overflow-hidden" style="aspect-ratio: 4 / 3;">
                <img src={voorWieBeeld.src} alt={voorWieBeeld.alt} loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover" style="object-position: center; filter: saturate(0.9) contrast(1.02);" />
              </figure>
            )}
          </div>
          <div class="col-span-12 md:col-span-6 md:col-start-7 max-w-prose space-y-5 text-base text-ink">
            {voorWie.body.map((p) => <p>{p}</p>)}
          </div>
        </div>
      )}
    </div>
  </section>
  )}

  {partnersLoop && <Klanten />}

  {daarnaNaPartners && (
  <section class="container-x py-14 md:py-16">
    <div class="grid grid-cols-12 gap-x-6 gap-y-10">
      <div class="col-span-12 md:col-span-4">
        <Eyebrow>{daarna.eyebrow}</Eyebrow>
        <h2 class="mt-5 font-display text-h2 text-teal-900 text-balance">{daarna.titel}</h2>
      </div>
      <div class="col-span-12 md:col-span-7 md:col-start-6 max-w-prose space-y-5 text-base text-ink">
        {daarna.body.map((p) => <p>{p}</p>)}
        <p>
          <a href="/partnerprogramma/" class="link-underline text-teal-700">Lees meer over het Partnerprogramma →</a>
        </p>
      </div>
    </div>
  </section>
  )}

  {vraagBanner && <VraagBanner />}

  {faqBovenHoeWerkt && (
  <section class="bg-paper border-t border-line-cool">
    <div class="container-x py-14 md:py-16">
      <div class="max-w-narrow">
        <Eyebrow>Veelgestelde vragen</Eyebrow>
        <h2 class="mt-6 font-display text-h2 text-teal-900">Wat klanten ons vooraf vragen.</h2>
      </div>
      <div class="mt-10 max-w-3xl">
        <FAQAccordion items={faq} />
      </div>
    </div>
  </section>
  )}

  {ctaNaFaq && (
    <CallToAction
      eyebrow="Eerste audit"
      title="Wilt u een eerlijke spiegel?"
      body="In een vrijblijvend kennismakingsgesprek bekijken we welke norm of welk proces u wilt laten doorlichten en wat een traject u oplevert. Geen verplichting, gewoon een gesprek."
    />
  )}

  {!hoeWerktVerbergen && (
  <section class="container-x py-14 md:py-16">
    {hoeWerktBeeldRechts ? (
      <div class="grid grid-cols-12 gap-x-6 lg:gap-x-12 gap-y-10 items-stretch">
        <div class="col-span-12 lg:col-span-6">
          <Eyebrow>{hoeWerkt.eyebrow}</Eyebrow>
          <h2 class="mt-5 font-display text-h2 text-teal-900 text-balance">{hoeWerkt.titel}</h2>
          <p class="mt-6 mono-eyebrow text-teal-700">Eén vast aanspreekpunt</p>
          <div class="mt-7 max-w-prose space-y-5 text-base text-ink">
            {hoeWerkt.body.map((p) => <p>{p}</p>)}
          </div>
        </div>
        {hoeWerktBeeld && (
          <div class="col-span-12 lg:col-span-5 lg:col-start-8">
            <figure class="voorwie-beeld relative h-full min-h-[360px] overflow-hidden">
              <img src={hoeWerktBeeld.src} alt={hoeWerktBeeld.alt} loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover" style="object-position: center; filter: saturate(0.9) contrast(1.02);" />
              <div class="voorwie-patroon pointer-events-none absolute inset-0" aria-hidden="true"></div>
            </figure>
          </div>
        )}
      </div>
    ) : hoeWerktBeeldLinks ? (
      <div class="grid grid-cols-12 gap-x-6 lg:gap-x-12 gap-y-10 items-stretch">
        {hoeWerktBeeld && (
          <div class="col-span-12 lg:col-span-5 lg:row-start-1">
            <figure class="hoewerkt-beeld relative h-full min-h-[360px] overflow-hidden">
              <img src={hoeWerktBeeld.src} alt={hoeWerktBeeld.alt} loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover" style="object-position: center; filter: saturate(0.9) contrast(1.02);" />
              <div class="hoewerkt-patroon pointer-events-none absolute inset-0" aria-hidden="true"></div>
            </figure>
          </div>
        )}
        <div class="col-span-12 lg:col-span-6 lg:col-start-7 lg:row-start-1">
          <Eyebrow>{hoeWerkt.eyebrow}</Eyebrow>
          <h2 class="mt-5 font-display text-h2 text-teal-900 text-balance">{hoeWerkt.titel}</h2>
          <p class="mt-6 mono-eyebrow text-teal-700">Eén vast aanspreekpunt</p>
          <div class="mt-7 max-w-prose space-y-5 text-base text-ink">
            {hoeWerkt.body.map((p) => <p>{p}</p>)}
          </div>
        </div>
      </div>
    ) : (
      <div class="grid grid-cols-12 gap-x-6 gap-y-10">
        <div class="col-span-12 md:col-span-4">
          <Eyebrow>{hoeWerkt.eyebrow}</Eyebrow>
          <h2 class="mt-5 font-display text-h2 text-teal-900 text-balance">{hoeWerkt.titel}</h2>
          <p class="mt-6 mono-eyebrow text-teal-700">Eén vast aanspreekpunt</p>
          {hoeWerktBeeld && (
            <figure class="mt-8 relative overflow-hidden" style="aspect-ratio: 4 / 3;">
              <img src={hoeWerktBeeld.src} alt={hoeWerktBeeld.alt} loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover" style="object-position: center; filter: saturate(0.9) contrast(1.02);" />
            </figure>
          )}
        </div>
        <div class="col-span-12 md:col-span-7 md:col-start-6 max-w-prose space-y-5 text-base text-ink">
          {hoeWerkt.body.map((p) => <p>{p}</p>)}
        </div>
      </div>
    )}
  </section>
  )}

  {faqNaHoeWerkt && (
  <section class="bg-paper border-t border-line-cool">
    <div class="container-x py-14 md:py-16">
      <div class="max-w-narrow">
        <Eyebrow>Veelgestelde vragen</Eyebrow>
        <h2 class="mt-6 font-display text-h2 text-teal-900">Wat klanten ons vooraf vragen.</h2>
      </div>
      <div class="mt-10 max-w-3xl">
        <FAQAccordion items={faq.slice(0, 4)} />
      </div>
    </div>
  </section>
  )}

  {daarnaNaHoeWerkt && (
  <section class="bg-cream border-y border-line-cool">
    <div class="container-x py-14 md:py-16">
      <div class="grid grid-cols-12 gap-x-6 gap-y-10">
        <div class="col-span-12 md:col-span-4">
          <Eyebrow>{daarna.eyebrow}</Eyebrow>
          <h2 class="mt-5 font-display text-h2 text-teal-900 text-balance">{daarna.titel}</h2>
        </div>
        <div class="col-span-12 md:col-span-7 md:col-start-6 max-w-prose space-y-5 text-base text-ink">
          {daarna.body.map((p) => <p>{p}</p>)}
          <p>
            <a href="/partnerprogramma/" class="link-underline text-teal-700">Lees meer over het Partnerprogramma →</a>
          </p>
        </div>
      </div>
    </div>
  </section>
  )}

  {samenBepalenCta && (
    <CallToAction
      eyebrow="Samen aan de slag"
      title="Samen bepalen we de juiste route."
      body="Of u nu al weet welke norm u nodig heeft of nog twijfelt tussen opties: een nulmeting brengt uw uitgangspositie in kaart en geeft aan welke norm, of welke combinatie, past bij uw organisatie en uw markt. Kosteloos, vrijblijvend en op basis van feiten."
    />
  )}

  {aanpakIpvValkuilen && <Plan />}

  {!valkuilenVerbergen && !valkuilenBovenVoorWie && !aanpakIpvValkuilen && (
  <section class="border-y border-line-cool bg-paper">
    <div class="container-x py-14 md:py-16">
      <div class="max-w-narrow">
        <Eyebrow>Veelgemaakte fouten</Eyebrow>
        <h2 class="mt-6 font-display text-h2 text-teal-900 text-balance">
          Waar trajecten <span class="display-italic">stuklopen</span>, en hoe GTY dat voorkomt.
        </h2>
      </div>
      <ol class="mt-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-line-cool">
        {valkuilen.map((v, i) => (
          <li class="bg-paper p-7">
            <p class="mono-eyebrow text-teal-700">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mt-3 font-display text-h4 text-teal-900">{v.titel}</h3>
            <p class="mt-3 text-base text-ink">{v.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
  )}

  {!daarnaBovenVoorWie && !daarnaNaHoeWerkt && !daarnaNaPartners && (
  <section class="container-x py-14 md:py-16">
    <div class="grid grid-cols-12 gap-x-6 gap-y-10">
      <div class="col-span-12 md:col-span-4">
        <Eyebrow>{daarna.eyebrow}</Eyebrow>
        <h2 class="mt-5 font-display text-h2 text-teal-900 text-balance">{daarna.titel}</h2>
      </div>
      <div class="col-span-12 md:col-span-7 md:col-start-6 max-w-prose space-y-5 text-base text-ink">
        {daarna.body.map((p) => <p>{p}</p>)}
        <p>
          <a href="/partnerprogramma/" class="link-underline text-teal-700">Lees meer over het Partnerprogramma →</a>
        </p>
      </div>
    </div>
  </section>
  )}

  {!faqBovenHoeWerkt && !faqNaHoeWerkt && (
  <section class="bg-paper border-t border-line-cool">
    <div class="container-x py-14 md:py-16">
      <div class="max-w-narrow">
        <Eyebrow>Veelgestelde vragen</Eyebrow>
        <h2 class="mt-6 font-display text-h2 text-teal-900">Wat klanten ons vooraf vragen.</h2>
      </div>
      <div class="mt-10 max-w-3xl">
        <FAQAccordion items={faq} />
      </div>
    </div>
  </section>
  )}

  <GerelateerdeNormen huidig={norm.slug} />

  <CallToAction
    eyebrow="Start nu"
    title={`Klaar om met ${norm.code} aan de slag te gaan?`}
    body={`Plan een vrijblijvend kennismakingsgesprek. We bespreken uw uitgangspositie en wat een ${norm.code}-traject voor uw organisatie vraagt. Geen verplichtingen. Geen standaardpitch. Een eerlijk gesprek.`}
    variant="inverse"
    imageSrc="/iStock-1827278623.jpg"
    imageAlt="Adviseur verwelkomt een klant voor een kennismakingsgesprek"
    imageLarge
  />
</Base>

<style>
  /* Hoekige uitsnede van het 'Voor wie'-beeld, passend bij de hoekige GTY-logostijl.
     Alleen op desktop; op mobiel toont de foto als volledige rechthoek. */
  @media (min-width: 1024px) {
    .voorwie-beeld {
      clip-path: polygon(14% 0, 100% 0, 100% 100%, 14% 100%, 0 50%);
    }
  }

  /* Hoekig lijnenpatroon uit de GTY-logostijl, subtiel over de foto en vanuit
     de hoek vervagend zodat de afbeelding leesbaar blijft. */
  .voorwie-patroon {
    background-image: repeating-linear-gradient(
      45deg,
      rgba(184, 227, 229, 0.55) 0,
      rgba(184, 227, 229, 0.55) 2px,
      transparent 2px,
      transparent 10px
    );
    opacity: 0.35;
    mix-blend-mode: screen;
    -webkit-mask-image: linear-gradient(135deg, #000 0%, rgba(0, 0, 0, 0.4) 35%, transparent 65%);
            mask-image: linear-gradient(135deg, #000 0%, rgba(0, 0, 0, 0.4) 35%, transparent 65%);
  }

  /* Gespiegelde variant voor 'Hoe GTY werkt': foto links, punt aan de rechterkant. */
  @media (min-width: 1024px) {
    .hoewerkt-beeld {
      clip-path: polygon(0 0, 86% 0, 100% 50%, 86% 100%, 0 100%);
    }
  }

  .hoewerkt-patroon {
    background-image: repeating-linear-gradient(
      -45deg,
      rgba(184, 227, 229, 0.55) 0,
      rgba(184, 227, 229, 0.55) 2px,
      transparent 2px,
      transparent 10px
    );
    opacity: 0.35;
    mix-blend-mode: screen;
    -webkit-mask-image: linear-gradient(225deg, #000 0%, rgba(0, 0, 0, 0.4) 35%, transparent 65%);
            mask-image: linear-gradient(225deg, #000 0%, rgba(0, 0, 0, 0.4) 35%, transparent 65%);
  }

  /* Alternatieve stijl: twee tegenovergestelde hoeken afgeschuind + fijner
     patroon dat vanuit de rechteronderhoek vervaagt. */
  @media (min-width: 1024px) {
    .voorwie-beeld-alt {
      clip-path: polygon(0 0, 88% 0, 100% 18%, 100% 100%, 12% 100%, 0 82%);
    }
  }

  .voorwie-patroon-alt {
    background-image: repeating-linear-gradient(
      45deg,
      rgba(184, 227, 229, 0.5) 0,
      rgba(184, 227, 229, 0.5) 1.5px,
      transparent 1.5px,
      transparent 8px
    );
    opacity: 0.35;
    mix-blend-mode: screen;
    -webkit-mask-image: linear-gradient(315deg, #000 0%, rgba(0, 0, 0, 0.4) 35%, transparent 65%);
            mask-image: linear-gradient(315deg, #000 0%, rgba(0, 0, 0, 0.4) 35%, transparent 65%);
  }
</style>
