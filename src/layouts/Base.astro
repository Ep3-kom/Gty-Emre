---
import '~/styles/global.css';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
import CookieNotice from '~/components/ui/CookieNotice.astro';
import { siteData } from '~/data/site-data';
import { buildTitle, canonical, localBusinessJsonLd } from '~/lib/seo';

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: object[];
  bodyClass?: string;
};

const {
  title,
  description = siteData.description,
  ogImage = '/og-default.png',
  noindex = false,
  jsonLd = [],
  bodyClass = '',
} = Astro.props;

const pageTitle = buildTitle(title);
const url = canonical(Astro.url.pathname);
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
const allLd = [localBusinessJsonLd(), ...jsonLd];
---

<!doctype html>
<html lang="nl-NL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={new URL(ogImage, siteData.url).toString()} />
    <meta property="og:locale" content="nl_NL" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="GTY" href="/rss.xml" />

    {allLd.map((ld) => (
      <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    ))}

    {plausibleDomain && (
      <script
        defer
        data-domain={plausibleDomain}
        src="https://plausible.io/js/script.js"
      ></script>
    )}
  </head>
  <body class={`min-h-screen flex flex-col bg-paper text-ink ${bodyClass}`}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-teal-900 focus:text-paper focus:px-3 focus:py-2 focus:rounded-md"
    >
      Naar de inhoud
    </a>

    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <CookieNotice />
  </body>
</html>
