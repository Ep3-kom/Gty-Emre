---
// Layout voor het nieuwe ontwerp (Wauw). Bewust zonder Tailwind/global.css.
// Lettertypes vanaf eigen server: er gaat niets naar Google.
import '@fontsource-variable/google-sans-flex';
import '@fontsource-variable/archivo/wdth.css';
import '~/styles/wauw.css';
import SeoHead, { type Props } from '~/components/layout/SeoHead.astro';
import Header from '~/components/wauw/Header.astro';
import Footer from '~/components/wauw/Footer.astro';
import Keuzehulp from '~/components/wauw/Keuzehulp.astro';
---

<!doctype html>
<html lang="nl-NL">
  <head>
    <SeoHead {...(Astro.props as Props)} />
  </head>
  <body>
    <a href="#main" class="zh-skip">Naar de inhoud</a>
    <div class="zh zh-root zh-anim" style="position:relative;width:100%;min-width:0;min-height:100vh;display:flex;flex-direction:column">
      <div class="zh-header"><Header /></div>
      <main id="main"><slot /></main>
      <div class="zh-footwrap" style="flex:1 0 auto;background:var(--zh-ink)"><Footer /></div>
      <Keuzehulp />
    </div>
  </body>
</html>

<style is:global>
  [hidden] { display: none !important; }
  .zh-foot-logo { display: flex; line-height: 0; }
  .zh-skip { position: absolute; left: -999px; }
  .zh-skip:focus { left: 8px; top: 8px; z-index: 100; padding: 8px 12px; border-radius: 8px; background: #fff; }
  .gty-kd-input:focus { outline: 2px solid var(--action-primary); outline-offset: 1px; }
</style>
