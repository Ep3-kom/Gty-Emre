---
import Base from '~/layouts/Base.astro';
import Eyebrow from '~/components/ui/Eyebrow.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('inzichten', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
---

<Base
  title="Inzichten"
  description="Observaties uit de praktijk van certificering, audits en managementsystemen, geschreven vanuit het werk zelf, niet vanaf de zijlijn."
>
  <section class="border-b border-line-cool">
    <div class="container-x pt-12 md:pt-16 pb-16 md:pb-20">
      <nav aria-label="Breadcrumb" class="mb-8 text-caption font-mono text-ink-soft uppercase tracking-wider">
        <a href="/" class="hover:text-teal-700">Home</a>
        <span class="mx-2 text-line-cool">/</span>
        <span class="text-teal-700">Inzichten</span>
      </nav>

      <Eyebrow>Inzichten</Eyebrow>
      <h1 class="mt-6 font-display text-h1 md:text-[3.5rem] md:leading-[1.05] text-teal-900 text-balance">
        Geleerd <span class="display-italic">in de praktijk.</span>
      </h1>
      <p class="mt-7 max-w-prose text-lead text-ink-soft text-pretty">
        Hier delen we notities uit lopend werk, trajecten, audits, partnerafspraken.
        Geen marketingteksten, wel observaties over wat werkt op de werkvloer en
        waar implementaties typisch vastlopen.
      </p>
    </div>
  </section>

  <section class="container-x py-20 md:py-24">
    {posts.length === 0 ? (
      <div class="max-w-narrow">
        <p class="font-display text-h2 text-teal-900 display-italic">Bijna zover.</p>
        <p class="mt-4 max-w-prose text-base text-ink-soft">
          De eerste stukken zijn in voorbereiding. Heeft u nu al een concrete
          vraag? Bellen of mailen werkt vaak sneller dan wachten op een
          artikel.
        </p>
      </div>
    ) : (
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-12 border-t border-line-cool pt-12">
        {posts.map((p) => (
          <li>
            <article>
              <p class="mono-eyebrow text-teal-700">{new Intl.DateTimeFormat('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' }).format(p.data.publishDate)}</p>
              <h2 class="mt-3 font-display text-h2 text-teal-900">
                <a href={`/inzichten/${p.id}/`} class="hover:text-accent transition-colors">{p.data.title}</a>
              </h2>
              <p class="mt-3 text-base text-ink-soft max-w-prose">{p.data.description}</p>
              <a href={`/inzichten/${p.id}/`} class="mt-4 inline-block text-small text-teal-700 link-underline">Lees verder →</a>
            </article>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>
