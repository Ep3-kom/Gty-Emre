---
import Base from '~/layouts/Base.astro';
import Hero from '~/components/sections/Hero.astro';
import Probleem from '~/components/sections/Probleem.astro';
import Gids from '~/components/sections/Gids.astro';
import Partner from '~/components/sections/Partner.astro';
import Plan from '~/components/sections/Plan.astro';
import Diensten from '~/components/sections/Diensten.astro';
import Stakes from '~/components/sections/Stakes.astro';
import CallToAction from '~/components/sections/CallToAction.astro';
import Klanten from '~/components/sections/Klanten.astro';
import EigenaarBanner from '~/components/sections/EigenaarBanner.astro';
import VraagBanner from '~/components/sections/VraagBanner.astro';
---

<Base
  title="Zekerheid in certificering. Rust in compliance."
  description="GTY begeleidt Nederlandse organisaties bij ISO 9001, ISO 14001, ISO 27001, HKZ en NEN 7510, van nulmeting tot certificaat en de borging daarna."
  headerOverlay
>
  <Hero />
  <Probleem />
  <VraagBanner />
  <Klanten />
  <Gids />
  <Partner />
  <Plan />
  <Diensten />
  <Stakes />
  <CallToAction variant="inverse" />
  <EigenaarBanner />
</Base>
