---
import Base from '~/layouts/Base.astro';
import Eyebrow from '~/components/ui/Eyebrow.astro';
import Tijdlijn from '~/components/sections/Tijdlijn.astro';
import CallToAction from '~/components/sections/CallToAction.astro';
import Button from '~/components/ui/Button.astro';

const fases = [
  {
    nr: '01',
    titel: 'Verkenning en meting',
    duur: '1 tot 3 weken',
    body: 'We beginnen met goed luisteren. Wat is uw vraag, hoe staat uw organisatie ervoor, en welke route past daarbij, dat moet eerst helder zijn voor er ook maar één offerte komt.',
    stappen: [
      'Verkennend gesprek met directie en de mensen die u erbij wilt hebben',
      'Meting ter plekke: processen, documenten, betrokkenheid',
      'Bevindingen op papier, met duidelijke prioritering',
      'Toelichting in een gesprek en samen kijken naar vervolgstappen',
    ],
  },
  {
    nr: '02',
    titel: 'Inrichten en invoeren',
    duur: 'Variabel, afhankelijk van norm en organisatieomvang',
    body: 'Wij werken mee in uw organisatie aan het managementsysteem. Geen aparte projectorganisatie ernaast, we voegen ons naar de manier waarop het werk daadwerkelijk loopt.',
    stappen: [
      'Het systeem opbouwen rond de processen zoals ze nu werken',
      'Documentatie waar de norm dat vereist of waar uw werk er baat bij heeft, niet meer',
      'Training en awareness per afdeling, op uw locatie',
      'Interne audit ter voorbereiding op de externe beoordeling',
      'Directie en sleutelpersonen klaarstomen voor de auditdag',
      'Begeleiding tijdens het proces met de certificerende instelling',
    ],
  },
  {
    nr: '03',
    titel: 'Afronding en de tijd erna',
    duur: 'Doorlopend, naar wens',
    body: 'Er ligt aan het eind een concreet resultaat: het certificaat, een getoetste RI&E of een opgeleverd auditrapport. Wilt u na afloop blijvend ondersteund worden, dan kan dat via het Partnerprogramma.',
    stappen: [
      'Sluitend maken van eventuele afwijkingen tot het certificaat definitief is',
      'Overdracht aan uw interne kwaliteitsverantwoordelijke',
      'Optioneel: instappen in het Partnerprogramma voor langdurige borging',
      'Optioneel: interne auditoren opleiden via de GTY Academy',
    ],
  },
];
---

<Base
  title="Werkwijze"
  description="Hoe wij werken: drie fasen, verkennen, inrichten, borgen. Voorspelbaar, met heldere stappen en zonder verborgen agenda."
>
  <section class="border-b border-line-cool">
    <div class="container-x pt-12 md:pt-16 pb-16 md:pb-20">
      <nav aria-label="Breadcrumb" class="mb-8 text-caption font-mono text-ink-soft uppercase tracking-wider">
        <a href="/" class="hover:text-teal-700">Home</a>
        <span class="mx-2 text-line-cool">/</span>
        <span class="text-teal-700">Werkwijze</span>
      </nav>

      <div class="grid grid-cols-12 gap-x-6 gap-y-8">
        <div class="col-span-12 lg:col-span-9">
          <Eyebrow>Zo werken wij</Eyebrow>
          <h1 class="mt-6 font-display text-h1 md:text-[3.5rem] md:leading-[1.05] text-teal-900 text-balance">
            Voorspelbaar verloop. <span class="display-italic">Geen verborgen agenda.</span>
          </h1>
          <p class="mt-7 max-w-prose text-lead text-ink-soft text-pretty">
            Iedere samenwerking start bij uw vraag, die maken we eerst goed
            zichtbaar. Pas dan ontstaat de aanpak. We werken niet uit een
            standaardpakket, maar wel binnen een vast ritme dat het werk
            navolgbaar maakt.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="container-x py-20 md:py-24">
    <div class="max-w-narrow">
      <Eyebrow>Drie fasen</Eyebrow>
      <h2 class="mt-6 font-display text-h2 text-teal-900 text-balance">
        Een ritme dat voor iedereen werkt, <span class="display-italic">ook voor uw mensen.</span>
      </h2>
      <p class="mt-5 max-w-prose text-lead text-ink-soft">
        De structuur is voor elk traject hetzelfde. De inhoud verschilt per norm,
        per sector en per startpunt, dat stemmen we af op uw situatie.
      </p>
    </div>
    <div class="mt-16">
      <Tijdlijn fases={fases} />
    </div>
  </section>

  <section class="bg-cream">
    <div class="container-x py-20 md:py-24">
      <div class="grid grid-cols-12 gap-x-6 gap-y-10">
        <div class="col-span-12 md:col-span-4">
          <Eyebrow>Het verschil</Eyebrow>
          <h2 class="mt-5 font-display text-h2 text-teal-900 text-balance">
            Geen telefonisch advies van een afdeling.<br /><span class="display-italic">Iemand die meeloopt.</span>
          </h2>
        </div>
        <div class="col-span-12 md:col-span-7 md:col-start-6 max-w-prose space-y-5 text-base text-ink">
          <p>
            Het hele traject door spreekt u dezelfde GTY-begeleider. Geen
            roulerend team, geen junior aan de uitvoering en een senior alleen
            bij sturen. Wie u bij de eerste meting ontmoet, staat ook bij de
            externe audit naast u, en bereidt een jaar later de
            surveillance-audit met u voor.
          </p>
          <p>
            Dat heeft praktische voordelen. We hoeven uw organisatie niet bij
            elk gesprek opnieuw te leren kennen. Wie wat doet, waar de druk
            zit, welke keuze eerder gemaakt is, dat is bekend. Het versnelt
            het werk en haalt de last weg van steeds uitleggen.
          </p>
          <p>
            Het bepaalt ook de kwaliteit. Iemand die uw organisatie kent ziet
            afwijkingen die een buitenstaander mist, en kan adviseren met
            historisch besef in plaats van een sjabloon dat overal hetzelfde
            wordt toegepast.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="container-x py-20 md:py-24">
    <div class="grid grid-cols-12 gap-x-6 gap-y-10">
      <div class="col-span-12 md:col-span-5">
        <Eyebrow>Wat u van ons mag verwachten</Eyebrow>
        <h2 class="mt-6 font-display text-h2 text-teal-900 text-balance">
          Afspraken die staan. <span class="display-italic">Vanaf de start.</span>
        </h2>
      </div>
      <div class="col-span-12 md:col-span-6 md:col-start-7">
        <ul class="divide-y divide-line-cool border-y border-line-cool">
          <li class="py-6">
            <p class="mono-eyebrow text-teal-700">Eén offerte</p>
            <p class="mt-2 text-base text-ink">
              Na het kennismakingsgesprek krijgt u één voorstel: aanpak, planning,
              investering. Geen meerwerk dat halverwege opduikt.
            </p>
          </li>
          <li class="py-6">
            <p class="mono-eyebrow text-teal-700">Eén contactpersoon</p>
            <p class="mt-2 text-base text-ink">
              Dezelfde begeleider, het hele traject. Direct bereikbaar, geen
              accountmanagers, geen ticketsysteem.
            </p>
          </li>
          <li class="py-6">
            <p class="mono-eyebrow text-teal-700">Inzicht in de voortgang</p>
            <p class="mt-2 text-base text-ink">
              Een planning met duidelijke mijlpalen en korte voortgangs­overleggen
              die niet meer tijd vragen dan ze opleveren.
            </p>
          </li>
          <li class="py-6">
            <p class="mono-eyebrow text-teal-700">Een eerlijk oordeel</p>
            <p class="mt-2 text-base text-ink">
              Als een norm niet bij uw organisatie past, of als het te vroeg is,
              zeggen we dat ronduit. Liever een uitgesteld traject dan een
              certificaat dat onderaan de streep geen waarde toevoegt.
            </p>
          </li>
          <li class="py-6">
            <p class="mono-eyebrow text-teal-700">Vaste prijsafspraak</p>
            <p class="mt-2 text-base text-ink">
              Geen open-eind facturatie op uurbasis. De investering ligt vooraf
              vast. Verandert de scope, dan bespreken we dat eerst, niet
              achteraf op de factuur.
            </p>
          </li>
        </ul>

        <div class="mt-10 flex flex-wrap gap-x-5 gap-y-3 items-center">
          <Button href="/contact/" size="lg">Plan een kennismakingsgesprek</Button>
          <Button href="/nulmeting/" variant="ghost">Begin met een nulmeting →</Button>
        </div>
      </div>
    </div>
  </section>

  <CallToAction />
</Base>
