---
import Juridisch from '~/layouts/Juridisch.astro';
import { siteData } from '~/data/site-data';
---

<Juridisch titel="Disclaimer" beschrijving="Disclaimer van de website van GTY.">
<div>
      <section>
        <h2>Inhoud van deze website</h2>
