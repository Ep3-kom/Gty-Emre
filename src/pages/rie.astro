---
import Base from '~/layouts/Base.astro';
import Eyebrow from '~/components/ui/Eyebrow.astro';
import Button from '~/components/ui/Button.astro';
import CallToAction from '~/components/sections/CallToAction.astro';
import { siteData } from '~/data/site-data';
import { serviceJsonLd, canonical } from '~/lib/seo';

const url = canonical(Astro.url.pathname);
const jsonLd = [serviceJsonLd({ name: 'Risico-Inventarisatie & Evaluatie', description: 'Volledige RI&E-begeleiding inclusief plan van aanpak en toetsing waar wettelijk vereist.', url })];
---

<Base
  title="Risico-Inventarisatie & Evaluatie (RI&E)"
  description="Een complete RI&E volgens de Arbowet: inventarisatie op locatie, een werkbaar plan van aanpak en toetsing waar de wet dat eist."
  jsonLd={jsonLd}
>
  <section class="border-b border-line-cool">
    <div class="container-x pt-12 md:pt-16 pb-16 md:pb-20">
      <nav aria-label="Breadcrumb" class="mb-8 text-caption font-mono text-ink-soft uppercase tracking-wider">
        <a href="/" class="hover:text-teal-700">Home</a>
        <span class="mx-2 text-line-cool">/</span>
        <span class="text-teal-700">RI&E</span>
      </nav>

      <div class="grid grid-cols-12 gap-x-6 gap-y-8">
        <div class="col-span-12 lg:col-span-9">
          <Eyebrow>Risico-Inventarisatie & Evaluatie</Eyebrow>
          <h1 class="mt-6 font-display text-h1 md:text-[3.5rem] md:leading-[1.05] text-teal-900 text-balance">
            Uw RI&E op orde.<br /><span class="display-italic">Compleet, getoetst, bruikbaar.</span>
          </h1>
          <p class="mt-7 max-w-prose text-lead text-ink-soft text-pretty">
            Elke werkgever in Nederland is wettelijk verplicht een RI&E te
            voeren. Wij begeleiden dat traject van begin tot eind — van
            inventarisatie op de werkvloer tot plan van aanpak en, waar
            vereist, de officiële toetsing. Aantoonbaar voldoen aan de Arbowet,
            en met een document dat ook in de praktijk werkt.
          </p>
          <div class="mt-9 flex flex-wrap gap-3">
            <Button href={siteData.cta.primary.href} size="lg">{siteData.cta.primary.label}</Button>
            <Button href={siteData.contact.phoneHref} variant="ghost" size="lg">Of bel direct →</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="container-x py-20 md:py-24">
    <div class="grid grid-cols-12 gap-x-6 gap-y-10">
      <div class="col-span-12 md:col-span-4">
        <Eyebrow>De wettelijke basis</Eyebrow>
        <h2 class="mt-6 font-display text-h2 text-teal-900 text-balance">
          Een verplichting voor <span class="display-italic">elke werkgever.</span>
        </h2>
      </div>
      <div class="col-span-12 md:col-span-7 md:col-start-6 max-w-prose space-y-5 text-base text-ink">
        <p>
          De RI&E komt voort uit artikel 5 van de Arbowet. Zodra u één
          medewerker in dienst heeft, moet u kunnen aantonen welke
          arbeidsgerelateerde risico's er spelen, hoe zwaar die wegen, en
          welke maatregelen u neemt om ze beheersbaar te houden.
        </p>
        <p>Een volwaardige RI&E bestaat altijd uit twee delen:</p>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <span class="mt-[10px] block w-3 h-px bg-teal-700 shrink-0" aria-hidden="true"></span>
            <span><strong class="font-medium">De inventarisatie</strong> — een systematische analyse van álle arbeidsrisico's: fysiek, psychosociaal én organisatorisch.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-[10px] block w-3 h-px bg-teal-700 shrink-0" aria-hidden="true"></span>
            <span><strong class="font-medium">Het plan van aanpak</strong> — welke maatregelen u treft, wie ze uitvoert, en binnen welke termijn ze klaar zijn.</span>
          </li>
        </ul>
        <p>
          In de meeste gevallen is bovendien toetsing door een gecertificeerd
          kerndeskundige verplicht. Of dat ook voor uw situatie geldt, hangt
          af van de omvang van uw organisatie en het gebruik van een erkend
          branche-instrument.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-cream">
    <div class="container-x py-20 md:py-24">
      <div class="grid grid-cols-12 gap-x-6 gap-y-10">
        <div class="col-span-12 md:col-span-5">
          <Eyebrow>Wanneer urgent</Eyebrow>
          <h2 class="mt-6 font-display text-h2 text-teal-900 text-balance">
            Speelt een van deze<br /><span class="display-italic">bij u?</span>
          </h2>
        </div>
        <div class="col-span-12 md:col-span-6 md:col-start-7">
          <ul class="divide-y divide-line border-y border-line">
            <li class="py-6">
              <p class="font-display text-h4 text-teal-900">Geen of verouderde RI&E</p>
              <p class="mt-3 text-base text-ink max-w-prose">
                Een RI&E moet bij de tijd blijven. Is uw document ouder dan
                vier jaar, of is uw organisatie sindsdien flink veranderd?
                Dan vraagt de wet een nieuwe of aangepaste versie. Bij een
                inspectie van de Arbeidsinspectie kan dat anders een boete
                opleveren.
              </p>
            </li>
            <li class="py-6">
              <p class="font-display text-h4 text-teal-900">Verandering in uw organisatie</p>
              <p class="mt-3 text-base text-ink max-w-prose">
                Nieuwe werkplekken, andere processen, meer personeel, een
                extra locatie — allemaal reden om opnieuw te kijken. Wij
                inventariseren wat er gewijzigd is en wat dat betekent voor
                uw RI&E.
              </p>
            </li>
            <li class="py-6">
              <p class="font-display text-h4 text-teal-900">Inspectie op de agenda</p>
              <p class="mt-3 text-base text-ink max-w-prose">
                Bij een bezoek van de Nederlandse Arbeidsinspectie is uw
                RI&E en plan van aanpak praktisch altijd onderwerp van
                gesprek. Een actueel en getoetst document voorkomt
                stillegging en sancties.
              </p>
            </li>
            <li class="py-6">
              <p class="font-display text-h4 text-teal-900">U wilt het laten toetsen</p>
              <p class="mt-3 text-base text-ink max-w-prose">
                Voor veel organisaties is toetsing door een gecertificeerd
                kerndeskundige wettelijk verplicht. Wij regelen het volledige
                traject inclusief toetsing, zodat uw RI&E zonder twijfel
                voldoet.
              </p>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="container-x py-20 md:py-24">
    <div class="grid grid-cols-12 gap-x-6 gap-y-10">
      <div class="col-span-12 md:col-span-4">
        <Eyebrow>Onze werkwijze</Eyebrow>
        <h2 class="mt-6 font-display text-h2 text-teal-900 text-balance">
          Meer dan een document.<br /><span class="display-italic">Een RI&E die u gebruikt.</span>
        </h2>
      </div>
      <div class="col-span-12 md:col-span-7 md:col-start-6 max-w-prose space-y-5 text-base text-ink">
        <p>
          We voeren de inventarisatie ter plekke uit. Werkplekken, processen
          en risico's brengen we samen met uw mensen in beeld — zij weten
          immers het beste hoe het werk loopt. Zonder hun stem wordt het
          alsnog een papieren exercitie.
        </p>
        <p>
          Vanuit die inventarisatie schrijven we een werkbaar plan van aanpak.
          Welke maatregel, wie de eigenaar is, en wanneer het rond moet zijn
          — concreet, leesbaar voor zowel directie als werkvloer. Geen
          papieren tijger, maar iets waar uw organisatie écht risico's mee
          beheerst.
        </p>
        <p>
          Is toetsing vereist, dan ronden we dat af via een gecertificeerd
          kerndeskundige. U krijgt een complete, getoetste RI&E — gebruiksklaar
          en bestand tegen externe controle.
        </p>
        <p class="text-ink-soft">
          Na de oplevering bespreken we de uitkomst met u. Zodat het niet
          alleen een document is, maar ook duidelijk wat het betekent en wat
          er nu praktisch moet gebeuren.
        </p>
      </div>
    </div>
  </section>

  <section class="border-y border-line-cool bg-paper">
    <div class="container-x py-20 md:py-24">
      <Eyebrow>De oplevering</Eyebrow>
      <h2 class="mt-6 max-w-2xl font-display text-h2 text-teal-900 text-balance">
        Een complete RI&E. <span class="display-italic">Direct inzetbaar.</span>
      </h2>

      <ol class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-px bg-line-cool border border-line-cool">
        <li class="bg-paper p-7">
          <p class="mono-eyebrow text-teal-700">01</p>
          <h3 class="mt-3 font-display text-h4 text-teal-900">RI&E-rapport</h3>
          <p class="mt-3 text-base text-ink">
            Een compleet overzicht van alle in kaart gebrachte risico's, met
            beoordeling van ernst en kans per risico — verspreid over alle
            werkplekken en processen.
          </p>
        </li>
        <li class="bg-paper p-7">
          <p class="mono-eyebrow text-teal-700">02</p>
          <h3 class="mt-3 font-display text-h4 text-teal-900">Plan van aanpak</h3>
          <p class="mt-3 text-base text-ink">
            Een concreet actieplan met maatregelen, eigenaren en tijdslijnen.
            Bruikbaar voor zowel directie als medewerkers, in begrijpelijke taal.
          </p>
        </li>
        <li class="bg-paper p-7">
          <p class="mono-eyebrow text-teal-700">03</p>
          <h3 class="mt-3 font-display text-h4 text-teal-900">Toetsingsrapport</h3>
          <p class="mt-3 text-base text-ink">
            Daar waar de wet dat eist: een toetsing door een gecertificeerd
            kerndeskundige die aantoont dat uw organisatie voldoet aan de Arbowet.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <CallToAction
    eyebrow="Eerste afspraak"
    title="Uw RI&E in goede handen brengen?"
    body="In een vrijblijvend kennismakings­gesprek nemen we uw situatie door, kijken we of toetsing nodig is en wat u kunt verwachten van een volledig traject. Geen verplichting, geen verkoop — gewoon helderheid."
  />
</Base>
