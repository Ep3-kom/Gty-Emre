---
import Base from '~/layouts/Base.astro';
import Eyebrow from '~/components/ui/Eyebrow.astro';
import Button from '~/components/ui/Button.astro';
import CallToAction from '~/components/sections/CallToAction.astro';
import { siteData } from '~/data/site-data';
import { serviceJsonLd, canonical } from '~/lib/seo';

const url = canonical(Astro.url.pathname);
const jsonLd = [serviceJsonLd({ name: 'Risico-Inventarisatie & Evaluatie', description: 'Volledige RI&E-begeleiding inclusief plan van aanpak en toetsing waar wettelijk vereist.', url })];
---

<Base
  title="Risico-Inventarisatie & Evaluatie (RI&E)"
  description="Een RI&E is wettelijk verplicht voor elke werkgever. GTY begeleidt het volledige traject — inventarisatie, plan van aanpak en toetsing waar vereist."
  jsonLd={jsonLd}
>
  <section class="border-b border-line-cool">
    <div class="container-x pt-12 md:pt-16 pb-16 md:pb-20">
      <nav aria-label="Breadcrumb" class="mb-8 text-caption font-mono text-ink-soft uppercase tracking-wider">
        <a href="/" class="hover:text-teal-700">Home</a>
        <span class="mx-2 text-line-cool">/</span>
        <span class="text-teal-700">RI&E</span>
      </nav>

      <div class="grid grid-cols-12 gap-x-6 gap-y-8">
        <div class="col-span-12 lg:col-span-9">
          <Eyebrow>Risico-Inventarisatie & Evaluatie</Eyebrow>
          <h1 class="mt-6 font-display text-h1 md:text-[3.5rem] md:leading-[1.05] text-teal-900 text-balance">
            Uw RI&E goed geregeld.<br /><span class="display-italic">Volledig, getoetst, werkbaar.</span>
          </h1>
          <p class="mt-7 max-w-prose text-lead text-ink-soft text-pretty">
            Een RI&E is wettelijk verplicht voor elke werkgever in Nederland. GTY begeleidt
            het volledige traject — van inventarisatie op locatie tot plan van aanpak en
            toetsing waar dat vereist is. Zodat u aantoonbaar voldoet aan de Arbowet, en
            uw RI&E ook in de praktijk bruikbaar is.
          </p>
          <div class="mt-9 flex flex-wrap gap-3">
            <Button href={siteData.cta.primary.href} size="lg">{siteData.cta.primary.label}</Button>
            <Button href={siteData.contact.phoneHref} variant="ghost" size="lg">Of bel direct →</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="container-x py-20 md:py-24">
    <div class="grid grid-cols-12 gap-x-6 gap-y-10">
      <div class="col-span-12 md:col-span-4">
        <Eyebrow>De wet in het kort</Eyebrow>
        <h2 class="mt-6 font-display text-h2 text-teal-900 text-balance">
          Verplicht voor <span class="display-italic">elke werkgever.</span>
        </h2>
      </div>
      <div class="col-span-12 md:col-span-7 md:col-start-6 max-w-prose space-y-5 text-base text-ink">
        <p>
          De Risico-Inventarisatie & Evaluatie volgt uit artikel 5 van de Arbowet. Elke
          organisatie met personeel — ook bij één werknemer — moet in kaart brengen welke
          risico's medewerkers lopen op de werkvloer, hoe groot die risico's zijn, en welke
          maatregelen worden getroffen om ze te beheersen.
        </p>
        <p>Een volledige RI&E bestaat altijd uit twee onderdelen:</p>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <span class="mt-[10px] block w-3 h-px bg-teal-700 shrink-0" aria-hidden="true"></span>
            <span><strong class="font-medium">De inventarisatie</strong> — een systematische analyse van alle arbeidsrisico's binnen uw organisatie: fysiek, psychosociaal en organisatorisch.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-[10px] block w-3 h-px bg-teal-700 shrink-0" aria-hidden="true"></span>
            <span><strong class="font-medium">Het plan van aanpak</strong> — een concreet overzicht van de maatregelen die worden getroffen, wie daarvoor verantwoordelijk is en binnen welke termijn.</span>
          </li>
        </ul>
        <p>
          Voor de meeste organisaties is daarnaast toetsing door een gecertificeerde
          kerndeskundige verplicht. Of dat voor uw organisatie geldt, hangt af van de omvang
          en het gebruik van een erkend branche-instrument.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-cream">
    <div class="container-x py-20 md:py-24">
      <div class="grid grid-cols-12 gap-x-6 gap-y-10">
        <div class="col-span-12 md:col-span-5">
          <Eyebrow>Wanneer relevant</Eyebrow>
          <h2 class="mt-6 font-display text-h2 text-teal-900 text-balance">
            Herkent u een van<br /><span class="display-italic">deze situaties?</span>
          </h2>
        </div>
        <div class="col-span-12 md:col-span-6 md:col-start-7">
          <ul class="divide-y divide-line border-y border-line">
            <li class="py-6">
              <p class="font-display text-h4 text-teal-900">Geen RI&E, of verouderd</p>
              <p class="mt-3 text-base text-ink max-w-prose">
                Een RI&E moet actueel zijn. Is uw RI&E ouder dan vier jaar, of zijn er sindsdien
                grote veranderingen in uw organisatie geweest? Dan is een nieuwe of bijgewerkte
                RI&E noodzakelijk. Bij een inspectie van de Nederlandse Arbeidsinspectie
                riskeert u anders een boete.
              </p>
            </li>
            <li class="py-6">
              <p class="font-display text-h4 text-teal-900">Uw organisatie is veranderd</p>
              <p class="mt-3 text-base text-ink max-w-prose">
                Nieuwe werkplekken, nieuwe processen, meer personeel, een nieuwe vestiging —
                allemaal aanleiding om de RI&E opnieuw te beoordelen. Wij brengen in kaart wat
                er veranderd is en wat dat voor uw RI&E betekent.
              </p>
            </li>
            <li class="py-6">
              <p class="font-display text-h4 text-teal-900">Inspectie of audit op de planning</p>
              <p class="mt-3 text-base text-ink max-w-prose">
                Bij een inspectie van de Nederlandse Arbeidsinspectie wordt vrijwel altijd
                gevraagd naar uw RI&E en plan van aanpak. Een actuele, getoetste RI&E voorkomt
                stillegging of boetes.
              </p>
            </li>
            <li class="py-6">
              <p class="font-display text-h4 text-teal-900">U wilt uw RI&E laten toetsen</p>
              <p class="mt-3 text-base text-ink max-w-prose">
                In veel gevallen is toetsing door een gecertificeerde kerndeskundige wettelijk
                vereist. GTY regelt het volledige traject inclusief toetsing, zodat uw RI&E
                aantoonbaar voldoet.
              </p>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="container-x py-20 md:py-24">
    <div class="grid grid-cols-12 gap-x-6 gap-y-10">
      <div class="col-span-12 md:col-span-4">
        <Eyebrow>Hoe GTY het aanpakt</Eyebrow>
        <h2 class="mt-6 font-display text-h2 text-teal-900 text-balance">
          Niet alleen een document.<br /><span class="display-italic">Een RI&E die werkt.</span>
        </h2>
      </div>
      <div class="col-span-12 md:col-span-7 md:col-start-6 max-w-prose space-y-5 text-base text-ink">
        <p>
          We voeren de RI&E uit op locatie. We inventariseren werkplekken, processen en
          risico's samen met uw medewerkers — zij kennen de dagelijkse praktijk het best, en
          zonder hun input wordt de RI&E een papieren oefening.
        </p>
        <p>
          Op basis van de inventarisatie stellen we een helder plan van aanpak op. Welke
          maatregelen worden getroffen, wie is daarvoor verantwoordelijk, op welke termijn —
          concreet en bruikbaar voor management én werkvloer. Geen papieren tijger, maar een
          document dat uw organisatie ook werkelijk helpt risico's te beheersen.
        </p>
        <p>
          Waar toetsing vereist is, zorgen we dat dit correct wordt afgerond door een
          gecertificeerd kerndeskundige. U ontvangt een volledig gedocumenteerde, getoetste
          RI&E — klaar voor gebruik en bestand tegen externe controle.
        </p>
        <p class="text-ink-soft">
          Na oplevering bespreken we de uitkomsten persoonlijk. Zodat u niet alleen een
          document heeft, maar ook weet wat het betekent en wat de vervolgstappen zijn.
        </p>
      </div>
    </div>
  </section>

  <section class="border-y border-line-cool bg-paper">
    <div class="container-x py-20 md:py-24">
      <Eyebrow>Wat u ontvangt</Eyebrow>
      <h2 class="mt-6 max-w-2xl font-display text-h2 text-teal-900 text-balance">
        Een complete RI&E. <span class="display-italic">Klaar voor gebruik.</span>
      </h2>

      <ol class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-px bg-line-cool border border-line-cool">
        <li class="bg-paper p-7">
          <p class="mono-eyebrow text-teal-700">01</p>
          <h3 class="mt-3 font-display text-h4 text-teal-900">RI&E rapport</h3>
          <p class="mt-3 text-base text-ink">
            Een volledig overzicht van alle geïnventariseerde risico's, inclusief beoordeling
            van ernst en kans per risico — over alle werkplekken en processen.
          </p>
        </li>
        <li class="bg-paper p-7">
          <p class="mono-eyebrow text-teal-700">02</p>
          <h3 class="mt-3 font-display text-h4 text-teal-900">Plan van aanpak</h3>
          <p class="mt-3 text-base text-ink">
            Een concreet actieplan met maatregelen, verantwoordelijkheden en termijnen.
            Direct bruikbaar voor management én medewerkers.
          </p>
        </li>
        <li class="bg-paper p-7">
          <p class="mono-eyebrow text-teal-700">03</p>
          <h3 class="mt-3 font-display text-h4 text-teal-900">Toetsingsrapport</h3>
          <p class="mt-3 text-base text-ink">
            Waar wettelijk vereist: een door een gecertificeerd kerndeskundige getoetste RI&E
            die aantoont dat uw organisatie voldoet aan de Arbowet.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <CallToAction
    eyebrow="Start nu"
    title="Uw RI&E laten uitvoeren?"
    body="Plan een vrijblijvend kennismakingsgesprek. We bespreken de situatie van uw organisatie, of toetsing vereist is, en wat een volledige RI&E door GTY u oplevert. Geen verplichtingen, een eerlijk gesprek."
  />
</Base>
