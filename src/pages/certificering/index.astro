---
import Base from '~/layouts/Base.astro';
import Eyebrow from '~/components/ui/Eyebrow.astro';
import NormenVergelijkingsTabel from '~/components/ui/NormenVergelijkingsTabel.astro';
import CallToAction from '~/components/sections/CallToAction.astro';
import { normen } from '~/data/normen';
import { breadcrumbJsonLd, canonical } from '~/lib/seo';
import { siteData } from '~/data/site-data';

const url = canonical(Astro.url.pathname);
const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', url: siteData.url },
    { name: 'Certificering', url },
  ]),
];
---

<Base
  title="Certificering"
  description="De normen waarin wij u tot certificaat brengen: ISO 9001, ISO 14001, ISO 27001, HKZ en NEN 7510 — met advies over wat past bij uw situatie."
  jsonLd={jsonLd}
>
  <section class="border-b border-line-cool">
    <div class="container-x pt-12 md:pt-16 pb-16">
      <nav aria-label="Breadcrumb" class="mb-8 text-caption font-mono text-ink-soft uppercase tracking-wider">
        <a href="/" class="hover:text-teal-700">Home</a>
        <span class="mx-2 text-line-cool">/</span>
        <span class="text-teal-700">Certificering</span>
      </nav>

      <div class="grid grid-cols-12 gap-x-6 gap-y-8">
        <div class="col-span-12 lg:col-span-8">
          <Eyebrow>Naar het certificaat</Eyebrow>
          <h1 class="mt-6 font-display text-h1 md:text-[3.5rem] md:leading-[1.05] text-teal-900 text-balance">
            Uw certificaat, <span class="display-italic">door ons aangevlogen.</span>
          </h1>
          <p class="mt-7 max-w-prose text-lead text-ink-soft text-pretty">
            Welke norm bij u past, hangt af van wat u doet, voor wie u dat
            doet en onder welke voorwaarden. Hieronder een overzichtelijke
            vergelijking. Bij twijfel: een nulmeting brengt uw startpositie
            in kaart en geeft een onderbouwde aanbeveling.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="container-x py-16 md:py-20">
    <div class="flex items-end justify-between gap-6 mb-8">
      <div>
        <Eyebrow>Vergelijking</Eyebrow>
        <h2 class="mt-5 font-display text-h2 text-teal-900">Vijf normen, naast elkaar.</h2>
      </div>
      <a href="/nulmeting/" class="hidden md:inline-block text-small text-teal-700 link-underline whitespace-nowrap">
        Twijfel? Vraag een nulmeting →
      </a>
    </div>

    <NormenVergelijkingsTabel />
  </section>

  <section class="bg-cream">
    <div class="container-x py-20 md:py-24">
      <div class="grid grid-cols-12 gap-x-6 gap-y-10">
        <div class="col-span-12 md:col-span-4">
          <Eyebrow>Wat het oplevert</Eyebrow>
          <h2 class="mt-5 font-display text-h2 text-teal-900 text-balance">
            Meer dan het document aan de muur.
          </h2>
        </div>
        <div class="col-span-12 md:col-span-7 md:col-start-6 max-w-prose space-y-5 text-base text-ink">
          <p>
            <strong class="font-medium">Toegang tot uw markt.</strong> In veel
            sectoren is certificering een voorwaarde om mee te dingen op
            aanbestedingen of om met grote opdrachtgevers of zorgverzekeraars
            samen te werken. Het verschil tussen meedoen of buitenstaan.
          </p>
          <p>
            <strong class="font-medium">Beter zicht op uw eigen organisatie.</strong>
            Een serieus traject dwingt tot heldere keuzes: wie is waarvoor
            eigenaar, hoe lopen processen, welke risico's accepteert u.
            Dat is geen bijvangst — dat is de eigenlijke opbrengst.
          </p>
          <p>
            <strong class="font-medium">Een fundament voor wat komt.</strong>
            Het systeem blijft staan terwijl de markt verandert, u groeit of
            een tweede norm in beeld komt. Een goed eerste certificaat maakt
            het tweede beduidend eenvoudiger.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="container-x py-20 md:py-24">
    <div class="grid grid-cols-12 gap-x-6 gap-y-12">
      <div class="col-span-12 md:col-span-5">
        <Eyebrow>Een eerste richting</Eyebrow>
        <h2 class="mt-6 font-display text-h2 text-teal-900 text-balance">
          Welke norm sluit aan bij <span class="display-italic">uw situatie?</span>
        </h2>
        <p class="mt-5 text-base text-ink-soft max-w-prose">
          Geen besliskader, wel een snelle gids om met scherpere vragen
          aan een eerste gesprek te beginnen.
        </p>
      </div>

      <div class="col-span-12 md:col-span-6 md:col-start-7">
        <ol class="space-y-7 text-base text-ink">
          <li class="border-l-2 border-teal-700 pl-5">
            <p class="mono-eyebrow text-teal-700">Generieke aanbestedingseis</p>
            <p class="mt-2"><strong>ISO 9001</strong> — als een opdrachtgever om "ISO-gecertificeerd" vraagt zonder verdere specificatie, gaat het bijna altijd hierover.</p>
          </li>
          <li class="border-l-2 border-teal-700 pl-5">
            <p class="mono-eyebrow text-teal-700">Aantoonbaar duurzaam werken</p>
            <p class="mt-2"><strong>ISO 14001</strong> — geregeld gevraagd door overheid, bouw en infrastructuur. Goed te combineren met ISO 9001.</p>
          </li>
          <li class="border-l-2 border-teal-700 pl-5">
            <p class="mono-eyebrow text-teal-700">Verwerken van data van derden</p>
            <p class="mt-2"><strong>ISO 27001</strong> — voor IT, SaaS, financieel, juridisch, overheid en iedereen die met vertrouwelijke gegevens werkt.</p>
          </li>
          <li class="border-l-2 border-teal-700 pl-5">
            <p class="mono-eyebrow text-teal-700">Zorg en welzijn</p>
            <p class="mt-2"><strong>HKZ</strong> — sectorspecifiek voor jeugdzorg, gehandicaptenzorg, thuiszorg, GGZ en aanpalende zorgterreinen.</p>
          </li>
          <li class="border-l-2 border-teal-700 pl-5">
            <p class="mono-eyebrow text-teal-700">Patiëntgegevens en zorg-IT</p>
            <p class="mt-2"><strong>NEN 7510</strong> — voor zorgaanbieders en zorg-IT-leveranciers. Vaak gecombineerd met HKZ of ISO 27001.</p>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <CallToAction
    eyebrow="Nog onduidelijk"
    title="Niet zeker welke norm voor u logisch is?"
    body="Start met een nulmeting. We brengen uw uitgangspositie in kaart en geven aan welke norm — of welke combinatie — past bij uw organisatie en uw markt. Kosteloos, vrijblijvend en op basis van feiten."
  />
</Base>
