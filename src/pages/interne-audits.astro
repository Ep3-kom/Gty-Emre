---
import Base from '~/layouts/Base.astro';
import Eyebrow from '~/components/ui/Eyebrow.astro';
import CallToAction from '~/components/sections/CallToAction.astro';
import { normen } from '~/data/normen';
import { serviceJsonLd, canonical } from '~/lib/seo';

const url = canonical(Astro.url.pathname);
const jsonLd = [serviceJsonLd({ name: 'Interne audits', description: 'Onafhankelijke interne audits voor ISO 9001, ISO 14001, ISO 27001, HKZ en NEN 7510.', url })];
---

<Base
  title="Interne audits"
  description="Onafhankelijke beoordeling van uw managementsysteem in de praktijk, voor ISO 9001, ISO 14001, ISO 27001, HKZ en NEN 7510. Met opvolgrapport dat tot daadwerkelijke verbetering leidt."
  jsonLd={jsonLd}
>
  <section class="relative overflow-hidden border-b border-line-cool" style="min-height: 72vh; display: flex; flex-direction: column; justify-content: flex-end;">
    <img
      src="/images/overleg-zwartwit.jpg"
      alt="Twee mensen bespreken hun werk tijdens een interne audit"
      loading="eager"
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover"
      style="object-position: center; filter: saturate(0.88) contrast(1.03);"
    />
    <div
      class="absolute inset-0"
      style="background: linear-gradient(to top, rgba(10,24,26,0.82) 0%, rgba(10,24,26,0.35) 55%, rgba(10,24,26,0.10) 100%);"
    ></div>

    <div class="relative container-x pt-10 pb-16 md:pb-20">
      <nav aria-label="Breadcrumb" class="mb-10 text-caption font-mono uppercase tracking-wider" style="color: rgba(255,255,255,0.55);">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span class="mx-2" style="color: rgba(255,255,255,0.3);">/</span>
        <span style="color: rgba(255,255,255,0.8);">Interne audits</span>
      </nav>

      <div class="max-w-3xl">
        <h1 class="mt-5 font-display font-bold text-balance" style="color: #FFFFFF; font-size: clamp(2.25rem, 5vw, 4rem); line-height: 1.06;">
          Doet uw organisatie ook werkelijk <span class="italic font-normal" style="color: rgba(160,210,210,0.95);">wat er beschreven staat?</span>
        </h1>
        <p class="mt-6 max-w-prose text-pretty" style="font-size: 1.125rem; line-height: 1.65; color: rgba(255,255,255,0.75);">
          Wij verzorgen onafhankelijke interne audits voor organisaties die
          willen weten hoe hun processen er in de praktijk voor staan, als
          opmaat naar een externe audit of gewoon als peiling. Eerlijk
          beoordeeld, gericht op verbetering, niet op een vinkje.
        </p>
      </div>
    </div>
  </section>

  <section style="background-color: #FFFFFF; border-bottom: 1px solid rgba(47,93,95,0.12);">
    <div class="container-x" style="padding-block: clamp(56px, 7vw, 88px);">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-x-12 lg:gap-x-20 gap-y-8 md:gap-y-0 items-start">
        <p
          class="font-display"
          style="border-left: 2px solid #2F5D5F; padding-left: 20px; color: #0F1B1F; font-size: clamp(1.375rem, 1.8vw, 1.625rem); line-height: 1.3; font-weight: 500; letter-spacing: -0.01em; max-width: 24ch;"
        >
          U weet wat er ligt,<br />
          <span style="color: #2F5D5F;">en wat er nog moet.</span>
        </p>

        <p
          class="font-display"
          style="border-left: 2px solid #2F5D5F; padding-left: 20px; color: #0F1B1F; font-size: clamp(1.375rem, 1.8vw, 1.625rem); line-height: 1.3; font-weight: 500; letter-spacing: -0.01em; max-width: 24ch;"
        >
          Niets blijft hangen,<br />
          <span style="color: #2F5D5F;">niets overvalt u.</span>
        </p>

        <p
          class="font-display"
          style="border-left: 2px solid #2F5D5F; padding-left: 20px; color: #0F1B1F; font-size: clamp(1.375rem, 1.8vw, 1.625rem); line-height: 1.3; font-weight: 500; letter-spacing: -0.01em; max-width: 24ch;"
        >
          Uw mensen sturen,<br />
          <span style="color: #2F5D5F;">wij ondersteunen.</span>
        </p>
      </div>
    </div>
  </section>

  <section class="container-x py-20 md:py-24">
    <div class="max-w-narrow">
      <Eyebrow>Wanneer zinvol</Eyebrow>
      <h2 class="mt-6 font-display text-h2 text-teal-900 text-balance">
        Vier situaties waarin een audit <span class="display-italic">echt iets oplevert.</span>
      </h2>
    </div>
    <ol class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-x-12 lg:gap-x-16 gap-y-10">
      <li class="border-t border-line-cool pt-6">
        <p class="mono-eyebrow text-teal-700">01</p>
        <p class="mt-2 font-display text-h4 text-teal-900">De externe audit komt eraan</p>
        <p class="mt-3 text-base text-ink">
          U bent gecertificeerd en de surveillance- of hercertificeringsaudit
          nadert. Een onafhankelijke audit vooraf legt bloot wat de externe
          auditor anders zou aanwijzen, met genoeg tijd om het op te lossen.
        </p>
      </li>
      <li class="border-t border-line-cool pt-6">
        <p class="mono-eyebrow text-teal-700">02</p>
        <p class="mt-2 font-display text-h4 text-teal-900">Onzekerheid over de praktijk</p>
        <p class="mt-3 text-base text-ink">
          Op papier ziet alles er goed uit. Maar werkt het ook zo in de
          dagelijkse routine? Door groei, nieuw personeel of veranderingen
          in werkwijzen kan er onmerkbaar afstand ontstaan tussen het
          beschreven proces en wat er daadwerkelijk gebeurt.
        </p>
      </li>
      <li class="border-t border-line-cool pt-6">
        <p class="mono-eyebrow text-teal-700">03</p>
        <p class="mt-2 font-display text-h4 text-teal-900">Inspectie of toezichtbezoek</p>
        <p class="mt-3 text-base text-ink">
          Er komt een inspectie (IGJ, Arbeidsinspectie, AP) of er is er
          recent een geweest met aandachtspunten. Een interne audit toont
          of u staat waar u moet staan en geeft de basis om afwijkingen
          aantoonbaar weg te werken.
        </p>
      </li>
      <li class="border-t border-line-cool pt-6">
        <p class="mono-eyebrow text-teal-700">04</p>
        <p class="mt-2 font-display text-h4 text-teal-900">U wilt uw processen scherper krijgen</p>
        <p class="mt-3 text-base text-ink">
          Ook zonder externe aanleiding wilt u weten waar het beter kan. Een
          interne audit legt bloot waar de praktijk en de afspraken uit elkaar
          lopen, en geeft concrete aanknopingspunten om uw processen aan te
          scherpen.
        </p>
      </li>
    </ol>
  </section>

  <section class="container-x py-20 md:py-24">
    <Eyebrow>Onze auditkennis</Eyebrow>
    <h2 class="mt-6 max-w-2xl font-display text-h2 text-teal-900 text-balance">
      Ervaring in <span class="display-italic">zes normen.</span>
    </h2>
    <p class="mt-5 max-w-prose text-base text-ink-soft">
      Eén partner die alle normen beheerst, geen aparte specialist per norm.
      Bij combinaties van normen voeren we ook geïntegreerde audits uit.
    </p>

    <ul class="mt-14 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-line-cool border border-line-cool">
      {normen.map((n) => (
        <li class="bg-paper p-6">
          <p class="mono-eyebrow text-teal-700">{n.code}</p>
          <p class="mt-2 font-display text-h4 text-teal-900 leading-snug">{n.shortTitle}</p>
          <a href={`/certificering/${n.slug}/`} class="mt-4 inline-block text-small text-teal-700 link-underline">Norm-detail →</a>
        </li>
      ))}
    </ul>
  </section>

  <section class="bg-cream">
    <div class="container-x py-20 md:py-24">
      <div class="grid grid-cols-12 gap-x-6 gap-y-10">
        <div class="col-span-12 md:col-span-4">
          <Eyebrow>Onze aanpak</Eyebrow>
          <h2 class="mt-6 font-display text-h2 text-teal-900 text-balance">
            Meer dan afvinken tegen de norm.
          </h2>
        </div>
        <div class="col-span-12 md:col-span-7 md:col-start-6 max-w-prose space-y-5 text-base text-ink">
          <p>
            Een externe auditor toetst of u voldoet aan de norm, daar houdt zijn
            rol op. Een interne audit kan en moet meer zijn. Wij kijken hoe uw
            organisatie werkelijk functioneert: waar de praktijk afwijkt van de
            beschrijving, welke oorzaken daarin meespelen en wat er beter kan.
          </p>
          <p>
            Dat doen we niet door alleen documenten te lezen, maar door te
            spreken met de mensen op de vloer. Niet om fouten op te sporen, maar
            om te snappen waarom processen anders lopen, vaak met goede redenen
            die het systeem nog niet opgevangen heeft.
          </p>
          <p>
            Achteraf krijgt u een heldere rapportage: bevindingen, verbeterpunten
            en concrete acties. We nemen de uitkomsten met uw team door en
            ondersteunen bij de opvolging. Geen momentopname die in een la
            verdwijnt, maar een aanzet die in de praktijk landt.
          </p>
          <p class="text-ink-soft">
            Dezelfde partner, het hele jaar door. Geen wisselend team, geen
            tijdverlies door telkens opnieuw bijpraten. Doordat wij uw organisatie
            kennen, valt de audit ook scherper uit.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-line-cool bg-paper">
    <div class="container-x py-20 md:py-24">
      <div class="grid grid-cols-12 gap-x-6 gap-y-10">
        <div class="col-span-12 md:col-span-5">
          <Eyebrow>De opbrengst</Eyebrow>
          <h2 class="mt-6 font-display text-h2 text-teal-900 text-balance">
            Een organisatie die <span class="display-italic">weet</span> waar ze nu echt staat.
          </h2>
        </div>
        <div class="col-span-12 md:col-span-6 md:col-start-7">
          <dl class="divide-y divide-line-cool border-y border-line-cool">
            <div class="py-6">
              <dt class="font-display text-h4 text-teal-900">Vermoeden → Feit</dt>
              <dd class="mt-3 text-base text-ink max-w-prose">
                In plaats van interne discussies over wat wel of niet loopt,
                een rapport dat de basis vormt voor onderbouwde keuzes.
              </dd>
            </div>
            <div class="py-6">
              <dt class="font-display text-h4 text-teal-900">Late constatering → Vroegtijdig signaal</dt>
              <dd class="mt-3 text-base text-ink max-w-prose">
                Wat een externe auditor over een halfjaar zou opmerken, vinden
                wij nu, met de tijd om het rustig op te lossen voor het tot
                een formele afwijking leidt.
              </dd>
            </div>
            <div class="py-6">
              <dt class="font-display text-h4 text-teal-900">Verplichting → Verbetering</dt>
              <dd class="mt-3 text-base text-ink max-w-prose">
                Een audit die daadwerkelijk iets verandert, niet een document
                dat in een map belandt. Dat verschil zit in de opvolging en in
                hoe het gesprek gevoerd wordt.
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <CallToAction
    eyebrow="Eerste audit"
    title="Wilt u een eerlijke spiegel?"
    body="In een vrijblijvend kennismakings­gesprek bekijken we welke norm of welk proces u wilt laten doorlichten en wat een interne audit u oplevert. Geen verplichting, gewoon een gesprek."
  />
</Base>
