---
import Base from '~/layouts/Base.astro';
import Eyebrow from '~/components/ui/Eyebrow.astro';
import ContactForm from '~/components/ui/ContactForm.astro';
import CalendarSlot from '~/components/ui/CalendarSlot.astro';
import { siteData } from '~/data/site-data';
---

<Base
  title="Contact"
  description="Reserveer een vrijblijvend gesprek met GTY. Geen verkooppraat, geen verplichting, gewoon ruimte om uw vraag rond certificering of compliance helder te krijgen."
>
  <section class="border-b border-line-cool">
    <div class="container-x pt-12 md:pt-16 pb-16 md:pb-20">
      <nav aria-label="Breadcrumb" class="mb-8 text-caption font-mono text-ink-soft uppercase tracking-wider">
        <a href="/" class="hover:text-teal-700">Home</a>
        <span class="mx-2 text-line-cool">/</span>
        <span class="text-teal-700">Contact</span>
      </nav>

      <div class="grid grid-cols-12 gap-x-6 gap-y-8">
        <div class="col-span-12 lg:col-span-9">
          <Eyebrow>Even bijpraten</Eyebrow>
          <h1 class="mt-6 font-display text-h1 md:text-[3.5rem] md:leading-[1.05] text-teal-900 text-balance">
            Een <span class="display-italic">eerlijk gesprek,</span> zonder agenda.
          </h1>
          <p class="mt-7 max-w-prose text-lead text-ink-soft text-pretty">
            Een eerste gesprek met ons is vrijblijvend. We luisteren naar uw
            situatie, beantwoorden vragen en geven aan wat naar onze inschatting
            de zinvolste vervolgstap is. Geen verkooppraat, geen verplichting.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="container-x pt-14 md:pt-20">
    <figure>
      <div class="relative overflow-hidden" style="aspect-ratio: 16 / 7;">
        <img
          src="/images/hero-overleg-gang.jpg"
          alt="Twee professionals in gesprek in een licht kantoorpand"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 w-full h-full object-cover"
          style="object-position: center; filter: saturate(0.92) contrast(1.02);"
        />
      </div>
      <figcaption class="mt-4 font-mono uppercase flex items-center gap-3" style="font-size: 11px; letter-spacing: 0.16em; color: #2F5D5F;">
        <span aria-hidden="true" style="display:inline-block; width: 20px; height: 1px; background-color: #2F5D5F;"></span>
        Even bijpraten, vrijblijvend
      </figcaption>
    </figure>
  </section>

  <section class="container-x py-20 md:py-24">
    <div class="grid grid-cols-12 gap-x-6 gap-y-12">
      <div class="col-span-12 md:col-span-5 space-y-10">
        <div>
          <Eyebrow>Direct contact</Eyebrow>
          <h2 class="mt-6 font-display text-h2 text-teal-900 text-balance">
            Liever zonder formulier?
          </h2>
          <p class="mt-5 text-base text-ink-soft max-w-prose">
            Bellen of mailen kan ook. We reageren in de regel binnen één
            werkdag, op korte vragen meestal dezelfde dag nog.
          </p>

          <dl class="mt-8 space-y-5">
            <div>
              <dt class="mono-eyebrow text-teal-700">Telefoon</dt>
              <dd class="mt-1.5 font-mono text-h4 text-teal-900">
                <a href={siteData.contact.phoneHref} class="link-underline">{siteData.contact.phone}</a>
              </dd>
            </div>
            <div>
              <dt class="mono-eyebrow text-teal-700">E-mail</dt>
              <dd class="mt-1.5 text-h4 text-teal-900">
                <a href={siteData.contact.emailHref} class="link-underline">{siteData.contact.email}</a>
              </dd>
            </div>
            <div>
              <dt class="mono-eyebrow text-teal-700">Vestigingsadres</dt>
              <dd class="mt-1.5 text-base text-ink not-italic">
                {siteData.contact.address.street}<br />
                {siteData.contact.address.postal} {siteData.contact.address.city}
              </dd>
            </div>
          </dl>
        </div>

        <CalendarSlot />
      </div>

      <div class="col-span-12 md:col-span-6 md:col-start-7">
        <h2 class="font-display text-h3 text-teal-900">Stuur een bericht.</h2>
        <p class="mt-3 text-base text-ink-soft max-w-prose">
          Schrijf in een paar zinnen wat u zoekt. Binnen één werkdag horen
          we van u om een afspraak in te plannen.
        </p>
        <div class="mt-8">
          <ContactForm />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-cream border-y border-line">
    <div class="container-x py-16 md:py-20">
      <div class="grid grid-cols-12 gap-x-6 gap-y-8">
        <div class="col-span-12 md:col-span-5">
          <Eyebrow>Daarna</Eyebrow>
          <h2 class="mt-6 font-display text-h2 text-teal-900 text-balance">
            Wat er na het gesprek volgt.
          </h2>
        </div>
        <div class="col-span-12 md:col-span-6 md:col-start-7 max-w-prose space-y-5 text-base text-ink">
          <p>
            Na het kennismakingsgesprek krijgt u een helder voorstel: aanpak,
            planning, investering. Geen open einden, geen verrassingen achteraf,
           wat afgesproken is, staat.
          </p>
          <p>
            Wilt u verder met ons, dan plannen we een nulmeting. Liever niet
            verder? Ook prima. Een vrijblijvend gesprek is wat ons betreft
            ook echt vrijblijvend.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
