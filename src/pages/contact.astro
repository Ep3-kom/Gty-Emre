---
import Base from '~/layouts/Base.astro';
import ContactForm from '~/components/ui/ContactForm.astro';
import { siteData } from '~/data/site-data';
---

<Base
  title="Contact"
  description="Neem contact op met GTY. Bel, mail of stuur het formulier voor een vrijblijvend gesprek over certificering of compliance. Binnen één werkdag reactie."
>
  <section class="container-x pt-12 md:pt-16 pb-20 md:pb-28">
    <nav aria-label="Breadcrumb" class="mb-8 text-caption font-mono text-ink-soft uppercase tracking-wider">
      <a href="/" class="hover:text-teal-700">Home</a>
      <span class="mx-2 text-line-cool">/</span>
      <span class="text-teal-700">Contact</span>
    </nav>

    <div class="max-w-2xl">
      <h1 class="font-display text-h1 md:text-[3.5rem] md:leading-[1.05] text-teal-900 text-balance">
        Neem contact op.
      </h1>
      <p class="mt-6 max-w-prose text-lead text-ink-soft text-pretty">
        Een eerste gesprek is vrijblijvend. Bel of mail direct, of stuur het
        formulier, binnen één werkdag horen we van u.
      </p>
    </div>

    <div class="mt-12 md:mt-16 grid grid-cols-12 gap-x-6 gap-y-12">
      <!-- Contactgegevens -->
      <div class="col-span-12 md:col-span-4">
        <dl class="space-y-6">
          <div>
            <dt class="mono-eyebrow text-teal-700">Telefoon</dt>
            <dd class="mt-1.5 font-mono text-h4 text-teal-900">
              <a href={siteData.contact.phoneHref} class="link-underline">{siteData.contact.phone}</a>
            </dd>
          </div>
          <div>
            <dt class="mono-eyebrow text-teal-700">E-mail</dt>
            <dd class="mt-1.5 text-h4 text-teal-900">
              <a href={siteData.contact.emailHref} class="link-underline">{siteData.contact.email}</a>
            </dd>
          </div>
          <div>
            <dt class="mono-eyebrow text-teal-700">Adres</dt>
            <dd class="mt-1.5 text-base text-ink">
              {siteData.contact.address.street}<br />
              {siteData.contact.address.postal} {siteData.contact.address.city}
            </dd>
          </div>
          <div>
            <dt class="mono-eyebrow text-teal-700">Openingstijden</dt>
            <dd class="mt-1.5 text-base text-ink">{siteData.business.hours}</dd>
          </div>
        </dl>
      </div>

      <!-- Formulier -->
      <div class="col-span-12 md:col-span-7 md:col-start-6">
        <ContactForm />
      </div>
    </div>
  </section>
</Base>
