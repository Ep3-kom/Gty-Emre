---
import Base from '~/layouts/Base.astro';
import Eyebrow from '~/components/ui/Eyebrow.astro';
import CallToAction from '~/components/sections/CallToAction.astro';
import EigenaarBanner from '~/components/sections/EigenaarBanner.astro';
import { siteData } from '~/data/site-data';
---

<Base
  title="Over GTY"
  description="Waar GTY voor staat, hoe we zijn ontstaan en waarom onze begeleiding zich onderscheidt — een eerlijk verhaal over de aanpak achter het werk."
>
  <section class="border-b border-line-cool">
    <div class="container-x pt-12 md:pt-16 pb-16 md:pb-20">
      <nav aria-label="Breadcrumb" class="mb-8 text-caption font-mono text-ink-soft uppercase tracking-wider">
        <a href="/" class="hover:text-teal-700">Home</a>
        <span class="mx-2 text-line-cool">/</span>
        <span class="text-teal-700">Over GTY</span>
      </nav>

      <div class="grid grid-cols-12 gap-x-6 gap-y-8">
        <div class="col-span-12 lg:col-span-9">
          <Eyebrow>Over GTY</Eyebrow>
          {/* TODO: vraag klant naar betekenis "GTY" voor eventuele uitwerking in deze intro */}
          <h1 class="mt-6 font-display text-h1 md:text-[3.5rem] md:leading-[1.05] text-teal-900 text-balance">
            Begeleiders die <span class="display-italic">verder kijken</span> dan het stempel.
          </h1>
          <p class="mt-7 max-w-prose text-lead text-ink-soft text-pretty">
            GTY ontstond uit één gedachte: organisaties hebben recht op begeleiding
            die het certificaat niet als finish ziet. Iemand die meedenkt, eerlijk
            tegenwerpt waar nodig, en aanwezig blijft als de auditor weer weg is.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="container-x py-20 md:py-24">
    <div class="grid grid-cols-12 gap-x-6 gap-y-10">
      <div class="col-span-12 md:col-span-4">
        <Eyebrow>Hoe we zijn ontstaan</Eyebrow>
        <h2 class="mt-6 font-display text-h2 text-teal-900 text-balance">
          Niet zomaar opgericht.<br /><span class="display-italic">Uit noodzaak.</span>
        </h2>
      </div>
      <div class="col-span-12 md:col-span-7 md:col-start-6 max-w-prose space-y-5 text-base text-ink">
        <p>
          GTY werd eind {siteData.business.foundedYear} als zelfstandig
          adviesbureau gelanceerd, voortbouwend op ervaring die de oprichter
          sinds eind {siteData.business.experienceSinceYear} in het werkveld
          opbouwde — aan de binnenkant van organisaties die een
          certificeringstraject doorliepen. Telkens viel hetzelfde op: bedrijven
          die na maanden inspanning het certificaat haalden en een jaar later
          toch weer struikelden bij de opvolgaudit. Of trajecten die afgevinkt
          werden zonder dat het systeem ergens echt voet aan de grond kreeg.
        </p>
        <p>
          Het zat zelden in de norm zelf, maar in hoe trajecten werden uitgevoerd.
          Veel consultancy bleek leveren-en-vertrekken. Veel adviseurs volgden de
          letter, niet de bedoeling. Veel bureaus draaiden met roterende teams die
          per fase opnieuw moesten worden bijgepraat.
        </p>
        <p>
          Dat is de aanleiding voor GTY. Eén begeleider die u in de eerste meting
          tegenkomt en die u ook door surveillance-jaar drie voert. Geen
          overdrachten, geen team-wissels, geen ruis op de lijn. De
          dienstverlening loopt van certificering en interne audits tot
          partnerprogramma, RI&E en BHV — telkens vanuit dezelfde lijn.
        </p>
        <p class="text-ink-soft">
          Dat is geen verkooptekst — het is hoe we werken. Een jong bureau, met
          ervaring die ouder is dan de naam.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-cream">
    <div class="container-x py-20 md:py-24">
      <div class="grid grid-cols-12 gap-x-6 gap-y-12">
        <div class="col-span-12 md:col-span-5">
          <Eyebrow>Waar wij voor staan</Eyebrow>
          <h2 class="mt-6 font-display text-h2 text-teal-900 text-balance">
            Drie principes die het werk sturen.
          </h2>
          <p class="mt-5 text-base text-ink-soft max-w-prose">
            Geen marketingclaims, maar concrete houvasten — afspraken die u van
            ons mag verwachten, en waarop u ons gerust mag afrekenen.
          </p>
        </div>
        <div class="col-span-12 md:col-span-6 md:col-start-7">
          <dl class="divide-y divide-line border-y border-line">
            <div class="py-7">
              <dt class="font-display text-h3 text-teal-900">Helderheid</dt>
              <dd class="mt-3 text-base text-ink max-w-prose">
                U weet wat er ligt, wat er nog moet en wat er gevraagd wordt.
                We zeggen wat we doen, doen wat we zeggen, en laten geen
                verrassingen verdekt opgesteld — niet in het traject, niet
                op de factuur.
              </dd>
            </div>
            <div class="py-7">
              <dt class="font-display text-h3 text-teal-900">Overzicht</dt>
              <dd class="mt-3 text-base text-ink max-w-prose">
                Compliance hoeft geen permanente kopzorg te zijn. Wij houden
                de borging in beeld, zodat u zich kunt blijven richten op
                waar uw organisatie van is. Het systeem ondersteunt het werk,
                niet andersom.
              </dd>
            </div>
            <div class="py-7">
              <dt class="font-display text-h3 text-teal-900">Eigenaarschap</dt>
              <dd class="mt-3 text-base text-ink max-w-prose">
                Uw organisatie, uw systeem, uw verantwoordelijkheid. We bouwen
                zo dat u zelf grip houdt op de kwaliteit — niet afhankelijk
                van ons om aan te tonen wat u al doet. Een systeem dat
                blijft staan, ook als wij eruit stappen.
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="container-x py-20 md:py-24">
    <div class="grid grid-cols-12 gap-x-6 gap-y-10">
      <div class="col-span-12 md:col-span-7">
        <Eyebrow>Onze positie</Eyebrow>
        <h2 class="mt-6 font-display text-h2 text-teal-900 text-balance">
          Geen klassiek adviesbureau. <span class="display-italic">Iets daartussenin.</span>
        </h2>
        <div class="mt-8 max-w-prose space-y-5 text-base text-ink">
          <p>
            Een traditioneel adviesbureau levert een rapport en stapt eruit.
            Een interimmer komt drie maanden, en is daarna onbereikbaar.
            Compliance fulltime intern beleggen is voor de meeste organisaties
            niet rendabel — te zwaar voor parttime, te licht voor een vaste
            FTE.
          </p>
          <p>
            Wij zitten daar precies tussenin. We zijn structureel aanwezig
            zonder in dienst te zijn, en kennen uw mensen, uw verhaal en uw
            beslissingen — maar bewaren genoeg afstand om patronen te zien die
            van binnenuit onzichtbaar zijn geworden.
          </p>
          <p>
            Voor de directie betekent dat: geen wisselende gezichten, geen
            telkens opnieuw inwerken, geen rapport dat versloft. Voor de
            kwaliteits­functionaris: iemand die zowel uw organisatie als de norm
            doorgrondt. Voor de werkvloer: een begeleider die de praktijk niet
            als hindernis ziet maar als basis.
          </p>
        </div>
      </div>

      <aside class="col-span-12 md:col-span-4 md:col-start-9">
        <figure class="border-l border-teal-700/40 pl-6 md:pl-8">
          <blockquote class="font-display text-h3 leading-snug text-teal-900 display-italic">
            "Niet om af te vinken.<br />Om het beter te doen."
          </blockquote>
          <figcaption class="mt-5 mono-eyebrow text-teal-700">
            Waar wij voor staan
          </figcaption>
        </figure>

        <dl class="mt-12 space-y-5 text-small">
          <div>
            <dt class="mono-eyebrow text-teal-700">Opgericht</dt>
            <dd class="mt-1.5 font-mono text-ink">
              {siteData.business.foundedYear}
              <span class="text-ink-soft"> · ervaring sinds {siteData.business.experienceSinceYear}</span>
            </dd>
          </div>
          <div>
            <dt class="mono-eyebrow text-teal-700">Vestiging</dt>
            <dd class="mt-1.5 text-ink">{siteData.contact.address.city}</dd>
          </div>
          <div>
            <dt class="mono-eyebrow text-teal-700">Werkgebied</dt>
            <dd class="mt-1.5 text-ink">Heel Nederland, op locatie bij u.</dd>
          </div>
          <div>
            <dt class="mono-eyebrow text-teal-700">Sectoren</dt>
            <dd class="mt-1.5 text-ink">{siteData.business.sectorsServed.join(' · ')}</dd>
          </div>
          <div>
            <dt class="mono-eyebrow text-teal-700">Track record</dt>
            <dd class="mt-1.5 text-ink">
              {siteData.business.trajectsCompleted} trajecten afgerond ·
              {' '}{siteData.business.trajectsInProgress} klanten in begeleiding
            </dd>
          </div>
          <div>
            <dt class="mono-eyebrow text-teal-700">Specialisatie</dt>
            <dd class="mt-1.5 text-ink">ISO 9001 · ISO 14001 · ISO 27001 · HKZ · NEN 7510 · Certificatieschema Arbodiensten</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="border-y border-line-cool bg-paper">
    <div class="container-x py-20 md:py-24">
      <div class="grid grid-cols-12 gap-x-6 gap-y-10">
        <div class="col-span-12 md:col-span-5">
          <Eyebrow>Wat klanten zeggen</Eyebrow>
          <h2 class="mt-6 font-display text-h2 text-teal-900 text-balance">
            Aanbevelingen <span class="display-italic">van de mensen met wie we werken.</span>
          </h2>
          <p class="mt-5 text-base text-ink-soft max-w-prose">
            We zijn een jong bureau en de meeste trajecten lopen nog. Zodra
            klanten hun traject afronden — of eerder, als zij dat zelf willen —
            komen hun woorden hier te staan. Zonder geredigeerde marketingtekst.
          </p>
        </div>
        <div class="col-span-12 md:col-span-6 md:col-start-7">
          <ul class="grid grid-cols-1 gap-px bg-line-cool border border-line-cool">
            <li class="bg-paper p-7">
              <p class="mono-eyebrow text-teal-700">Binnenkort</p>
              <p class="mt-3 text-base text-ink-soft">
                Reviews van klanten in zorg, IT, arbodienstverlening en beveiliging
                worden hier verzameld zodra de trajecten dat toelaten.
              </p>
            </li>
            <li class="bg-paper p-7">
              <p class="mono-eyebrow text-teal-700">Liever direct spreken?</p>
              <p class="mt-3 text-base text-ink">
                We brengen u op verzoek in contact met een lopende klant in uw
                sector. <a href="/contact/" class="link-underline text-teal-700">Vraag het ons →</a>
              </p>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <CallToAction
    eyebrow="Het begin"
    title="Klaar voor de eerste afspraak?"
    body="Een vrijblijvende kennismaking kost u niets. We luisteren, geven onze inschatting en zeggen het ook als wij niet de beste keuze blijken. Geen verkooppraat, geen agenda — gewoon een gesprek."
    variant="inverse"
  />
  <EigenaarBanner />
</Base>
