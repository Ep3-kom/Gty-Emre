---
import Base from '~/layouts/Base.astro';
import Eyebrow from '~/components/ui/Eyebrow.astro';
import Button from '~/components/ui/Button.astro';
import CallToAction from '~/components/sections/CallToAction.astro';
import { siteData } from '~/data/site-data';

const trainingen = [
  {
    naam: 'Normkennis',
    beschrijving:
      'Wat staat er in ISO 9001, 14001, 27001, HKZ of NEN 7510 als u door het jargon heen kijkt? En wat betekent het voor úw organisatie? Deze training maakt de norm tastbaar en koppelt hem aan uw eigen manier van werken.',
    doelgroep: 'Directie, kwaliteitsverantwoordelijken, sleutelgebruikers',
  },
  {
    naam: 'Implementatie',
    beschrijving:
      'Hoe maakt u van norm-eisen werkende processen zonder een onnodig zware structuur op te tuigen? Praktische sessies voor de mensen die het systeem dag-in-dag-uit gebruiken.',
    doelgroep: 'Procesbegeleiders, lijn-managers',
  },
  {
    naam: 'Interne auditvaardigheden',
    beschrijving:
      'Een interne audit voert u niet om fouten te vinden, maar om te leren wat scherper kan. We trainen auditoren in vraagtechniek, waarneming en rapportages die daadwerkelijk tot verbetering leiden.',
    doelgroep: 'Interne auditoren, kwaliteitsverantwoordelijken',
  },
  {
    naam: 'Kwaliteitsmanagement',
    beschrijving:
      'Verdieping voor wie het kwaliteitsmanagementsysteem onder zijn hoede heeft. Van directiebeoordeling tot opvolging van afwijkingen, de bouwstenen die een systeem levend houden.',
    doelgroep: 'Kwaliteitsverantwoordelijken, kwaliteitsmanagers',
  },
  {
    naam: 'Informatiebeveiliging',
    beschrijving:
      'Awareness en gedragsverandering rondom informatiebeveiliging, voor zorgteams, IT, finance. Geen jaarlijkse afvink-cursus, maar een training die mensen laat doorvoelen wat veiligheid in hun werk betekent.',
    doelgroep: 'Alle medewerkers, groepen van 8–15',
  },
  {
    naam: 'Bedrijfshulpverlening (BHV)',
    beschrijving:
      'Volwaardige BHV-training bij u op locatie, afgestemd op de specifieke risico\'s en lay-out van uw werkplek. Niet een algemene EHBO-cursus, maar een training die past bij wat in úw situatie kan gebeuren.',
    doelgroep: 'Aangewezen BHV\'ers',
  },
];
---

<Base
  title="Academy"
  description="Trainingen die op uw werkvloer gegeven worden: normkennis, implementatie, interne audits, kwaliteits- en informatiebeveiligings­thema's en BHV, telkens toegesneden op uw mensen en sector."
>
  <section class="border-b border-line-cool">
    <div class="container-x pt-12 md:pt-16 pb-16 md:pb-20">
      <nav aria-label="Breadcrumb" class="mb-8 text-caption font-mono text-ink-soft uppercase tracking-wider">
        <a href="/" class="hover:text-teal-700">Home</a>
        <span class="mx-2 text-line-cool">/</span>
        <span class="text-teal-700">Academy</span>
      </nav>

      <div class="grid grid-cols-12 gap-x-6 gap-y-8">
        <div class="col-span-12 lg:col-span-9">
          <Eyebrow>GTY Academy</Eyebrow>
          <h1 class="mt-6 font-display text-h1 md:text-[3.5rem] md:leading-[1.05] text-teal-900 text-balance">
            Kennis die landt.<br /><span class="display-italic">En in uw organisatie blijft hangen.</span>
          </h1>
          <p class="mt-7 max-w-prose text-lead text-ink-soft text-pretty">
            Een certificaat houdt alleen stand als de mensen erachter begrijpen
            wat er van hen wordt verwacht. Onze trainingen komen daarom naar
            uw locatie, toegespitst op uw werk, in een taal die uw team kent
            en met voorbeelden uit de praktijk waarin ze morgen weer staan.
          </p>
          <div class="mt-9 flex flex-wrap gap-3">
            <Button href={siteData.cta.primary.href} size="lg">Vraag een training aan</Button>
            <Button href={siteData.contact.phoneHref} variant="ghost" size="lg">Of bel direct →</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="container-x py-20 md:py-24">
    <div class="grid grid-cols-12 gap-x-6 gap-y-10">
      <div class="col-span-12 md:col-span-4">
        <Eyebrow>Waarom op maat</Eyebrow>
        <h2 class="mt-6 font-display text-h2 text-teal-900 text-balance">
          Geen open inschrijvingen.<br /><span class="display-italic">Een training die op uw situatie past.</span>
        </h2>
      </div>
      <div class="col-span-12 md:col-span-7 md:col-start-6 max-w-prose space-y-5 text-base text-ink">
        <p>
          Standaardtrainingen werken voor andere bedrijven. De voorbeelden
          spelen elders, het niveau klopt niet helemaal, en wat bij u urgent
          is wordt vlakgemaakt in algemene formuleringen.
        </p>
        <p>
          Wij geven onze trainingen bij u op locatie, afgestemd op uw sector,
          uw processen en het kennisniveau van de mensen voor wie het bedoeld
          is. Voorbeelden komen uit uw werk; oefeningen sluiten aan op wat
          morgen op de werkvloer echt kan gebeuren.
        </p>
        <p class="text-ink-soft">
          Dat levert deelnemers op die niet alleen weten wát is besproken,
          maar het ook terugzien als ze hun eigen werk doen.
        </p>
      </div>
    </div>
  </section>

  <section class="border-y border-line-cool" aria-label="Trainingen in beeld">
    <div class="container-x py-16 md:py-24">
      <div class="grid grid-cols-12 gap-x-4 md:gap-x-6 gap-y-10 items-start">
        <figure class="col-span-12 md:col-span-6">
          <div class="relative overflow-hidden bg-cream-deep" style="aspect-ratio: 3 / 4;">
            <img
              src="/images/cursus%202.jpg"
              alt="Reanimatietraining met manikin tijdens een BHV-cursus"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 w-full h-full"
              style="object-fit: cover; filter: saturate(0.9) contrast(1.02);"
            />
          </div>
          <figcaption class="mt-4 font-mono uppercase flex items-center gap-3" style="font-size: 11px; letter-spacing: 0.16em; color: #2F5D5F;">
            <span aria-hidden="true" style="display:inline-block; width: 20px; height: 1px; background-color: #2F5D5F;"></span>
            Reanimatie, met manikin
          </figcaption>
        </figure>

        <figure class="col-span-12 md:col-span-6 md:mt-16">
          <div class="relative overflow-hidden bg-cream-deep" style="aspect-ratio: 3 / 4;">
            <img
              src="/images/cursus%203.jpeg"
              alt="Praktijk blusoefening met een poederblusser tijdens een BHV-training"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 w-full h-full"
              style="object-fit: cover; filter: saturate(0.9) contrast(1.02);"
            />
          </div>
          <figcaption class="mt-4 font-mono uppercase flex items-center gap-3" style="font-size: 11px; letter-spacing: 0.16em; color: #2F5D5F;">
            <span aria-hidden="true" style="display:inline-block; width: 20px; height: 1px; background-color: #2F5D5F;"></span>
            Blusoefening, buiten
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="bg-cream">
    <div class="container-x py-20 md:py-24">
      <Eyebrow>Het aanbod</Eyebrow>
      <h2 class="mt-6 max-w-2xl font-display text-h2 text-teal-900 text-balance">
        Trainingen die wij <span class="display-italic">verzorgen.</span>
      </h2>

      <ol class="mt-14 grid grid-cols-1 md:grid-cols-2 gap-px bg-line border border-line">
        {trainingen.map((tr, i) => (
          <li class="bg-cream p-7 md:p-8">
            <p class="mono-eyebrow text-teal-700">Training {String(i + 1).padStart(2, '0')}</p>
            <h3 class="mt-3 font-display text-h3 text-teal-900">{tr.naam}</h3>
            <p class="mt-4 text-base text-ink">{tr.beschrijving}</p>
            <p class="mt-5 text-caption font-mono text-ink-soft uppercase tracking-wider">{tr.doelgroep}</p>
            <a href={`${siteData.cta.primary.href}?training=${encodeURIComponent(tr.naam)}`} class="mt-5 inline-block text-small text-teal-700 link-underline">Vraag deze training aan →</a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="container-x py-20 md:py-24">
    <div class="grid grid-cols-12 gap-x-6 gap-y-10">
      <div class="col-span-12 md:col-span-5">
        <Eyebrow>De praktijk</Eyebrow>
        <h2 class="mt-6 font-display text-h2 text-teal-900 text-balance">
          De training <span class="display-italic">komt bij u langs.</span>
        </h2>
      </div>
      <div class="col-span-12 md:col-span-6 md:col-start-7 max-w-prose space-y-5 text-base text-ink">
        <p>
          We verzorgen alle trainingen op uw locatie. Dat scheelt logistiek en
          maakt de inhoud direct herkenbaar, we oefenen waar uw mensen
          werken, met situaties die ze elke dag tegenkomen.
        </p>
        <p>
          Vooraf stemmen we af welke aandachtspunten in uw organisatie spelen,
          wat er moet blijven hangen na de training, en hoe we dat toetsen.
        </p>
        <p>
          Groepen variëren tussen 8 en 15 deelnemers, afhankelijk van de
          inhoud. Voor BHV-trainingen volgen we de wettelijk vastgelegde
          minimale praktijktijd.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-paper border-t border-line-cool">
    <div class="container-x py-20 md:py-24">
      <div class="grid grid-cols-12 gap-x-6 gap-y-10">
        <div class="col-span-12 md:col-span-7">
          <Eyebrow>In samenhang</Eyebrow>
          <h2 class="mt-6 font-display text-h2 text-teal-900 text-balance">
            Trainingen die <span class="display-italic">het systeem</span> versterken.
          </h2>
          <div class="mt-8 max-w-prose space-y-5 text-base text-ink">
            <p>
              Voor klanten in een certificeringstraject of in ons Partnerprogramma
              zijn trainingen geen losse extraatjes. Ze sluiten aan op wat we
              samen bouwen, een auditor-training past in een ISO 9001-traject,
              awareness-sessies horen bij elke informatiebeveiligingstrajectorie,
              BHV kan ingebed worden in breder veiligheidsmanagement.
            </p>
            <p>
              Neemt u alleen een training af? Dan blijft het uitgangspunt
              hetzelfde: we kijken wat de training in uw organisatie moet
              opleveren en stemmen de inhoud daarop af.
            </p>
          </div>
          <div class="mt-9 flex flex-wrap gap-x-5 gap-y-3 items-center">
            <Button href="/certificering/" variant="secondary">Lees over certificering</Button>
            <Button href="/partnerprogramma/" variant="ghost">Of het Partnerprogramma →</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CallToAction
    eyebrow="Welke training zoekt u?"
    title="Een training aanvragen begint met een gesprek."
    body="In een vrijblijvend overleg kijken we welke training past, voor welke groep en in welke vorm. Geen prijslijstje met pakketten, wel een vaste werkwijze die rekening houdt met uw situatie."
  />
</Base>
