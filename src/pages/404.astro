---
import Wauw from '~/layouts/Wauw.astro';
import Hero from '~/components/wauw/blok/Hero.astro';
import Gerelateerd from '~/components/wauw/blok/Gerelateerd.astro';
import { url } from '~/data/home';
---

<Wauw title="Pagina niet gevonden" description="Deze pagina bestaat niet (meer)." noindex>
  <Hero opmaak={{ pt: '0', pb: '0' }} inhoud={{ klein: true, kicker: '404', h1: 'Deze pagina bestaat niet meer.', sub: 'De pagina is verhuisd of de link klopt niet. Hieronder kun je verder.', crumbs: [{ label: 'Home', href: '/' }], cur: 'Niet gevonden' }} />
  <Gerelateerd opmaak={{}} inhoud={{ h2: 'Verder lezen', cols: 3, items: [
    { rel: 'Certificering', label: 'Bekijk de normen', href: url.certificering },
    { rel: 'Over GTY', label: 'Onze werkwijze', href: url.werkwijze },
    { rel: 'Contact', label: 'Neem contact op', href: url.contact },
  ] }} />
</Wauw>
