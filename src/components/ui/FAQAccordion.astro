---
type Item = { vraag: string; antwoord: string };
type Props = { items: Item[]; class?: string };
const { items, class: extra = '' } = Astro.props;
---

<div class:list={['divide-y divide-line-cool border-y border-line-cool', extra]} data-faq>
  {items.map((it) => (
    <details class="group">
      <summary class="flex items-baseline justify-between gap-6 py-5 cursor-pointer">
        <span class="font-display text-h4 text-teal-900 leading-snug pr-4">{it.vraag}</span>
        <span class="shrink-0 mt-1 text-teal-700 transition-transform duration-200 group-open:rotate-45" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
            <line x1="9" y1="2" x2="9" y2="16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            <line x1="2" y1="9" x2="16" y2="9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
        </span>
      </summary>
      <div class="pb-6 max-w-prose text-base text-ink-soft" set:html={`<p>${it.antwoord}</p>`}></div>
    </details>
  ))}
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-faq]');
  root?.querySelectorAll<HTMLDetailsElement>('details').forEach((d) => {
    d.addEventListener('toggle', () => {
      if (d.open) {
        root.querySelectorAll<HTMLDetailsElement>('details').forEach((o) => {
          if (o !== d) o.open = false;
        });
      }
    });
  });
</script>
