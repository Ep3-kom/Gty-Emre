---
import { normen } from '~/data/normen';
import { t } from '~/i18n/nl';
---

<form
  action="/api/nulmeting/"
  method="POST"
  class="border border-line-cool bg-paper"
  data-nulmeting-form
  novalidate
>
  <header class="border-b border-line-cool px-6 md:px-8 py-5 flex items-baseline justify-between gap-4">
    <p class="mono-eyebrow text-teal-700"><span data-step-label>Stap 1 van 3</span></p>
    <ol class="flex gap-1.5" aria-hidden="true">
      <li class="w-10 h-1 bg-teal-700 transition-colors" data-step-indicator="1"></li>
      <li class="w-10 h-1 bg-line transition-colors" data-step-indicator="2"></li>
      <li class="w-10 h-1 bg-line transition-colors" data-step-indicator="3"></li>
    </ol>
  </header>

  <fieldset class="px-6 md:px-8 py-7 space-y-6" data-step="1">
    <legend class="font-display text-h3 text-teal-900">Uw organisatie</legend>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <label class="block">
        <span class="block text-small font-medium text-ink mb-1.5">Organisatienaam <span class="text-accent">*</span></span>
        <input required name="organisatie" type="text" class="w-full border border-line bg-paper px-3.5 py-2.5 text-base focus:outline-none focus:border-teal-700" />
      </label>
      <label class="block">
        <span class="block text-small font-medium text-ink mb-1.5">Sector</span>
        <input name="sector" type="text" placeholder="Bijv. zorg, IT, productie" class="w-full border border-line bg-paper px-3.5 py-2.5 text-base focus:outline-none focus:border-teal-700" />
      </label>
      <label class="block">
        <span class="block text-small font-medium text-ink mb-1.5">Aantal medewerkers</span>
        <select name="omvang" class="w-full border border-line bg-paper px-3.5 py-2.5 text-base focus:outline-none focus:border-teal-700">
          <option value="">— Maak een keuze</option>
          <option>1–10</option>
          <option>11–50</option>
          <option>51–250</option>
          <option>250+</option>
        </select>
      </label>
      <label class="block">
        <span class="block text-small font-medium text-ink mb-1.5">Vestiging(en)</span>
        <input name="vestigingen" type="text" placeholder="Bijv. Utrecht, of meerdere" class="w-full border border-line bg-paper px-3.5 py-2.5 text-base focus:outline-none focus:border-teal-700" />
      </label>
    </div>
  </fieldset>

  <fieldset class="hidden px-6 md:px-8 py-7 space-y-6" data-step="2">
    <legend class="font-display text-h3 text-teal-900">Uw situatie</legend>

    <div>
      <span class="block text-small font-medium text-ink mb-2">Welke norm is voor u relevant? <span class="text-accent">*</span></span>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
        {normen.map((n) => (
          <label class="flex items-start gap-3 border border-line p-3.5 cursor-pointer hover:bg-cream/50">
            <input type="checkbox" name="normen" value={n.code} class="mt-1" />
            <span>
              <span class="block font-mono text-small text-teal-900">{n.code}</span>
              <span class="block text-caption text-ink-soft">{n.shortTitle}</span>
            </span>
          </label>
        ))}
        <label class="flex items-start gap-3 border border-line p-3.5 cursor-pointer hover:bg-cream/50">
          <input type="checkbox" name="normen" value="onbekend" class="mt-1" />
          <span>
            <span class="block font-mono text-small text-teal-900">Niet zeker</span>
            <span class="block text-caption text-ink-soft">Help me kiezen</span>
          </span>
        </label>
      </div>
    </div>

    <label class="block">
      <span class="block text-small font-medium text-ink mb-1.5">Huidige status</span>
      <select name="status" class="w-full border border-line bg-paper px-3.5 py-2.5 text-base focus:outline-none focus:border-teal-700">
        <option value="">— Maak een keuze</option>
        <option>Niet gecertificeerd, geen managementsysteem</option>
        <option>Niet gecertificeerd, wel een managementsysteem</option>
        <option>Wel gecertificeerd, twijfel over de werking</option>
        <option>Gecertificeerd, voorbereiding hercertificering</option>
      </select>
    </label>

    <label class="block">
      <span class="block text-small font-medium text-ink mb-1.5">Toelichting</span>
      <textarea name="context" rows="4" class="w-full border border-line bg-paper px-3.5 py-2.5 text-base focus:outline-none focus:border-teal-700" placeholder="Aanleiding voor de nulmeting, gewenste tijdlijn, eventuele specifieke vragen."></textarea>
    </label>
  </fieldset>

  <fieldset class="hidden px-6 md:px-8 py-7 space-y-6" data-step="3">
    <legend class="font-display text-h3 text-teal-900">Contact</legend>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <label class="block">
        <span class="block text-small font-medium text-ink mb-1.5">Voornaam <span class="text-accent">*</span></span>
        <input required name="voornaam" type="text" autocomplete="given-name" class="w-full border border-line bg-paper px-3.5 py-2.5 text-base focus:outline-none focus:border-teal-700" />
      </label>
      <label class="block">
        <span class="block text-small font-medium text-ink mb-1.5">Achternaam <span class="text-accent">*</span></span>
        <input required name="achternaam" type="text" autocomplete="family-name" class="w-full border border-line bg-paper px-3.5 py-2.5 text-base focus:outline-none focus:border-teal-700" />
      </label>
      <label class="block">
        <span class="block text-small font-medium text-ink mb-1.5">Functie</span>
        <input name="functie" type="text" autocomplete="organization-title" class="w-full border border-line bg-paper px-3.5 py-2.5 text-base focus:outline-none focus:border-teal-700" />
      </label>
      <label class="block">
        <span class="block text-small font-medium text-ink mb-1.5">Telefoon</span>
        <input name="telefoon" type="tel" autocomplete="tel" class="w-full border border-line bg-paper px-3.5 py-2.5 text-base focus:outline-none focus:border-teal-700" />
      </label>
      <label class="md:col-span-2 block">
        <span class="block text-small font-medium text-ink mb-1.5">E-mail <span class="text-accent">*</span></span>
        <input required name="email" type="email" autocomplete="email" class="w-full border border-line bg-paper px-3.5 py-2.5 text-base focus:outline-none focus:border-teal-700" />
      </label>
    </div>

    <label class="flex items-start gap-3 text-small text-ink-soft">
      <input required type="checkbox" name="akkoord" class="mt-1" />
      <span>{t.forms.privacy}</span>
    </label>

    <input type="text" name="company" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
  </fieldset>

  <footer class="border-t border-line-cool px-6 md:px-8 py-5 flex items-center justify-between gap-3">
    <button type="button" data-step-prev class="px-4 py-2 text-small text-ink-soft hover:text-teal-700 disabled:opacity-40 disabled:cursor-not-allowed" disabled>
      ← Vorige
    </button>
    <div class="flex gap-3">
      <button type="button" data-step-next class="bg-teal-900 text-paper px-5 py-2.5 text-small font-medium rounded-md hover:bg-ink transition-colors">
        Volgende →
      </button>
      <button type="submit" data-submit class="hidden bg-teal-900 text-paper px-5 py-2.5 text-small font-medium rounded-md hover:bg-ink transition-colors">
        Verstuur aanvraag
      </button>
    </div>
  </footer>

  <div class="hidden px-6 md:px-8 py-12 text-center" data-success>
    <h3 class="font-display text-h2 text-teal-900">{t.forms.successTitle}</h3>
    <p class="mt-4 max-w-prose mx-auto text-base text-ink-soft">{t.forms.successBody}</p>
  </div>
  <div class="hidden px-6 md:px-8 py-8" data-error>
    <h3 class="font-display text-h3 text-accent">{t.forms.errorTitle}</h3>
    <p class="mt-3 text-base text-ink-soft">{t.forms.errorBody}</p>
  </div>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-nulmeting-form]');
  if (form) {
    const steps = form.querySelectorAll<HTMLElement>('[data-step]');
    const indicators = form.querySelectorAll<HTMLElement>('[data-step-indicator]');
    const stepLabel = form.querySelector<HTMLElement>('[data-step-label]')!;
    const next = form.querySelector<HTMLButtonElement>('[data-step-next]')!;
    const prev = form.querySelector<HTMLButtonElement>('[data-step-prev]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const success = form.querySelector<HTMLElement>('[data-success]')!;
    const errorBox = form.querySelector<HTMLElement>('[data-error]')!;
    let current = 1;
    const total = steps.length;

    const validateStep = (n: number) => {
      const step = form.querySelector<HTMLElement>(`[data-step="${n}"]`)!;
      const required = step.querySelectorAll<HTMLInputElement>('[required]');
      for (const r of required) {
        if (!r.value || (r.type === 'checkbox' && !r.checked)) {
          r.focus();
          r.classList.add('border-accent');
          return false;
        }
        r.classList.remove('border-accent');
      }
      return true;
    };

    const render = () => {
      steps.forEach((s) => s.classList.add('hidden'));
      form.querySelector(`[data-step="${current}"]`)?.classList.remove('hidden');
      indicators.forEach((i, idx) => {
        i.classList.toggle('bg-teal-700', idx + 1 <= current);
        i.classList.toggle('bg-line', idx + 1 > current);
      });
      stepLabel.textContent = `Stap ${current} van ${total}`;
      prev.disabled = current === 1;
      next.classList.toggle('hidden', current === total);
      submit.classList.toggle('hidden', current !== total);
    };

    next.addEventListener('click', () => {
      if (!validateStep(current)) return;
      if (current < total) current++;
      render();
    });
    prev.addEventListener('click', () => {
      if (current > 1) current--;
      render();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!validateStep(current)) return;
      const data = Object.fromEntries(new FormData(form));
      if (data.company) return;
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        if (!res.ok) throw new Error('submit failed');
        form.querySelectorAll('fieldset, footer').forEach((el) => el.classList.add('hidden'));
        success.classList.remove('hidden');
      } catch {
        errorBox.classList.remove('hidden');
      }
    });

    render();
  }
</script>
