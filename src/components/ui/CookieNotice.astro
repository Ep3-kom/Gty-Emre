---
import { t } from '~/i18n/nl';
---

<div
  data-cookie-notice
  class="fixed bottom-6 left-6 z-40 hidden max-w-sm w-[calc(100%-3rem)] bg-paper text-ink border border-line-cool shadow-lift rounded-lg p-6"
  role="status"
  aria-live="polite"
>
  <div class="flex items-start justify-between gap-4">
    <p class="font-display font-bold text-teal-900" style="font-size: 1.125rem; line-height: 1.2;">Cookies</p>
    <button
      type="button"
      data-cookie-dismiss
      class="shrink-0 -mt-1 -mr-1 p-1.5 text-ink-soft hover:text-teal-900 transition-colors"
      aria-label={t.cookieNotice.dismiss}
    >
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <line x1="2" y1="2" x2="12" y2="12" stroke="currentColor" stroke-width="1.4" />
        <line x1="12" y1="2" x2="2" y2="12" stroke="currentColor" stroke-width="1.4" />
      </svg>
    </button>
  </div>

  <p class="mt-3 text-small text-ink-soft">
    {t.cookieNotice.text.split('privacyverklaring')[0]}
    <a href={t.cookieNotice.privacyHref} class="link-underline text-teal-700">privacyverklaring</a>
    {t.cookieNotice.text.split('privacyverklaring')[1]}
  </p>

  <div class="mt-5 flex flex-wrap gap-3">
    <button
      type="button"
      data-cookie-dismiss
      class="inline-flex items-center justify-center bg-teal-700 text-paper text-small font-medium px-6 py-2.5 rounded-lg hover:bg-teal-900 transition-colors"
    >
      Akkoord
    </button>
    <a
      href={t.cookieNotice.privacyHref}
      class="inline-flex items-center justify-center border border-teal-900/25 text-teal-900 text-small font-medium px-6 py-2.5 rounded-lg hover:bg-teal-900/5 transition-colors"
    >
      Meer info
    </a>
  </div>
</div>

<script>
  const KEY = 'gty:cookie-notice-dismissed';
  const el = document.querySelector<HTMLElement>('[data-cookie-notice]');
  const btns = document.querySelectorAll<HTMLButtonElement>('[data-cookie-dismiss]');
  if (el && sessionStorage.getItem(KEY) !== '1') {
    el.classList.remove('hidden');
  }
  btns.forEach((btn) => {
    btn.addEventListener('click', () => {
      sessionStorage.setItem(KEY, '1');
      el?.classList.add('hidden');
    });
  });
</script>
