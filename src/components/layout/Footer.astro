---
import { siteData } from '~/data/site-data';
import { t } from '~/i18n/nl';
const year = new Date().getFullYear();
---

<footer class="bg-ink text-paper">
  <div class="container-x py-16">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="md:col-span-5">
        <a href="/" class="inline-flex items-center" aria-label="GTY home">
          <img src="/logo.svg" alt="GTY" width="80" height="36" class="h-9 w-auto" />
        </a>
        <p class="mt-5 max-w-sm text-small text-paper/75">
          GTY ondersteunt Nederlandse organisaties bij certificering en de borging
          daarna. Van eerste meting tot interne audit — één partij, één lijn.
        </p>
      </div>

      <div class="md:col-span-3 md:col-start-7">
        <h3 class="mono-eyebrow text-paper/70">{t.footer.address}</h3>
        <address class="not-italic mt-3 text-small leading-relaxed text-paper/85">
          {siteData.contact.address.street}<br />
          {siteData.contact.address.postal} {siteData.contact.address.city}<br />
          {siteData.contact.address.country}
        </address>
        <div class="mt-5 space-y-1.5 text-small">
          <a href={siteData.contact.phoneHref} class="block link-underline font-mono">{siteData.contact.phone}</a>
          <a href={siteData.contact.emailHref} class="block link-underline">{siteData.contact.email}</a>
        </div>
      </div>

      <div class="md:col-span-2">
        <h3 class="mono-eyebrow text-paper/70">{t.footer.services}</h3>
        <ul class="mt-3 space-y-1.5 text-small text-paper/85">
          <li><a href="/certificering/" class="link-underline">Certificering</a></li>
          <li><a href="/partnerprogramma/" class="link-underline">Partnerprogramma</a></li>
          <li><a href="/interne-audits/" class="link-underline">Interne audits</a></li>
          <li><a href="/academy/" class="link-underline">Academy</a></li>
        </ul>
      </div>

      <div class="md:col-span-2">
        <h3 class="mono-eyebrow text-paper/70">{t.footer.navigation}</h3>
        <ul class="mt-3 space-y-1.5 text-small text-paper/85">
          <li><a href="/werkwijze/" class="link-underline">{t.nav.werkwijze}</a></li>
          <li><a href="/over-ons/" class="link-underline">{t.nav.overOns}</a></li>
          <li><a href="/contact/" class="link-underline">{t.nav.contact}</a></li>
          <li><a href="/inzichten/" class="link-underline">Inzichten</a></li>
        </ul>
      </div>
    </div>

    <hr class="mt-14 border-paper/15" />

    <div class="mt-6 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <p class="text-caption text-paper/60 font-mono">
        © {year} {t.footer.copyright}
      </p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2 text-caption text-paper/60 font-mono">
        <li><a href="/privacyverklaring/" class="link-underline">{t.footer.privacy}</a></li>
        <li><a href="/algemene-voorwaarden/" class="link-underline">{t.footer.terms}</a></li>
        <li><a href="/cookiebeleid/" class="link-underline">{t.footer.cookies}</a></li>
        <li><a href="/disclaimer/" class="link-underline">{t.footer.disclaimer}</a></li>
      </ul>
    </div>
  </div>
</footer>
