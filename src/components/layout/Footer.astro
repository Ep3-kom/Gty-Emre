---
import { siteData } from '~/data/site-data';
import { t } from '~/i18n/nl';
const year = new Date().getFullYear();
---

<footer style="background-color: #0F1B1F; color: #FFFFFF; border-top: 1px solid rgba(47,93,95,0.2);">
  <div class="container-x py-16">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="md:col-span-5">
        <a href="/" class="inline-flex items-center" aria-label="GTY home">
          <img src="/logo.svg" alt="GTY" width="80" height="36" class="h-9 w-auto" />
        </a>
        <p class="mt-5 max-w-sm" style="font-size: 14px; line-height: 1.6; color: rgba(255,255,255,0.7);">
          GTY ondersteunt Nederlandse organisaties bij certificering en de borging
          daarna. Van eerste meting tot interne audit — één partij, één lijn.
        </p>
      </div>

      <div class="md:col-span-3 md:col-start-7">
        <h3 class="font-mono uppercase" style="font-size: 11px; letter-spacing: 0.15em; color: rgba(255,255,255,0.6);">
          {t.footer.address}
        </h3>
        <address class="not-italic mt-3" style="font-size: 14px; line-height: 1.6; color: rgba(255,255,255,0.85);">
          {siteData.contact.address.street}<br />
          {siteData.contact.address.postal} {siteData.contact.address.city}<br />
          {siteData.contact.address.country}
        </address>
        <div class="mt-5 space-y-1.5" style="font-size: 14px;">
          <a
            href={siteData.contact.phoneHref}
            class="block font-mono footer-link"
            style="color: rgba(255,255,255,0.85);"
          >
            {siteData.contact.phone}
          </a>
          <a
            href={siteData.contact.emailHref}
            class="block footer-link"
            style="color: rgba(255,255,255,0.85);"
          >
            {siteData.contact.email}
          </a>
        </div>
        <dl
          class="mt-5 grid grid-cols-[auto,1fr] gap-x-3 gap-y-1 font-mono"
          style="font-size: 11px; letter-spacing: 0.04em; color: rgba(255,255,255,0.5);"
        >
          <dt style="color: rgba(255,255,255,0.4);">Openingstijden</dt>
          <dd>{siteData.business.hours}</dd>
          <dt style="color: rgba(255,255,255,0.4);">KvK</dt>
          <dd>{siteData.business.kvk}</dd>
          <dt style="color: rgba(255,255,255,0.4);">BTW</dt>
          <dd>{siteData.business.vat}</dd>
        </dl>
      </div>

      <div class="md:col-span-2">
        <h3 class="font-mono uppercase" style="font-size: 11px; letter-spacing: 0.15em; color: rgba(255,255,255,0.6);">
          {t.footer.services}
        </h3>
        <ul class="mt-3 space-y-1.5" style="font-size: 14px; color: rgba(255,255,255,0.85);">
          <li><a href="/certificering/" class="footer-link">Certificering</a></li>
          <li><a href="/partnerprogramma/" class="footer-link">Partnerprogramma</a></li>
          <li><a href="/interne-audits/" class="footer-link">Interne audits</a></li>
          <li><a href="/academy/" class="footer-link">Academy</a></li>
        </ul>
      </div>

      <div class="md:col-span-2">
        <h3 class="font-mono uppercase" style="font-size: 11px; letter-spacing: 0.15em; color: rgba(255,255,255,0.6);">
          {t.footer.navigation}
        </h3>
        <ul class="mt-3 space-y-1.5" style="font-size: 14px; color: rgba(255,255,255,0.85);">
          <li><a href="/werkwijze/" class="footer-link">{t.nav.werkwijze}</a></li>
          <li><a href="/over-ons/" class="footer-link">{t.nav.overOns}</a></li>
          <li><a href="/contact/" class="footer-link">{t.nav.contact}</a></li>
          <li><a href="/inzichten/" class="footer-link">Inzichten</a></li>
        </ul>
      </div>
    </div>

    <hr class="mt-14" style="border: none; border-top: 1px solid rgba(255,255,255,0.12);" />

    <div class="mt-6 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <p class="font-mono" style="font-size: 11px; color: rgba(255,255,255,0.55);">
        © {year} {t.footer.copyright}
      </p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2 font-mono" style="font-size: 11px; color: rgba(255,255,255,0.55);">
        <li><a href="/privacyverklaring/" class="footer-link">{t.footer.privacy}</a></li>
        <li><a href="/algemene-voorwaarden/" class="footer-link">{t.footer.terms}</a></li>
        <li><a href="/cookiebeleid/" class="footer-link">{t.footer.cookies}</a></li>
        <li><a href="/disclaimer/" class="footer-link">{t.footer.disclaimer}</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer-link {
    transition: color 180ms ease;
  }
  .footer-link:hover {
    color: #2F5D5F;
  }
</style>
