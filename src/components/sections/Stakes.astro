---
const zonder = [
  'Een implementatie die uw team meer kost dan ze oplevert',
  'Een systeem dat alleen in mappen leeft en niet op de werkvloer',
  'Een surveillance-audit die opnieuw een sprint vooraf eist',
  'Normwijzigingen die u pas merkt als ze al verwerkt hadden moeten zijn',
];
const met = [
  'Een traject dat uw organisatie scherper achterlaat dan u begon',
  'Een systeem dat herkenbaar is voor de mensen die ermee werken',
  'Audits die u rustig en voorbereid ingaat',
  'Een begeleider die normupdates al voor u in beeld heeft',
];
---

<section style="background-color: #FFFFFF;">
  <div class="container-x" style="padding-block: clamp(60px, 8vw, 100px);">
    <p class="font-mono uppercase" style="font-size: 11px; letter-spacing: 0.15em; color: #2F5D5F;">Het verschil zit erna</p>
    <h2
      class="mt-6 max-w-3xl font-display font-bold text-balance"
      style="color: #0F1B1F; font-size: clamp(2rem, 4vw, 3.5rem); line-height: 1.08;"
    >
      Een goed traject merkt u <span class="italic font-normal" style="color: #2F5D5F;">pas echt</span> in het jaar daarop.
    </h2>

    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 relative">
      <div
        aria-hidden="true"
        class="hidden md:block absolute top-0 bottom-0 left-1/2"
        style="width: 1px; background-color: rgba(47,93,95,0.2);"
      ></div>

      <div class="py-8 md:pr-12">
        <p class="font-mono uppercase" style="font-size: 11px; letter-spacing: 0.15em; color: #2F5D5F;">Zonder goede begeleiding</p>
        <ul class="mt-6 space-y-4" style="font-size: 1.0625rem; line-height: 1.6; color: #0F1B1F;">
          {zonder.map((z) => (
            <li class="flex items-start gap-3">
              <span aria-hidden="true" style="color: #B8462E; font-weight: 700; line-height: 1.6;">—</span>
              <span>{z}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="py-8 md:pl-12 border-t md:border-t-0" style="border-color: rgba(47,93,95,0.2);">
        <p class="font-mono uppercase" style="font-size: 11px; letter-spacing: 0.15em; color: #2F5D5F;">Met GTY aan boord</p>
        <ul class="mt-6 space-y-4" style="font-size: 1.0625rem; line-height: 1.6; color: #0F1B1F;">
          {met.map((m) => (
            <li class="flex items-start gap-3">
              <span aria-hidden="true" style="color: #B8462E; font-weight: 700; line-height: 1.6;">—</span>
              <span>{m}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
