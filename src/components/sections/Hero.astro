---
import { siteData } from '~/data/site-data';
---

<section class="relative isolate overflow-hidden text-white" style="height: 100vh;">
  <img
    src="/images/gty-hero-audit-discussion.jpg"
    alt="Twee professionals in gesprek tijdens een audit-overleg in een lichte werkomgeving."
    width="2400"
    height="1350"
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="absolute inset-0 -z-20 h-full w-full object-cover"
    style="object-position: center right;"
  />

  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10"
    style="background-color: rgba(47, 93, 95, 0.18);"
  ></div>
  <div
    aria-hidden="true"
    class="absolute inset-y-0 left-0 -z-10 w-full md:w-3/4 lg:w-2/3"
    style="background: linear-gradient(to right, rgba(15,27,31,0.65), rgba(15,27,31,0.15) 70%, transparent);"
  ></div>

  <div class="container-x relative pt-[152px] md:pt-[176px] pb-20 h-full flex flex-col justify-center">
    <div class="grid grid-cols-12 gap-x-6">
      <div class="col-span-12 lg:col-span-8 xl:col-span-7">
        <p class="font-mono uppercase text-white/90" style="font-size: 11px; letter-spacing: 0.15em;">
          Certificering en borging, in één hand
        </p>

        <h1
          class="mt-6 font-display font-bold text-balance text-white"
          style="font-size: clamp(2.4rem, 5.5vw, 4.5rem); line-height: 1.05; text-shadow: 0 1px 24px rgba(8,24,26,0.45);"
        >
          Een norm die werkt.<br />
          <span class="italic font-normal" style="color: #FFFFFF;">Een systeem dat blijft.</span>
        </h1>

        <p class="mt-7 max-w-prose text-pretty" style="font-size: 1.125rem; line-height: 1.65; color: rgba(241,235,221,0.92);">
          Of de aanleiding nu een aanbesteding is, een eis van uw opdrachtgever of een
          regel binnen uw sector — wij begeleiden u tot het certificaat er staat. En
          blijven daarna betrokken, zodat het systeem niet stilvalt zodra de auditor
          vertrekt.
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-3">
          <a
            href={siteData.cta.primary.href}
            class="inline-flex items-center justify-center px-7 py-3.5 font-medium text-white transition-colors hover:bg-black"
            style="background-color: #0F1B1F; font-size: 15px;"
          >
            {siteData.cta.primary.label}
          </a>
          <a
            href={siteData.cta.secondary.href}
            class="inline-flex items-center justify-center px-7 py-3.5 font-medium text-white border border-white/45 transition-colors hover:bg-white/10"
            style="font-size: 15px;"
          >
            {siteData.cta.secondary.label} →
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<section style="background-color: #FAFAF7;">
  <div class="container-x" style="padding-block: clamp(96px, 12vw, 144px);">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-x-10 lg:gap-x-16 gap-y-12 md:gap-y-0 items-start">
      {[
        { roman: 'I', a: 'U weet wat er ligt,', b: 'en wat er nog moet.', offset: '' },
        { roman: 'II', a: 'Niets blijft hangen,', b: 'niets overvalt u.', offset: 'md:mt-10' },
        { roman: 'III', a: 'Uw mensen sturen,', b: 'wij ondersteunen.', offset: 'md:mt-20' },
      ].map(({ roman, a, b, offset }) => (
        <article class={`pillar ${offset}`}>
          <span aria-hidden="true" class="pillar-cap"></span>
          <div class="pillar-inner">
            <span
              class="pillar-roman font-mono"
              aria-hidden="true"
            >{roman}</span>
            <p
              class="pillar-text font-display"
            >
              {a}<br />
              <span class="pillar-accent">{b}</span>
            </p>
          </div>
          <span aria-hidden="true" class="pillar-foot"></span>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .pillar {
    position: relative;
    background-color: #FFFFFF;
    border-left: 1px solid rgba(47,93,95,0.18);
    border-right: 1px solid rgba(47,93,95,0.18);
    min-height: 280px;
    display: flex;
    flex-direction: column;
  }
  .pillar-cap {
    display: block;
    height: 3px;
    background-color: #B8462E;
  }
  .pillar-inner {
    flex: 1;
    padding: 36px 28px 32px;
    position: relative;
  }
  .pillar-roman {
    position: absolute;
    top: 16px;
    right: 16px;
    font-size: 10px;
    letter-spacing: 0.18em;
    color: rgba(184,70,46,0.7);
  }
  .pillar-text {
    margin-top: 28px;
    color: #0F1B1F;
    font-size: clamp(1.375rem, 1.8vw, 1.75rem);
    line-height: 1.3;
    font-weight: 500;
    letter-spacing: -0.01em;
    max-width: 22ch;
  }
  .pillar-accent {
    color: #2F5D5F;
  }
  .pillar-foot {
    display: block;
    height: 1px;
    margin: 0 -1px;
    background-color: rgba(47,93,95,0.18);
  }

  @media (min-width: 768px) {
    .pillar {
      min-height: 320px;
    }
    .pillar-inner {
      padding: 44px 32px 36px;
    }
    .pillar-text {
      margin-top: 36px;
    }
  }
</style>
