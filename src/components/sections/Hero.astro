---
import { siteData } from '~/data/site-data';
---

<section
  class="relative isolate overflow-hidden text-white"
  style="background-color: #0F1B1F; min-height: clamp(640px, 92vh, 960px);"
>
  <div
    aria-hidden="true"
    class="absolute inset-y-0 right-0 hidden lg:block"
    style="width: 56%; clip-path: polygon(18% 0%, 100% 0%, 100% 100%, 0% 100%);"
  >
    <img
      src="/images/gty-hero-audit-discussion.jpg"
      alt=""
      width="2400"
      height="1350"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover"
      style="object-position: center right; filter: saturate(0.9) contrast(1.02);"
    />
    <div
      aria-hidden="true"
      class="absolute inset-0"
      style="background: linear-gradient(to right, rgba(15,27,31,0.55), rgba(15,27,31,0.1) 35%, rgba(15,27,31,0) 70%);"
    ></div>
  </div>

  <div
    aria-hidden="true"
    class="lg:hidden absolute inset-x-0 bottom-0"
    style="height: 38%;"
  >
    <img
      src="/images/gty-hero-audit-discussion.jpg"
      alt=""
      loading="eager"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover opacity-50"
      style="object-position: center right;"
    />
    <div
      aria-hidden="true"
      class="absolute inset-0"
      style="background: linear-gradient(to bottom, #0F1B1F 0%, rgba(15,27,31,0.7) 30%, rgba(15,27,31,0.4) 100%);"
    ></div>
  </div>

  <div class="container-x relative pt-[152px] md:pt-[176px] pb-20 flex flex-col justify-center" style="min-height: inherit;">
    <div class="grid grid-cols-12 gap-x-6">
      <div class="col-span-12 lg:col-span-6">
        <p class="font-mono uppercase" style="font-size: 11px; letter-spacing: 0.18em; color: rgba(241,235,221,0.75);">
          Certificering en borging, in één hand
        </p>

        <h1
          class="mt-7 font-display font-bold text-balance text-white"
          style="font-size: clamp(2.4rem, 5.5vw, 4.5rem); line-height: 1.05; letter-spacing: -0.01em;"
        >
          Een norm die werkt.<br />
          <span class="italic font-normal" style="color: #FFFFFF;">Een systeem dat blijft.</span>
        </h1>

        <p class="mt-7 max-w-prose text-pretty" style="font-size: 1.125rem; line-height: 1.65; color: rgba(241,235,221,0.85);">
          Of de aanleiding nu een aanbesteding is, een eis van uw opdrachtgever of een
          regel binnen uw sector — wij begeleiden u tot het certificaat er staat. En
          blijven daarna betrokken, zodat het systeem niet stilvalt zodra de auditor
          vertrekt.
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-3">
          <a
            href={siteData.cta.primary.href}
            class="inline-flex items-center justify-center px-7 py-3.5 font-medium transition-opacity hover:opacity-90"
            style="background-color: #FFFFFF; color: #0F1B1F; font-size: 15px;"
          >
            {siteData.cta.primary.label}
          </a>
          <a
            href={siteData.cta.secondary.href}
            class="inline-flex items-center justify-center px-7 py-3.5 font-medium text-white border border-white/45 transition-colors hover:bg-white/10"
            style="font-size: 15px;"
          >
            {siteData.cta.secondary.label} →
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<section style="background-color: #FFFFFF; border-bottom: 1px solid rgba(47,93,95,0.12);">
  <div class="container-x" style="padding-block: clamp(56px, 7vw, 88px);">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-x-12 lg:gap-x-20 gap-y-8 md:gap-y-0 items-start">
      <p
        class="font-display"
        style="border-left: 2px solid #2F5D5F; padding-left: 20px; color: #0F1B1F; font-size: clamp(1.375rem, 1.8vw, 1.625rem); line-height: 1.3; font-weight: 500; letter-spacing: -0.01em; max-width: 24ch;"
      >
        U weet wat er ligt,<br />
        <span style="color: #2F5D5F;">en wat er nog moet.</span>
      </p>

      <p
        class="font-display"
        style="border-left: 2px solid #2F5D5F; padding-left: 20px; color: #0F1B1F; font-size: clamp(1.375rem, 1.8vw, 1.625rem); line-height: 1.3; font-weight: 500; letter-spacing: -0.01em; max-width: 24ch;"
      >
        Niets blijft hangen,<br />
        <span style="color: #2F5D5F;">niets overvalt u.</span>
      </p>

      <p
        class="font-display"
        style="border-left: 2px solid #2F5D5F; padding-left: 20px; color: #0F1B1F; font-size: clamp(1.375rem, 1.8vw, 1.625rem); line-height: 1.3; font-weight: 500; letter-spacing: -0.01em; max-width: 24ch;"
      >
        Uw mensen sturen,<br />
        <span style="color: #2F5D5F;">wij ondersteunen.</span>
      </p>
    </div>
  </div>
</section>
