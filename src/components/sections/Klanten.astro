---
type Klant = { naam: string; logo: string; small?: boolean };

const klanten: Klant[] = [
  { naam: 'AE Security Group', logo: '/images/klanten/ae-security-group.png' },
  { naam: 'Certicor', logo: '/images/klanten/certicor.png' },
  { naam: 'Ir. Lely Lyceum', logo: '/images/klanten/ir-lely-lyceum.png' },
  { naam: 'iCNT', logo: '/images/klanten/iCNT-logo-zwart-oranje.png', small: true },
  { naam: 'KinderKidz Opvang', logo: '/images/klanten/kinderkidz-opvang.png' },
  { naam: 'Shadow Security', logo: '/images/klanten/shadow-security.png' },
  { naam: 'JeugdSterk', logo: '/images/klanten/jeugdsterk.png' },
  { naam: 'Linden Tree Care', logo: '/images/klanten/linden-tree-care.png' },
  { naam: 'Smile Place Tandartsen', logo: '/images/klanten/smile-place-tandartsen.png' },
  { naam: 'dAP — De Arbo Pioniers', logo: '/images/klanten/dap-arbo-pioniers.png' },
  { naam: 'Zorgstip', logo: '/images/klanten/zorgstip.png' },
  { naam: 'Emirs Foundation', logo: '/images/klanten/emirs-foundation.png' },
];

const track = [...klanten, ...klanten];
---

<section class="relative" style="background-color: #FFFFFF; border-top: 1px solid rgba(47,93,95,0.15); border-bottom: 1px solid rgba(47,93,95,0.15);">
  <div class="container-x pt-20 md:pt-28 pb-10 md:pb-14 max-w-3xl mx-auto">
    <h2
      class="font-display font-bold text-balance"
      style="color: #0F1B1F; font-size: clamp(2.2rem, 5vw, 4.25rem); line-height: 1.04; letter-spacing: -0.02em;"
    >
      Eens met ons begonnen. <span class="italic font-normal" style="color: #2F5D5F;">Nog steeds samen.</span>
    </h2>

    <p class="mt-6 max-w-prose text-pretty" style="font-size: 1.125rem; line-height: 1.65; color: rgba(15,27,31,0.72);">
      Van zorgaanbieders en scholen tot beveiligers, kinderopvang en arbo-adviseurs —
      twaalf organisaties uit zes verschillende sectoren, allemaal begeleid vanuit
      dezelfde aanpak.
    </p>
  </div>

  <div class="klanten-marquee relative pb-16 md:pb-20">
    <div class="klanten-track" role="list" aria-label="Klanten van GTY">
      {track.map((k, i) => (
        <div
          role="listitem"
          aria-hidden={i >= klanten.length ? 'true' : undefined}
          class="klanten-card"
        >
          <img
            src={k.logo}
            alt={i >= klanten.length ? '' : `Logo ${k.naam}`}
            width="200"
            height="100"
            loading="lazy"
            decoding="async"
            class:list={[k.small && 'logo-small']}
          />
        </div>
      ))}
    </div>

    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-y-0 left-0 w-16 md:w-32"
      style="background: linear-gradient(to right, #FFFFFF, transparent);"
    ></div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-y-0 right-0 w-16 md:w-32"
      style="background: linear-gradient(to left, #FFFFFF, transparent);"
    ></div>
  </div>
</section>

<style>
  .klanten-marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
            mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }

  .klanten-track {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    width: max-content;
    animation: klanten-scroll 50s linear infinite;
    will-change: transform;
  }

  .klanten-marquee:hover .klanten-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .klanten-track {
      animation: none;
      transform: none;
      flex-wrap: wrap;
      justify-content: center;
      width: auto;
      padding: 0 1.5rem;
    }
  }

  @keyframes klanten-scroll {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(-50%, 0, 0); }
  }

  .klanten-card {
    flex: 0 0 auto;
    width: 230px;
    height: 130px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #FFFFFF;
    border: 1px solid rgba(47, 93, 95, 0.15);
    padding: 1.25rem 1.5rem;
    transition: border-color 200ms ease, transform 200ms ease;
  }

  .klanten-card:hover {
    border-color: rgba(47, 93, 95, 0.45);
  }

  .klanten-card img {
    width: auto;
    height: 114px;
    max-width: 90%;
    object-fit: contain;
    filter: grayscale(100%);
    opacity: 0.75;
    transition: filter 250ms ease, opacity 250ms ease;
  }

  .klanten-card img.logo-small {
    height: 58px;
  }

  .klanten-card:hover img {
    filter: grayscale(0%);
    opacity: 1;
  }

  @media (min-width: 768px) {
    .klanten-card {
      width: 270px;
      height: 150px;
    }
    .klanten-card img {
      height: 126px;
    }
    .klanten-card img.logo-small {
      height: 64px;
    }
    .klanten-track {
      gap: 1.5rem;
    }
  }
</style>
