---
import Eyebrow from '~/components/ui/Eyebrow.astro';

const stappen = [
  {
    nr: '01',
    titel: 'In kaart brengen',
    body: 'We beginnen met een feitelijke meting: waar staat uw organisatie nu, gemeten langs de norm. Geen schattingen — een vertrekpunt waarop het hele traject realistisch te plannen valt.',
    duur: 'Gemiddeld 1 tot 3 weken',
  },
  {
    nr: '02',
    titel: 'Inrichten en invoeren',
    body: 'We bouwen het managementsysteem mee op naast uw team. Processen, dossiers, rollen en bewustwording krijgen vorm op een manier die aansluit bij hoe het werk werkelijk wordt uitgevoerd.',
    duur: 'Variabel naar norm en omvang',
  },
  {
    nr: '03',
    titel: 'Beoordeling en borging',
    body: 'We zetten u klaar voor de externe audit en lopen mee in het contact met de certificerende instelling. Daarna kunt u via ons Partnerprogramma de continuïteit borgen — los daarvan blijven we beschikbaar.',
    duur: 'Tot na het certificaat',
  },
];
---

<section class="container-x py-20 md:py-28">
  <div class="max-w-narrow">
    <Eyebrow>De aanpak</Eyebrow>
    <h2 class="mt-6 font-display text-h2 text-teal-900 text-balance">
      Drie fasen. <span class="display-italic">Niets dat u overvalt.</span>
    </h2>
    <p class="mt-5 max-w-prose text-lead text-ink-soft">
      Ieder traject doorloopt dezelfde drie fasen. De invulling daarbinnen schalen we
      naar uw norm, uw sector en het punt waar u nu staat.
    </p>
  </div>

  <ol class="mt-14 grid grid-cols-1 md:grid-cols-12 gap-y-10 md:gap-x-6 relative">
    <div class="hidden md:block absolute left-0 right-0 top-[14px] h-px bg-line-cool"></div>

    {stappen.map((s) => (
      <li class="md:col-span-4 relative">
        <div class="hidden md:block absolute -top-1 left-0 w-2.5 h-2.5 rounded-full bg-teal-700"></div>
        <p class="md:pt-9 mono-eyebrow text-teal-700">{s.nr}</p>
        <h3 class="mt-2 font-display text-h3 text-teal-900">{s.titel}</h3>
        <p class="mt-4 text-base text-ink max-w-[36ch]">{s.body}</p>
        <p class="mt-4 text-caption font-mono text-ink-soft uppercase tracking-wider">{s.duur}</p>
      </li>
    ))}
  </ol>
</section>
