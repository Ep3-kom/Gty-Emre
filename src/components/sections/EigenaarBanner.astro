---
import { siteData } from '~/data/site-data';
---

<section class="bg-paper py-16 md:py-20">
  <div class="container-x">
    <div class="rounded-2xl bg-cream px-8 md:px-14 py-10 md:py-12 flex flex-col md:flex-row items-center gap-10 md:gap-0 overflow-hidden">

      <!-- Links: tekst + knoppen -->
      <div class="flex-1 md:pr-10">
        <p class="text-small text-ink-soft">Persoonlijk kennis maken?</p>
        <h2 class="mt-3 font-sans font-bold text-[1.9rem] md:text-[2.5rem] leading-[1.1] tracking-[-0.02em] text-teal-900">
          Maak kennis met<br />Emre Ozdemir
        </h2>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href={siteData.contact.phoneHref}
            class="inline-flex items-center gap-2 border border-teal-900/30 text-teal-900 text-small font-medium px-5 py-3 rounded-full hover:bg-teal-900 hover:text-paper transition-colors"
          >
            {siteData.contact.phone}
          </a>
          <a
            href="/contact/"
            class="inline-flex items-center gap-2 border border-teal-900/30 text-teal-900 text-small font-medium px-5 py-3 rounded-full hover:bg-teal-900 hover:text-paper transition-colors"
          >
            Plan een kennismakingsgesprek
          </a>
          <a
            href="/contact/"
            aria-label="Naar contactpagina"
            class="inline-flex items-center justify-center w-11 h-11 border border-teal-900/30 text-teal-900 rounded-full hover:bg-teal-900 hover:text-paper transition-colors text-base"
          >
            ↗
          </a>
        </div>
      </div>

      <!-- Rechts: foto -->
      <div class="flex-shrink-0">
        <div class="w-52 md:w-64 lg:w-72 rounded-2xl overflow-hidden bg-[#DDE7EE]">
          <img
            src="/foto-eigenaar-removebg-preview.png"
            alt="Emre Ozdemir, oprichter van GTY"
            width="288"
            height="340"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover object-top"
          />
        </div>
      </div>

    </div>
  </div>
</section>
