---
import { siteData } from '~/data/site-data';
---

<section class="relative bg-[#DDE7EE] overflow-visible">
  <div class="container-x">
    <div class="grid grid-cols-12 gap-x-6 gap-y-8 items-center">
      <div
        class="col-span-12 sm:col-span-5 md:col-span-4 lg:col-span-3 relative flex justify-center sm:justify-start"
      >
        <figure class="relative aspect-[3/4] w-full max-w-[300px] sm:max-w-none -mb-16 sm:-mb-20 md:-mb-28 lg:-mb-36 z-10">
          <img
            src="/foto-eigenaar.jpeg"
            alt="Portret van de oprichter van GTY"
            width="800"
            height="800"
            loading="lazy"
            decoding="async"
            class="block w-full h-full object-cover object-[center_22%] drop-shadow-[0_30px_40px_rgba(0,31,50,0.25)]"
          />
        </figure>
      </div>

      <div
        class="col-span-12 sm:col-span-7 md:col-span-8 lg:col-span-9 py-14 md:py-20 lg:py-24 md:pl-6 lg:pl-10"
      >
        <h2
          class="font-sans font-semibold text-[1.9rem] sm:text-[2.25rem] md:text-[2.6rem] lg:text-[3.1rem] leading-[1.08] tracking-[-0.02em] text-teal-900 text-balance"
        >
          Wilt u GTY persoonlijk leren kennen?
        </h2>

        <p class="mt-5 max-w-prose text-lead text-ink-soft text-pretty">
          We nemen graag de tijd voor een vrijblijvend gesprek over uw organisatie.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
          <a
            href={siteData.cta.primary.href}
            class="group inline-flex items-center gap-3 bg-teal-900 text-paper px-7 py-3.5 text-small font-medium hover:bg-ink transition-colors"
          >
            Contact
            <span
              aria-hidden="true"
              class="inline-block transition-transform group-hover:translate-x-1"
            >→</span>
          </a>
          <a
            href={siteData.contact.phoneHref}
            class="text-small text-ink hover:text-teal-700 transition-colors"
          >
            Of bel direct
            <span class="font-medium ml-1 underline decoration-teal-700/30 underline-offset-4 hover:decoration-teal-700">
              {siteData.contact.phone}
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
