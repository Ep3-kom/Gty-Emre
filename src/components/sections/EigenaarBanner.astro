---
import { siteData } from '~/data/site-data';
---

<section class="relative overflow-hidden" style="background-color: #FFFFFF;">
  <div class="container-x" style="padding-block: clamp(60px, 8vw, 100px);">
    <div class="grid grid-cols-12 gap-x-6 gap-y-10 items-center">
      <div class="col-span-12 md:col-span-5 lg:col-span-4 relative">
        <figure
          class="relative"
          style="width: 280px; height: 360px; max-width: 100%; margin-left: -5%;"
        >
          <img
            src="/images/eigenaar-foto.jpg"
            alt="Portret van de oprichter van GTY"
            width="800"
            height="800"
            loading="lazy"
            decoding="async"
            class="block w-full h-full object-cover"
            style="border-radius: 4px; object-position: center 22%; box-shadow: 0 24px 48px -16px rgba(47,93,95,0.35);"
          />
        </figure>
      </div>

      <div class="col-span-12 md:col-span-7 lg:col-span-8 md:pl-10 lg:pl-16">
        <p class="font-mono uppercase" style="font-size: 11px; letter-spacing: 0.15em; color: #2F5D5F;">Persoonlijk</p>
        <h2
          class="mt-5 font-display font-bold text-balance"
          style="color: #0F1B1F; font-size: clamp(1.9rem, 4vw, 3.1rem); line-height: 1.08;"
        >
          Wilt u GTY persoonlijk leren kennen?
        </h2>

        <p class="mt-5 max-w-prose text-pretty" style="font-size: 1.125rem; line-height: 1.65; color: rgba(15,27,31,0.72);">
          We nemen graag de tijd voor een vrijblijvend gesprek over uw organisatie.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
          <a
            href={siteData.cta.primary.href}
            class="group inline-flex items-center gap-3 text-white px-7 py-3.5 font-medium transition-colors"
            style="background-color: #B8462E; font-size: 15px;"
          >
            Contact
            <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-1">→</span>
          </a>
          <a
            href={siteData.contact.phoneHref}
            class="inline-flex items-center gap-2"
            style="font-size: 15px; color: #0F1B1F;"
          >
            <span>Of bel direct</span>
            <span
              class="font-mono"
              style="color: #2F5D5F; border-bottom: 1px solid rgba(47,93,95,0.4);"
            >
              {siteData.contact.phone}
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
