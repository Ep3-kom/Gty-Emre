---
// Klantlogo's als doorlopende slideshow, zwart-wit en zonder kaders.
import type { ImageMetadata } from 'astro';
import { klanten } from '~/data/home';

const bestanden = import.meta.glob<ImageMetadata>('~/assets/klanten/*', { eager: true, import: 'default' });
const { namen } = Astro.props as { namen?: string[] };
const lijst = namen
  ? namen.map((naam) => {
      const klant = klanten.find((k) => k.naam === naam);
      if (!klant) throw new Error(`Onbekende klant: ${naam}`);
      return klant;
    })
  : klanten;

// Weinig logo's: gewoon naast elkaar. Anders herhalen tot de rij breder is dan het scherm en dubbel zetten voor de lus.
const beweegt = lijst.length >= 5;
const rij = beweegt ? Array.from({ length: Math.ceil(8 / lijst.length) }, () => lijst).flat() : lijst;
const kaarten = (beweegt ? [...rij, ...rij] : rij).map((k, i) => ({ ...k, dubbel: i >= lijst.length }));
---
<div class:list={['klanten', beweegt && 'klanten--loop']} role="region" aria-label="Klanten van GTY">
  <ul class="klanten-track" style={beweegt ? `animation-duration:${rij.length * 4}s` : undefined}>
    {kaarten.map((k) => (
      <li class="klanten-card" aria-hidden={k.dubbel ? 'true' : undefined}>
        <img src={bestanden[`/src/assets/klanten/${k.bestand}`].src} alt={k.dubbel ? '' : `Logo ${k.naam}`} loading="lazy" decoding="async" style={`--h:${k.hoogte}px`} />
      </li>
    ))}
  </ul>
</div>

<style>
  .klanten-track { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 24px 0; margin: 0; padding: 0; list-style: none; }
  /* margin in plaats van gap, zodat -50% van de lus precies uitkomt */
  .klanten-card { flex: 0 0 auto; display: flex; align-items: center; height: 96px; margin-inline: 28px; }
  .klanten-card img { width: auto; height: var(--h); max-width: none; filter: grayscale(1) brightness(0.7) contrast(1.2); }
  .klanten--loop { overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .klanten--loop .klanten-track { flex-wrap: nowrap; justify-content: flex-start; width: max-content; animation: klanten-scroll linear infinite; }
  .klanten--loop:hover .klanten-track { animation-play-state: paused; }
  @keyframes klanten-scroll { to { transform: translate3d(-50%, 0, 0); } }
  @media (max-width: 767px) {
    .klanten-card { height: 80px; margin-inline: 18px; }
    .klanten-card img { height: calc(var(--h) * 0.8); }
  }
  @media (prefers-reduced-motion: reduce) {
    .klanten--loop { -webkit-mask-image: none; mask-image: none; }
    .klanten--loop .klanten-track { flex-wrap: wrap; justify-content: center; width: auto; }
    .klanten-card[aria-hidden] { display: none; }
  }
</style>
