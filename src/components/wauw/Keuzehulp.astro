---
// 'Vind je route': paneel in drie stappen (vragen, route, formulier). Opent vanaf elke link naar #vind-je-route.
import Ico from './Ico.astro';
import { url } from '~/data/home';
import { siteData } from '~/data/site-data';
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
---
<dialog class="kd" aria-labelledby="kd-title" data-key={accessKey} data-contact={url.kennismaking}>
  <button type="button" class="kd-achter" data-sluit aria-label="Sluit Vind je route" tabindex="-1"></button>
  <div class="kd-paneel">
    <div class="kd-kop">
      <div data-kop></div>
      <button type="button" class="kd-x" data-sluit aria-label="Sluiten"><Ico naam="kruis" /></button>
    </div>
    <div class="kd-body" data-body></div>
    <div class="kd-voet">Liever direct overleggen? <a href={siteData.contact.phoneHref} class="gty-h-link" style="color:inherit">{siteData.contact.phone}</a></div>
  </div>
</dialog>

<script>
  import { q1, q2, q3, routes, normOpties, onderwerpOpties } from '~/data/keuzehulp';

  // Alle HTML hieronder komt uit eigen constanten; invoer van de bezoeker wordt nooit teruggeschreven.
  const dlg = document.querySelector<HTMLDialogElement>('.kd')!;
  const kop = dlg.querySelector<HTMLElement>('[data-kop]')!;
  const body = dlg.querySelector<HTMLElement>('[data-body]')!;
  let antwoorden: string[] = [];
  let formulier = false;

  const pijl = '<span class="gty-arrow" style="display:inline-flex"><svg width="20" height="15" viewBox="0 0 32 24" fill="none" aria-hidden="true" style="display:block"><path d="M2 12H29M20 3.5L29 12L20 20.5" stroke="currentColor" stroke-width="2.6" stroke-linecap="square"/></svg></span>';
  const chevron = '<svg width="12" height="8" viewBox="0 0 10 6" fill="none" stroke="#0B0B0B" stroke-width="1.6" aria-hidden="true"><path d="M1 1l4 4 4-4"/></svg>';

  const keten = () => {
    const k = [q1];
    if (q2[antwoorden[0]]) k.push(q2[antwoorden[0]]);
    if (q3[antwoorden[1]]) k.push(q3[antwoorden[1]]);
    return k;
  };
  const sleutel = () => {
    const [a, b, c] = antwoorden;
    if (a === 'wn') return 'wn';
    if (b && !q3[b]) return b;
    return c;
  };

  const veld = (label: string, naam: string, type: string, ac: string, verplicht = false) =>
    `<label class="kd-label">${label}<input class="gty-kd-input kd-veld" name="${naam}" type="${type}" autocomplete="${ac}" ${verplicht ? 'required' : ''}></label>`;
  const keuze = (label: string, naam: string, voor: string, basis: string[]) => {
    const opts = basis.includes(voor) || !voor ? basis : [voor, ...basis];
    return `<label class="kd-label">${label}<span style="position:relative;display:block"><select class="gty-kd-input kd-veld kd-select" name="${naam}">${opts.map((o) => `<option${o === voor ? ' selected' : ''}>${o}</option>`).join('')}</select><span class="kd-bron"><span>${voor ? 'uit je route' : ''}</span>${chevron}</span></span></label>`;
  };

  function teken() {
    const k = keten();
    const rk = sleutel();
    const res = rk ? routes[rk] : undefined;
    const gegeven = antwoorden.map((v, i) => ({ q: k[i].title, label: k[i].opts.find((o) => o[0] === v)![1] }));
    const alt = res && res.next.alt !== false
      ? `<a href="${dlg.dataset.contact}" class="gty-h-link kd-klein kd-onder">Liever eerst een gesprek? Plan een kennismaking</a>` : '';
    const stap = formulier ? 3 : res ? 2 : 1;
    const voortgang = `<div style="display:flex;align-items:center;gap:var(--space-16)"><div aria-hidden="true" style="display:flex;gap:4px">${[1, 2, 3].map((n) => `<span style="display:block;width:28px;height:6px;border-radius:3px;background:${n <= stap ? '#4D4D4D' : 'rgba(0,0,0,0.1)'}"></span>`).join('')}</div><span style="font:500 14px/1.2 var(--font-body);color:#4D4D4D">${formulier ? 'Stap 3 van 3 · je gegevens' : res ? 'Stap 2 van 3 · je route' : `Stap 1 van 3 · vraag ${k.length} van max. 3`}</span></div>`;

    kop.innerHTML = formulier
      ? `<button type="button" data-terug class="gty-h-arrow kd-terug"><span style="display:inline-flex;transform:scaleX(-1)">${pijl}</span>Terug naar je route</button><h2 id="kd-title" class="gty-sr">Vind je route naar YES</h2>`
      : '<h2 id="kd-title" class="kd-titel">Vind je route naar YES</h2>';

    let html = voortgang;
    if (formulier && res) {
      const n = res.next;
      html += `<div style="display:flex;flex-direction:column;gap:var(--space-12)"><h2 class="kd-groot">${n.h}</h2><p class="kd-tekst">${n.t}</p><span class="kd-chip">Je route:&nbsp;${res.title}</span></div>
      <form style="display:flex;flex-direction:column;gap:var(--space-16)">
        ${veld('Naam *', 'naam', 'text', 'name', true)}${veld('E-mail *', 'email', 'email', 'email', true)}${veld('Organisatie *', 'organisatie', 'text', 'organization', true)}${veld('Telefoon (optioneel)', 'telefoon', 'tel', 'tel')}
        ${keuze('Onderwerp', 'onderwerp', n.ow, onderwerpOpties)}${n.ow === 'Nulmeting' ? keuze('Welke norm?', 'norm', n.norm ?? '', normOpties) : ''}
        <label class="kd-label">Bericht (optioneel)<textarea class="gty-kd-input kd-veld" name="bericht" rows="3" style="height:auto;padding:12px var(--space-16);line-height:1.5;resize:vertical"></textarea></label>
        <input type="checkbox" name="botcheck" tabindex="-1" aria-hidden="true" hidden>
        <p role="alert" data-fout class="kd-klein" style="color:var(--gty-magenta-700)" hidden>Versturen is niet gelukt. Probeer het opnieuw of mail naar info@gty.nl.</p>
        <button type="submit" class="gty-h-primary zh-kd-verstuur kd-knop">${n.label}</button>
        <span class="kd-klein">${n.meta}</span>${alt}
      </form>`;
    } else {
      if (!res && gegeven.length) {
        html += `<ul aria-label="Je antwoorden" class="kd-lijst">${gegeven.map((a, i) => `<li><span style="display:flex;flex-direction:column;gap:2px"><span class="kd-klein">${a.q}</span><span style="font:var(--type-body-strong);line-height:1.4">${a.label}</span></span><button type="button" data-wijzig="${i}" aria-label="Wijzig antwoord: ${a.label}" class="gty-h-link kd-tekstknop kd-klein">Wijzig</button></li>`).join('')}</ul>`;
      }
      if (!res) {
        const huidig = k[k.length - 1];
        html += `<fieldset style="margin:0;padding:0;border:0;display:flex;flex-direction:column;gap:var(--space-16)"><legend style="padding:0;margin:0 0 var(--space-16);font:600 expanded 20px/1.25 var(--font-display)">${huidig.title}</legend>${huidig.opts.map(([v, label]) => `<button type="button" data-kies="${v}" class="gty-h-option gty-h-arrow kd-optie"><span>${label}</span>${pijl}</button>`).join('')}</fieldset>`;
        if (gegeven.length) html += '<button type="button" data-opnieuw class="kd-opnieuw">Opnieuw beginnen</button>';
      } else {
        html += `<div style="display:flex;flex-direction:column;gap:var(--space-12)"><span style="font:500 14px/1.2 var(--font-body);color:#4D4D4D">Je route</span><p class="kd-groot">${res.title}</p><p class="kd-tekst">${res.text} <a href="${res.href}" class="gty-h-link" style="color:inherit;text-decoration:underline;text-underline-offset:4px;white-space:nowrap">Lees meer</a></p></div>
        <div style="display:flex;flex-direction:column;gap:var(--space-12);padding:var(--space-24);border-radius:16px;background:var(--gradient-brand)"><p style="margin:0;font:600 expanded 18px/1.3 var(--font-display)">${res.next.h}</p><span class="kd-klein" style="color:#4D4D4D">${res.next.meta}</span><button type="button" data-formulier class="gty-h-primary kd-knop">${res.next.label}</button></div>
        ${alt}
        <p class="kd-klein" style="margin:0;padding-top:var(--space-16);border-top:1px solid var(--border-subtle);color:#4D4D4D">Op basis van: ${gegeven.map((a) => a.label).join(' · ')}. <button type="button" data-wijzig="${gegeven.length - 1}" class="gty-h-link kd-tekstknop">Wijzig</button> · <button type="button" data-opnieuw class="gty-h-link kd-tekstknop">Opnieuw beginnen</button></p>`;
      }
    }
    body.innerHTML = html;
    body.scrollTop = 0;
  }

  const open = () => { antwoorden = []; formulier = false; teken(); if (!dlg.open) dlg.showModal(); };
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('a[href$="#vind-je-route"]')) return;
    e.preventDefault();
    open();
  });
  if (location.hash === '#vind-je-route') open();

  dlg.addEventListener('click', (e) => {
    const t = (e.target as Element).closest<HTMLElement>('button');
    if (!t) return;
    const d = t.dataset;
    if ('sluit' in d) return dlg.close();
    if (d.kies) antwoorden.push(d.kies);
    else if (d.wijzig) { antwoorden = antwoorden.slice(0, Number(d.wijzig)); formulier = false; }
    else if ('opnieuw' in d) { antwoorden = []; formulier = false; }
    else if ('formulier' in d) formulier = true;
    else if ('terug' in d) formulier = false;
    else return;
    teken();
  });

  dlg.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const knop = form.querySelector<HTMLButtonElement>('[type=submit]')!;
    const fout = form.querySelector<HTMLElement>('[data-fout]')!;
    const res = routes[sleutel()];
    fout.hidden = true;
    knop.disabled = true;
    try {
      const antwoord = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          ...Object.fromEntries(new FormData(form)),
          access_key: dlg.dataset.key,
          subject: `Vind je route: ${res.next.label} via gty.nl`,
          from_name: 'GTY website',
          route: res.title,
        }),
      });
      const json = await antwoord.json().catch(() => null);
      if (!antwoord.ok || !json?.success) throw new Error('submit failed');
      body.innerHTML = `<div role="status" style="display:flex;flex-direction:column;gap:var(--space-12);padding:var(--space-32);border-radius:16px;background:#F5F5F2;border:1px solid var(--border-subtle)"><p style="margin:0;font:600 expanded 20px/1.25 var(--font-display)">Bedankt. Op naar YES.</p><p class="kd-tekst">We nemen binnen één werkdag contact op om ${res.next.conf} te plannen. Je antwoorden en je route zitten bij je aanvraag.</p></div><button type="button" data-sluit class="kd-sluitknop">Sluiten</button>`;
    } catch {
      fout.hidden = false;
      knop.disabled = false;
    }
  });
</script>

<style is:global>
  .kd { position: fixed; inset: 0; width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: transparent; font-family: var(--font-body); color: var(--text-primary); }
  .kd::backdrop { background: transparent; }
  .kd-achter { position: absolute; inset: 0; width: 100%; border: 0; background: rgba(0,0,0,0.45); cursor: pointer; }
  .kd-paneel { position: absolute; top: 0; right: 0; bottom: 0; width: min(520px, 100%); background: var(--surface-page); border-radius: 16px 0 0 var(--radius-card); display: flex; flex-direction: column; box-shadow: -24px 0 48px rgba(0,0,0,0.18); }
  .kd-kop { display: flex; align-items: center; justify-content: space-between; gap: var(--space-16); padding: var(--space-24) var(--space-32); border-bottom: 1px solid var(--border-subtle); }
  .kd-titel { margin: 0; font: 600 expanded 20px/1.25 var(--font-display); }
  .kd-x { flex: 0 0 44px; width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--border-tag); background: var(--surface-card); display: inline-flex; align-items: center; justify-content: center; color: var(--zh-ink); }
  .kd-body { flex: 1; overflow-y: auto; padding: var(--space-32); display: flex; flex-direction: column; gap: var(--space-32); }
  .kd-voet { padding: var(--space-24) var(--space-32); background: #0B0B0B; color: #fff; border-radius: 0 0 0 var(--radius-card); font: var(--type-small); }
  .kd-terug { display: inline-flex; align-items: center; gap: var(--space-8); border: 0; background: none; padding: 0; font: 600 16px/1 var(--font-body); }
  .kd-klein { font: var(--type-small); }
  .kd-tekst { margin: 0; font: 400 16px/1.6 var(--font-body); }
  .kd-groot { margin: 0; font: 600 expanded 26px/1.15 var(--font-display); letter-spacing: -0.01em; }
  .kd-lijst { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border-subtle); }
  .kd-lijst li { display: flex; align-items: center; justify-content: space-between; gap: var(--space-16); padding: var(--space-12) 0; border-bottom: 1px solid var(--border-subtle); }
  .kd-tekstknop { border: 0; background: none; padding: 0; text-decoration: underline; text-underline-offset: 4px; color: var(--text-primary); }
  .kd-optie { display: flex; align-items: center; justify-content: space-between; gap: var(--space-16); min-height: 64px; padding: var(--space-16) var(--space-24); border-radius: 16px; border: 1px solid var(--border-subtle); background: var(--surface-card); text-align: left; font: 600 16px/1.4 var(--font-body); }
  .kd-knop { align-self: flex-start; display: inline-flex; align-items: center; justify-content: center; height: var(--size-button-h); margin-top: var(--space-8); padding: 0 var(--space-24); border: 0; border-radius: var(--radius-pill); background: var(--action-primary); color: var(--text-inverse); font: 600 16px/1 var(--font-body); }
  .kd-opnieuw { align-self: flex-start; height: 36px; padding: 0 var(--space-16); border-radius: var(--radius-pill); border: 2px solid var(--border-ghost-dark); background: transparent; font: 600 13px/1 var(--font-body); }
  .kd-sluitknop { align-self: flex-start; height: var(--size-button-h); padding: 0 var(--space-24); border-radius: var(--radius-pill); border: 1px solid var(--border-ghost-dark); background: transparent; font: 600 16px/1 var(--font-body); }
  .kd-chip { align-self: flex-start; display: inline-flex; align-items: center; height: 32px; padding: 0 12px; border-radius: var(--radius-pill); background: #F5F5F2; color: #4D4D4D; font: 500 14px/1 var(--font-body); }
  .kd-onder { color: inherit; text-decoration: underline; text-underline-offset: 4px; }
  .kd-label { display: flex; flex-direction: column; gap: 6px; font: var(--type-body-strong); }
  .kd-veld { width: 100%; height: 48px; padding: 0 var(--space-16); border-radius: 8px; border: 1px solid var(--border-tag); background: var(--surface-card); font: 400 16px/1 var(--font-body); }
  .kd-select { padding-right: 132px; font-weight: 500; appearance: none; cursor: pointer; text-overflow: ellipsis; }
  .kd-bron { position: absolute; right: var(--space-16); top: 50%; transform: translateY(-50%); display: flex; align-items: center; gap: 12px; pointer-events: none; font: var(--type-small); color: #4D4D4D; }
</style>
