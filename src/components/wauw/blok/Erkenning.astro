---
import { Image } from 'astro:assets';
import Sectie from './Sectie.astro';
import Vink from './Vink.astro';
import cibot from '~/assets/cibot.png';
const { opmaak } = Astro.props;
---
<Sectie opmaak={opmaak}>
  <div class="gty-container">
    <div class="erk">
      <div class="erk-tekst">
        <h2 id={opmaak.kopid || undefined} class="zh-h2">CIBOT-gecertificeerd opleidingsinstituut</h2>
        <p>CIBOT is het Certificeringsinstituut voor Beroepsopleiding &amp; Training. GTY en onze BHV-instructeurs zijn daar gecertificeerd.</p>
        <ul>
          {['GTY als opleidingsinstituut', 'Onze BHV-instructeurs'].map((t) => <li><Vink maat="28px" />{t}</li>)}
        </ul>
        <a href="/contact/?onderwerp=bhv" class="zh-btn zh-btn--lime">Vraag een BHV-training aan</a>
      </div>
      <div class="erk-logo">
        <Image src={cibot} width={640} alt="Logo van CIBOT, Certificeringsinstituut voor Beroepsopleiding & Training" />
      </div>
    </div>
  </div>
</Sectie>

<style>
  .erk { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); overflow: hidden; border-radius: var(--zh-r-sec); background: var(--zh-ink); color: #fff; }
  .erk-tekst { display: flex; flex-direction: column; align-items: flex-start; gap: 24px; padding: clamp(28px, 5vw, 72px); }
  .erk-tekst h2 { max-width: 18ch; hyphens: manual; }
  .erk-tekst p { margin: 0; max-width: 48ch; color: rgba(255, 255, 255, 0.72); font: var(--type-lead); }
  .erk-tekst ul { list-style: none; margin: 0; padding: 0; align-self: stretch; }
  .erk-tekst li { display: flex; align-items: center; gap: 14px; padding: 14px 0; border-top: 1px solid rgba(255, 255, 255, 0.16); font-weight: 600; }
  .erk-tekst li :global(.zh-check) { flex: 0 0 auto; background: var(--gty-lime); }
  .erk-logo { display: flex; align-items: center; justify-content: center; padding: clamp(32px, 5vw, 72px); background: var(--gradient-brand); }
  .erk-logo img { width: min(320px, 100%); height: auto; }
  @media (max-width: 899px) {
    .erk { grid-template-columns: minmax(0, 1fr); }
    .erk-logo { order: -1; padding: 36px 32px; }
    .erk-logo img { width: min(230px, 100%); }
    .erk-tekst .zh-btn { align-self: stretch; }
  }
</style>
