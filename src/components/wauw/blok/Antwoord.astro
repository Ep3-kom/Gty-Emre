---
import Sectie from './Sectie.astro';
const { opmaak, inhoud: d } = Astro.props;
---
<Sectie opmaak={opmaak}>
  <div class="gty-container"><div class="zh-g-split" style="padding:48px;border-radius:var(--zh-r-card);background:var(--zh-ink);color:#fff;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2fr);gap:24px var(--sec-gap);align-items:start">
    <h2 id={opmaak.kopid || undefined} class="zh-label" style="margin:0;color:var(--gty-lime);padding-top:6px">{d.k}</h2>
    <p style="margin:0;font:400 22px/1.55 var(--font-body);max-width:820px">{d.text}</p>
  </div></div>
</Sectie>
