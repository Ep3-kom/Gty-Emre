---
// Alleen op de pagina Partnerprogramma: bezoeker stelt een programma samen.
import Vink from './Vink.astro';
const stenen: [string, string, boolean][] = [
  ['Periodieke audits', 'Doorgaans vier per jaar, steeds op een ander onderdeel.', true],
  ['Norm- en regelmonitoring', 'Wijzigingen in norm, wet en klanteisen, gefilterd en verwerkt.', false],
  ['Trainingen die meebewegen', 'Inwerken, opfrissen of gericht trainen, op locatie.', false],
  ['Vaste contactpersoon', 'Dezelfde partner, jaar in jaar uit.', true],
  ['Audit-voorbereiding', 'Vóór elke surveillance- of hercertificeringsaudit samen het systeem door.', true],
];
const { opmaak: p = {} } = Astro.props;
const ov = p.overlap === 'ja';
const aantal = stenen.filter((s) => s[2]).length;
---
<section aria-labelledby="h-bouw" data-bouwstenen style={`position:relative;z-index:1;margin-top:${ov ? 'calc(-1 * var(--zh-r-sec))' : '0'};background:var(--zh-page);padding:${ov ? 'calc(var(--sec-y-s) + var(--zh-r-sec)) 0' : 'var(--sec-y-s) 0'}`}>
  <div class="gty-container zh-g-split" style="display:grid;grid-template-columns:minmax(0,1.55fr) minmax(0,1fr);gap:48px;align-items:start">
    <div style="display:flex;flex-direction:column;gap:48px">
      <div style="display:flex;flex-direction:column;gap:24px">
        <span class="zh-eyebrow">Bouwstenen</span>
        <h2 id="h-bouw" class="zh-h2" style="max-width:18ch">Geen vaste pakketten. Een programma op maat.</h2>
        <p style="margin:0;color:var(--zh-soft);font:var(--type-lead);max-width:560px">We stellen het programma samen uit deze bouwstenen, afgestemd op je norm en situatie. Kies wat je nodig hebt.</p>
      </div>
      <ul class="zh-g-2 zh-drop-in" style="list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px">
        {stenen.map(([titel, tekst, aan]) => (
          <li style="display:flex">
            <button type="button" class="zh-pick" aria-pressed={String(aan)} data-titel={titel}>
              <span style="display:flex;justify-content:space-between;align-items:flex-start;gap:16px;width:100%"><span class="zh-h3" style="font-size:20px">{titel}</span><span class="zh-pick-box" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#0B0B0B" stroke-width="2.2"><path d="M3 8.5l3.2 3.2L13 5"/></svg></span></span>
              <span style="font:var(--type-body-s);color:var(--zh-soft);text-align:left">{tekst}</span>
            </button>
          </li>
        ))}
      </ul>
    </div>
    <aside aria-labelledby="h-jouw" aria-live="polite" style="position:sticky;top:112px;padding:40px;border-radius:var(--zh-r-card);background:var(--zh-ink);color:#fff;display:flex;flex-direction:column;gap:32px">
      <div style="display:flex;flex-direction:column;gap:12px">
        <span class="zh-label" style="color:rgba(255,255,255,0.6)">Jouw programma</span>
        <h3 id="h-jouw" class="zh-h3" style="font-size:28px">{aantal} bouwstenen</h3>
      </div>
      <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column">
        {stenen.map(([titel, , aan]) => (<li data-gekozen={titel} hidden={!aan} class="zh-usp" style="font-size:16px;padding:14px 0;border-top:1px dashed rgba(255,255,255,0.25)"><Vink maat="32px" vink="16" dikte="2.2" /><span>{titel}</span></li>))}
      </ul>
      <p data-leeg hidden style="margin:0;font:var(--type-body-s);color:rgba(255,255,255,0.7)">Nog niets gekozen. Twijfel je? Dan bepalen we het samen in de verkenning.</p>
      <div style="display:flex;flex-direction:column;gap:12px">
        <a href="/contact/?onderwerp=partner" class="zh-btn zh-btn--primary" style="width:100%">Bespreek het Partnerprogramma</a>
        <span style="font:400 14px/1.5 var(--font-body);color:rgba(255,255,255,0.6)">Je keuze gaat mee naar het gesprek. Niet meer dan zinvol, niet minder dan de norm vraagt.</span>
      </div>
    </aside>
  </div>
</section>

<script>
  const blok = document.querySelector<HTMLElement>('[data-bouwstenen]')!;
  blok.addEventListener('click', (e) => {
    const knop = (e.target as Element).closest<HTMLElement>('.zh-pick');
    if (!knop) return;
    knop.setAttribute('aria-pressed', String(knop.getAttribute('aria-pressed') !== 'true'));
    const gekozen = [...blok.querySelectorAll<HTMLElement>('.zh-pick[aria-pressed="true"]')].map((k) => k.dataset.titel);
    blok.querySelectorAll<HTMLElement>('[data-gekozen]').forEach((li) => (li.hidden = !gekozen.includes(li.dataset.gekozen)));
    blok.querySelector<HTMLElement>('[data-leeg]')!.hidden = gekozen.length > 0;
    blok.querySelector('#h-jouw')!.textContent = gekozen.length === 0 ? 'Begin met een verkenning' : gekozen.length === 1 ? '1 bouwsteen' : `${gekozen.length} bouwstenen`;
  });
</script>
