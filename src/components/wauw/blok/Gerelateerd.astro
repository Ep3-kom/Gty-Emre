---
import Sectie from './Sectie.astro';
import Kaart from './Kaart.astro';
const { opmaak, inhoud: d } = Astro.props;
const vlak = (opmaak.bg || 'wit') === 'wit' ? 'var(--zh-page)' : '#fff';
---
<Sectie opmaak={opmaak}>
  <div class="gty-container" style="display:flex;flex-direction:column;gap:32px">
    <h2 id={opmaak.kopid || undefined} class="zh-h3" style="font-size:28px">{d.h2}</h2>
    <ul class={`zh-g-${d.cols} zh-drop-in`} style={`list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(${d.cols},minmax(0,1fr));gap:16px`}>
      {d.items.map((l: any) => <Kaart variant="lees" tag={l.rel} title={l.label} text={l.text} href={l.href} vlak={vlak} />)}
    </ul>
  </div>
</Sectie>
