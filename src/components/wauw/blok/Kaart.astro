---
import Pijl from './Pijl.astro';
const { variant = 'tegel', tag, title, text, href, linklabel, genummerd = false, vlak = '#fff', knopvlak = 'var(--zh-page)', minh = '260px', onderwerp, n, laatste = false, limoen = false, who, pad = '32px' } = Astro.props;
const rond = 'width:48px;height:48px;background:var(--gty-lime)';
const titelst = 'font-size:clamp(20px,1.5vw,24px);hyphens:auto;overflow-wrap:break-word';
const Tegel = href ? 'a' : 'div';
const numst = laatste ? 'background:var(--zh-ink);color:#fff;border-color:var(--zh-ink)' : limoen ? 'background:var(--gty-lime);color:var(--zh-ink);border-color:var(--gty-lime)' : 'background:#fff';
---
{variant === 'tegel' && (
  <Tegel href={href || undefined} class:list={[href && 'zh-norm', 'zh-tegel']} style={`display:flex;flex-direction:column;justify-content:space-between;gap:40px;min-height:${minh};height:100%;padding:32px;border-radius:var(--zh-r-card);background:${vlak};text-decoration:none;color:var(--zh-ink)`}>
    <div style="display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:48px">
      {!tag ? <span></span> : genummerd ? <span class="zh-num" style="background:#fff;border-color:var(--zh-line)">{tag}</span> : <span class="zh-label" style="color:var(--zh-soft)">{tag}</span>}
      {href && <span class="zh-round" aria-hidden="true" style={rond}><Pijl /></span>}
    </div>
    <div style="display:flex;flex-direction:column;gap:12px">
      <h3 class="zh-h3" style={titelst}>{title}</h3>
      {text && <p style="margin:0;font:var(--type-body-s);color:var(--zh-soft)">{text}</p>}
      {href && <span style="margin-top:8px;font:600 15px/1.3 var(--font-body)">{linklabel}</span>}
    </div>
  </Tegel>
)}
{variant === 'citaat' && (
  <figure style={`margin:0;display:flex;flex-direction:column;justify-content:space-between;gap:32px;min-height:200px;height:100%;padding:32px;border-radius:var(--zh-r-card);background:${vlak}`}>
    <blockquote style="margin:0;font:600 expanded 22px/1.3 var(--font-display);letter-spacing:-0.01em">{title}</blockquote>
    {tag && <figcaption class="zh-label" style="color:var(--zh-soft)">{tag}</figcaption>}
  </figure>
)}
{variant === 'artikel' && (
  <a href={href} class="zh-norm" aria-label={title} data-onderwerp={onderwerp} style={`display:flex;flex-direction:column;justify-content:space-between;gap:40px;height:100%;min-height:240px;padding:24px;border-radius:var(--zh-r-card);background:${vlak};text-decoration:none;color:var(--zh-ink)`}>
    <div style="display:flex;justify-content:space-between;align-items:center;gap:16px">{onderwerp && <span class="zh-chip" style={`background:${knopvlak};color:var(--zh-ink)`}>{onderwerp}</span>}<span class="zh-round" aria-hidden="true" style={`${rond};margin-left:auto`}><Pijl /></span></div>
    <span style="display:flex;flex-direction:column;gap:10px"><span class="zh-label" style="color:var(--zh-soft)">{tag}</span><span class="zh-h3" style="font-size:22px;hyphens:auto;overflow-wrap:break-word">{title}</span></span>
  </a>
)}
{variant === 'stap' && (
  <li style={`display:flex;flex-direction:column;justify-content:space-between;gap:48px;min-height:${minh};height:100%;padding:${pad};border-radius:var(--zh-r-card);background:${vlak}`}>
    <div style="display:flex;justify-content:space-between;align-items:center;gap:16px">
      <span class="zh-num" style={numst}>{n}</span>
      {tag && <span class="zh-chip" style={laatste ? 'background:var(--gty-lime);color:var(--zh-ink)' : undefined}>{tag}</span>}
    </div>
    <div style="display:flex;flex-direction:column;gap:12px">
      <h3 class="zh-h3" style={titelst}>{title}</h3>
      {text && <p style="margin:0;font:var(--type-body-s);color:var(--zh-soft)">{text}</p>}
      {href && <a href={href} class="zh-link" style="margin-top:8px;width:max-content;color:var(--zh-ink)">{linklabel}</a>}
      {who && <div style="display:flex;flex-direction:column;gap:4px;margin-top:12px;padding-top:16px;border-top:var(--zh-dash)"><span style="font:400 14px/1.4 var(--font-body);color:var(--zh-soft)">Wie</span><span style="font:600 16px/1.4 var(--font-body)">{who}</span></div>}
    </div>
  </li>
)}
{variant === 'lees' && (
  <li style="display:flex;height:100%"><a href={href} class="zh-norm zh-norm--sm zh-read" style={`text-decoration:none;color:var(--zh-ink);${vlak !== '#fff' ? `background:${vlak}` : ''}`}>
    <span style="display:flex;flex-direction:column;gap:8px"><span class="zh-label" style="color:var(--zh-soft)">{tag}</span><span class="zh-h3" style="font-size:22px">{title}</span>{text && <span style="font:var(--type-body-s);color:var(--zh-soft)">{text}</span>}</span>
    <span class="zh-round" aria-hidden="true" style={rond}><Pijl /></span>
  </a></li>
)}
{variant === 'feit' && (
  <div style="display:flex;flex-direction:column-reverse;justify-content:flex-end;gap:12px;height:100%;padding:32px;border-radius:var(--zh-r-card);background:var(--zh-page);min-height:180px"><dt style="font:400 15px/1.4 var(--font-body);color:var(--zh-soft)">{tag}</dt><dd style={`margin:0;font:600 expanded ${(title || '').length > 12 ? '22px' : '40px'}/1.15 var(--font-display);letter-spacing:-0.02em`}>{title}</dd></div>
)}
