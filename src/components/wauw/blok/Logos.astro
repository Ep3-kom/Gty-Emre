---
import Sectie from './Sectie.astro';
import Klantlogos from '../Klantlogos.astro';
const { opmaak, inhoud: d } = Astro.props;
---
<Sectie opmaak={opmaak}>
  <div style="display:flex;flex-direction:column;gap:32px">
    <div class="gty-container"><h2 id={opmaak.kopid || undefined} class="zh-logos-kop">{d.h}</h2></div>
    <Klantlogos namen={d.namen} />
  </div>
</Sectie>
