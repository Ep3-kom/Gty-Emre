---
import { Image } from 'astro:assets';
import team from '~/assets/wauw/team.jpg';
import emre from '~/assets/wauw/emre-mobiel.jpg';
import Sectie from './Sectie.astro';
import Kop from './Kop.astro';
import Knop from './Knop.astro';
import Ico from '../Ico.astro';
import { siteData } from '~/data/site-data';
const { opmaak, inhoud: d } = Astro.props;
const donker = opmaak.bg === 'inkt';
const c = donker ? '#fff' : 'var(--zh-ink)';
const tc = donker ? 'rgba(255,255,255,0.8)' : 'var(--zh-soft)';
const lijn = donker ? 'rgba(255,255,255,0.25)' : 'rgba(0,0,0,0.2)';
const ico = donker ? 'var(--gty-lime)' : 'var(--zh-ink)';
const ratio = d.ratio || (d.img === 'emre' ? '4/5' : '1/1');
const kolommen = d.flip ? 'minmax(0,1.1fr) minmax(0,0.9fr)' : d.gelijk ? 'minmax(0,1fr) minmax(0,1fr)' : 'minmax(0,0.9fr) minmax(0,1.1fr)';
// Telefoon en e-mail in de opsomming zijn aanklikbaar.
const link = (t: string) => (t === siteData.contact.phone ? siteData.contact.phoneHref : t === siteData.contact.email ? siteData.contact.emailHref : undefined);
---
<Sectie opmaak={opmaak}>
  {!d.img ? (
    <div class="gty-container zh-g-split" style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:var(--sec-gap);align-items:end">
      <Kop kicker={d.kicker} titel={d.h2} donker={donker} maxch="16" id={opmaak.kopid} />
      <div style="display:flex;flex-direction:column;gap:32px">
        {d.text && <p style={`margin:0;font:var(--type-lead);color:${tc}`}>{d.text}</p>}
        <div style="display:flex;flex-wrap:wrap;gap:12px">{d.c1 && <Knop {...d.c1} />}{d.c2 && <Knop {...d.c2} variant={donker ? 'lijn-licht' : 'lijn'} />}</div>
      </div>
    </div>
  ) : (
    <div class="gty-container zh-g-split" style={`display:grid;grid-template-columns:${kolommen};gap:var(--sec-gap);align-items:center;color:${c}`}>
      <div class="zh-photo" style={`aspect-ratio:${ratio};border-radius:var(--zh-r-card);order:${d.flip ? 2 : 0}`}>
        {d.img === 'emre'
          ? <Image src={emre} alt="Emre Ozdemir, oprichter van GTY" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 0" />
          : <Image src={team} widths={[1200, 2400]} sizes="120vw" alt="Twee collega’s bespreken samen de stand van zaken op een tablet" style={`position:absolute;${d.crop || 'top:0;left:-102%;height:175%'};width:auto;max-width:none`} />}
        {d.quote && <figure style="position:absolute;left:24px;right:24px;bottom:24px;margin:0;padding:28px;border-radius:16px;background:rgba(255,255,255,0.72);border:1px solid rgba(255,255,255,0.8);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);color:var(--zh-ink)"><blockquote style="margin:0;font:600 expanded 20px/1.35 var(--font-display)">{d.quote}</blockquote></figure>}
      </div>
      <div style="display:flex;flex-direction:column;gap:32px">
        <Kop kicker={d.kicker} titel={d.h2} intro={d.intro} donker={donker} maxch={d.maxch || '18'} id={opmaak.kopid} />
        {d.text && <p style={`margin:0;font:var(--type-body);color:${tc};max-width:560px`}>{d.text}</p>}
        {d.vinken?.length > 0 && <ul class="zh-rise-in" style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column">{d.vinken.map((v: string) => <li class="zh-usp" style={`font-size:16px;gap:16px;padding:16px 0;border-top:1px dashed ${lijn}`}><span class="zh-check" aria-hidden="true" style="width:56px;height:56px"><svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke={c} stroke-width="2.2"><path d="M3 8.5l3.2 3.2L13 5"/></svg></span><span>{v}</span></li>)}</ul>}
        {d.bullets?.length > 0 && <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column">{d.bullets.map((b: { t: string; ico: 'telefoon' | 'mail' | 'locatie' | 'klok' }) => { const href = link(b.t); const T = href ? 'a' : 'span'; return (<li style={`display:flex;align-items:center;gap:16px;padding:14px 0;border-top:1px dashed ${lijn};font:500 17px/1.4 var(--font-body)`}><span class="zh-foot-ico" aria-hidden="true" style={`color:${ico};border-color:${donker ? 'rgba(255,255,255,0.35)' : 'var(--zh-line)'}`}><Ico naam={b.ico} /></span><T href={href} style="color:inherit;text-decoration:none">{b.t}</T></li>); })}</ul>}
        <div style="display:flex;flex-wrap:wrap;gap:12px">{d.c1 && <Knop {...d.c1} variant={d.c1v || 'primair'} />}{d.c2 && <Knop {...d.c2} variant={donker ? 'lijn-licht' : 'lijn'} />}</div>
      </div>
    </div>
  )}
</Sectie>
