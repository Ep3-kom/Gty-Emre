---
import type { ImageMetadata } from 'astro';
import { normen, overigeNormen, normenCertificering, overigeCertificering, klanten, url } from '~/data/home';

const logos = import.meta.glob<ImageMetadata>('~/assets/wauw/klant-*.png', { eager: true, import: 'default' });
const src = (n: string) => logos[`/src/assets/wauw/klant-${n}.png`].src;
const cert = Astro.props.opmaak?.variant === 'certificering';
const kop = cert
  ? { eyebrow: 'Normen', titel: 'Welke norm past bij je situatie?', intro: 'Kies op situatie, niet op normnaam.' }
  : { eyebrow: 'Certificering', titel: 'Begeleiding bij ISO 27001, NEN 7510 en ISO 9001', intro: 'Weet je welke norm je nodig hebt? Kies hem hier.' };
const code = 'font:600 expanded clamp(64px,6.4vw,104px)/0.9 var(--font-display);letter-spacing:-0.03em';
---
<section id="normen" class="zh-breathe" aria-labelledby="h-normen" style="position:relative;z-index:3;margin-top:calc(-1 * var(--zh-r-sec));border-radius:var(--zh-r-sec);padding:var(--sec-y) 0">
  <div class="gty-container" style="display:flex;flex-direction:column;gap:var(--sec-gap)">
    <div style="display:flex;flex-direction:column;align-items:center;text-align:center;gap:24px">
      <span class="zh-eyebrow">{kop.eyebrow}</span>
      <h2 id="h-normen" class="zh-h2" style="max-width:20ch">{kop.titel}</h2>
      <p style="margin:0;color:var(--zh-soft);font:var(--type-lead)">{kop.intro}</p>
    </div>
    <div class="zh-bento-stack" style="display:flex;flex-direction:column;gap:24px">
      <div class="zh-g-bento zh-drop-in" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px">
        {(cert ? normenCertificering : normen).map((n) => (
          <a href={n.href} class="zh-norm zh-glass" style="display:flex;flex-direction:column;justify-content:space-between;gap:40px;min-height:460px;padding:32px;border-radius:var(--zh-r-card);text-decoration:none;background:#fff;color:var(--zh-ink)">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:16px">
              <span class="zh-label" style="color:var(--zh-soft)">{n.kind}</span>
              <span class="zh-round" aria-hidden="true" style="background:#F5F5F2"><svg width="22" height="22" viewBox="0 0 16 16" fill="none" stroke="#0B0B0B" stroke-width="1.4"><path d="M2 8h12M9 3l5 5-5 5"/></svg></span>
            </div>
            <div class="zh-norm-body" style="display:flex;flex-direction:column;gap:32px">
              <span class="zh-norm-code" style={code}>{n.code}</span>
              <div style="display:flex;flex-direction:column;gap:8px;padding-top:24px;border-top:var(--zh-dash)">
                <span class="zh-h3">{n.title}</span>
                <span style="font:var(--type-body-s);color:var(--zh-soft)">{n.text}</span>
                <span style="font:500 14px/1.4 var(--font-body);color:var(--zh-soft);margin-top:8px">{n.meta}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
      <div class="zh-g-bento zh-drop-in" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px">
        {(cert ? overigeCertificering : overigeNormen).map((t) => (
          <a href={t.href} class="zh-norm zh-norm--sm zh-glass" style="display:flex;align-items:center;justify-content:space-between;gap:24px;padding:24px;border-radius:16px;background:#fff;text-decoration:none;color:var(--zh-ink)">
            <span style="display:flex;flex-direction:column;gap:8px;min-width:0">
              <span class="zh-label" style="color:var(--zh-soft)">{t.kind}</span>
              <span class="zh-norm-code zh-norm-code--sm" style="font:600 expanded 26px/1 var(--font-display);letter-spacing:-0.02em">{t.code}</span>
              <span style="font:400 16px/1.35 var(--font-body);color:var(--zh-soft)">{t.text}</span>
            </span>
            <span class="zh-round" aria-hidden="true" style="width:48px;height:48px;background:#F5F5F2"><svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="#0B0B0B" stroke-width="1.6"><path d="M2 8h12M9 3l5 5-5 5"/></svg></span>
          </a>
        ))}
      </div>
    </div>
    <div style="display:flex;flex-direction:column;align-items:center;gap:24px;text-align:center">
      <p style="margin:0;font:600 expanded 20px/1.25 var(--font-display);letter-spacing:-0.01em">Twijfel je welke norm past?</p>
      <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:24px">
        <a href={url.route} class="zh-btn zh-btn--dark" style="height:48px">Vind je route</a>
        {!cert && <a href={url.certificering} class="zh-link">Alle certificeringen</a>}
      </div>
    </div>
  </div>
  <div style="margin-top:var(--sec-y);display:flex;flex-direction:column;gap:32px">
    <div class="gty-container"><h2 id="h-logos" class="zh-logos-kop">Organisaties die met GTY werken</h2></div>
    <div class="zh-marquee" role="region" aria-label="Klantlogo’s">
      <ul class="zh-marquee-track">
        {[false, true].map((dup) => klanten.map(([bestand, naam, h]) => (
          <li class="zh-logo zh-logo-img" aria-hidden={String(dup)}><img src={src(bestand)} alt={dup ? '' : naam} style={`height:${h}px;width:auto;display:block`} /></li>
        )))}
      </ul>
    </div>
  </div>
</section>
