---
// Woordmerk uit het Wauw-ontwerp.
const { wit = false, breedte = '56px', animatie = false } = Astro.props;
const kleur = wit ? '#FFFFFF' : '#0B0B0B';
const id = `gty-sw-${wit ? 'wit' : 'zwart'}-${breedte}`;
---
