  <span class:list={['zh-logo-nieuw', animatie && 'zh-l2-anim']} style={`width:${breedte}`}>
    <svg class="zh-l2" viewBox="0 0 114 70" width="100%" aria-hidden="true" focusable="false" style="display:block;height:auto;overflow:visible"><defs><linearGradient id={id} gradientUnits="userSpaceOnUse" x1="13" y1="0" x2="37" y2="0"><stop offset="0" stop-color={kleur} stop-opacity="1"></stop><stop offset="0.333" stop-color={kleur} stop-opacity="0.67"></stop><stop offset="0.5" stop-color={kleur} stop-opacity="0.46"></stop><stop offset="0.667" stop-color={kleur} stop-opacity="0.24"></stop><stop offset="0.833" stop-color={kleur} stop-opacity="0.09"></stop><stop offset="1" stop-color={kleur} stop-opacity="0"></stop></linearGradient></defs><path class="zh-l2-g" fill={kleur} d="M 21.464844 42.410156 C 15.230469 42.410156 10.167969 37.339844 10.167969 31.113281 C 10.167969 24.886719 15.238281 19.804688 21.464844 19.804688 C 27.703125 19.804688 32.773438 24.875 32.773438 31.113281 C 32.773438 37.347656 27.703125 42.410156 21.464844 42.410156 M 44.484375 9.925781 L 21.941406 9.925781 C 10.675781 9.925781 1.164062 18.46875 0.300781 29.390625 C -0.1875 35.546875 2.011719 41.605469 6.347656 45.992188 C 10.355469 50.039062 15.785156 52.296875 21.4375 52.296875 C 21.914062 52.296875 22.394531 52.28125 22.878906 52.25 C 32.882812 51.570312 41.296875 43.574219 42.453125 33.648438 C 43.019531 28.714844 41.929688 23.914062 39.363281 19.851562 L 42.734375 19.851562 Z M 44.484375 9.925781 "></path><path class="zh-l2-t" fill={kleur} d="M 54.042969 0 L 52.296875 9.90625 L 50.546875 19.832031 L 44.824219 52.296875 L 67.472656 52.296875 L 69.230469 42.320312 L 56.507812 42.320312 L 60.476562 19.832031 L 67.269531 19.832031 L 69.019531 9.90625 L 62.226562 9.90625 L 63.972656 0 Z M 54.042969 0 "></path><path class="zh-l2-y" fill={kleur} d="M 103.035156 9.898438 L 93.804688 41.804688 L 84.503906 9.898438 L 74.050781 9.898438 L 87.25 52.296875 L 90.640625 52.296875 L 87.546875 61.527344 L 97.335938 61.527344 L 113.476562 9.898438 Z M 103.035156 9.898438 "></path><path class="zh-l2-s" fill={`url(#${id})`} d="M2.077 64.028A38.2 38.2 0 0 0 50.728 55.668L44.140 50.140A29.6 29.6 0 0 1 6.442 56.618Z"></path></svg>
    <span class="gty-sr">GTY</span>
  </span>
</a>
