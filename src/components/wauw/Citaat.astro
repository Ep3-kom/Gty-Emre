---
import { Image } from 'astro:assets';
import foto from '~/assets/wauw/sanne.jpg';
import { citaat } from '~/data/home';
---
<section aria-labelledby="h-citaat" style="position:relative;z-index:2;margin-top:calc(-1 * var(--zh-r-sec));background:var(--zh-ink);color:#fff;border-radius:var(--zh-r-sec);padding:var(--sec-y-s) 0">
  <div class="gty-container" style="display:flex;flex-direction:column;align-items:center;text-align:center;gap:48px">
    <h2 id="h-citaat" class="zh-eyebrow" style="margin:0">Klanten aan het woord</h2>
    <blockquote class="zh-reveal" style="margin:0;color:var(--gty-mint);max-width:24ch;font:600 expanded clamp(26px,2.7vw,40px)/1.25 var(--font-display);letter-spacing:-0.01em;text-wrap:balance">
      {citaat.tekst.split(' ').map((w) => (<span class="zh-reveal-w">{w} </span>))}
    </blockquote>
    <div class="zh-citaat-persoon" style="display:flex;align-items:center;gap:16px;text-align:left">
      <Image src={foto} alt={citaat.naam} width={112} height={112} style="width:56px;height:56px;border-radius:50%;object-fit:cover;display:block;border:1px solid rgba(255,255,255,0.3);flex:0 0 auto" />
      <span style="display:flex;flex-direction:column;gap:4px"><span style="font:600 16px/1.2 var(--font-body)">{citaat.naam}</span><span style="font:400 14px/1.3 var(--font-body);color:rgba(255,255,255,0.65)">{citaat.functie}</span></span>
    </div>
    <dl class="zh-g-facts zh-hide-m" style="margin:0;width:100%;max-width:900px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px dashed rgba(255,255,255,0.25);border-bottom:1px dashed rgba(255,255,255,0.25)">
      {citaat.feiten.map(([k, v], i) => (
        <div style={`padding:24px;display:flex;flex-direction:column;gap:8px;border-left:${i ? '1px dashed rgba(255,255,255,0.25)' : '0'}`}><dt class="zh-label" style="color:rgba(255,255,255,0.6)">{k}</dt><dd style="margin:0;font:600 16px/1.4 var(--font-body)">{v}</dd></div>
      ))}
    </dl>
    <!-- Slider werkt zodra er een tweede citaat is; het ontwerp toont alleen de knoppen. -->
    <div style="display:flex;align-items:center;gap:12px">
      <button type="button" aria-label="Vorige klant" class="zh-round" style="border:1px solid rgba(255,255,255,0.3);background:transparent;cursor:pointer"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#fff" stroke-width="1.6"><path d="M14 8H2M7 3L2 8l5 5"/></svg></button>
      <span style="font:500 14px/1 var(--font-body);color:rgba(255,255,255,0.65);min-width:48px">1 / 2</span>
      <button type="button" aria-label="Volgende klant" class="zh-round" style="border:0;background:#fff;cursor:pointer"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#0B0B0B" stroke-width="1.6"><path d="M2 8h12M9 3l5 5-5 5"/></svg></button>
    </div>
  </div>
</section>

<style is:global>
  .zh-reveal-w { background-image: var(--gradient-brand); background-repeat: no-repeat; -webkit-background-clip: text; background-clip: text; color: transparent; -webkit-text-fill-color: transparent; }
</style>

<script>
  // Woorden lichten op tijdens het scrollen; het verloop loopt door over het hele citaat.
  const blok = document.querySelector<HTMLElement>('.zh-reveal')!;
  const woorden = [...blok.querySelectorAll<HTMLElement>('.zh-reveal-w')];
  const rustig = matchMedia('(prefers-reduced-motion: reduce)');
  const kleur = () => {
    const b = blok.getBoundingClientRect();
    woorden.forEach((w) => {
      w.style.backgroundSize = `${b.width}px 100%`;
      w.style.backgroundPosition = `${b.left - w.getBoundingClientRect().left}px 0`;
    });
  };
  const scroll = () => {
    const r = blok.getBoundingClientRect();
    const p = rustig.matches ? 1 : Math.max(0, Math.min(1, (innerHeight * 0.85 - r.top) / (r.height + innerHeight * 0.35)));
    woorden.forEach((w, i) => (w.style.opacity = String(Math.max(0.18, Math.min(1, (p * (woorden.length + 3) - i) / 3)))));
  };
  addEventListener('scroll', scroll, { passive: true });
  new ResizeObserver(() => { kleur(); scroll(); }).observe(blok);
  document.fonts.ready.then(kleur);
</script>
